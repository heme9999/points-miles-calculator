<!DOCTYPE html>
<html lang="{{ lang | default(site.lang) }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set currentLang = lang | default(site.lang) %}
{% set isEnglish = currentLang == 'en' %}
{% set siteName = 'Points & Miles Calculator' if isEnglish else site.name %}
{% set homeNav = 'Home' if isEnglish else '首页' %}
{% set homeUrl = '/en/' if isEnglish else '/' %}
{% set zhUrl = site.url ~ (page.url | replace('/en/', '/')) %}
{% set enUrl = site.url ~ ('/en' ~ page.url if not isEnglish else page.url) %}

<title>{{ title }} | {{ siteName }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="google-site-verification" content="wMz2VDeMwD8R6yiCgJIqFD_wM2wSzrSEauzvCtzKHyw" />

{% if noindex %}
<meta name="robots" content="noindex">
{% endif %}
<link rel="canonical" href="{{ site.url }}{{ canonical | default(page.url) }}">
<link rel="alternate" hreflang="zh-CN" href="{{ zhUrl }}">
<link rel="alternate" hreflang="en" href="{{ enUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ enUrl }}">
<meta property="og:title" content="{{ title }} | {{ siteName }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">

{% if schemaType %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "Points & Miles Calculator",
      "alternateName": "里程账",
      "publisher": {
        "@id": "{{ site.url }}/#organization"
      }
    },
    {
      "@type": "Organization",
      "@id": "{{ site.url }}/#organization",
      "url": "{{ site.url }}/",
      "name": "Points & Miles Calculator",
      "alternateName": "里程账"
    },
    {
      "@type": "{{ schemaType }}",
      "@id": "{{ site.url }}{{ page.url }}#{{ schemaType | lower }}",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "inLanguage": "{{ currentLang }}",
      "name": "{{ title | safe }}",
      "headline": "{{ title | safe }}",
      "url": "{{ site.url }}{{ page.url }}",
      "description": "{{ description or site.description }}"
      {% if schemaType == 'Article' %}
      ,"author": {
        "@id": "{{ site.url }}/#organization"
      },
      "publisher": {
        "@id": "{{ site.url }}/#organization"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}"
      },
      {% if datePublished %}
      "datePublished": "{{ datePublished }}",
      {% endif %}
      "dateModified": "{{ dateModified | default(page.date.toISOString()) }}"
      {% endif %}
    }
  ]
}
</script>
{% endif %}
{% if breadcrumbs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "{{ homeNav | safe }}",
      "item": "{{ site.url }}{{ homeUrl }}"
    }
    {% for crumb in breadcrumbs %}
    ,{
      "@type": "ListItem",
      "position": {{ loop.index + 1 }},
      "name": "{{ crumb.name | safe }}",
      "item": "{{ site.url }}{{ crumb.url | default(page.url) }}"
    }
    {% endfor %}
  ]
}
</script>
{% endif %}
{% if faqItems %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqItems %}
    {
      "@type": "Question",
      "name": "{{ faq.question | safe }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ faq.answer | safe }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
</head>
<body>
<div class="wrap{% if wrapClass %} {{ wrapClass }}{% endif %}">
  <header class="site-nav">
    <a href="{{ homeUrl }}" class="brand">{{ siteName }}</a>
    <nav>
      {% if isEnglish %}
      <a href="/en/calculators/">Calculators</a>
      <a href="/en/values/">Valuations</a>
      <a href="/en/methodology/">Methodology</a>
      {% else %}
      <a href="/calculators/">计算器</a>
      <a href="/values/">积分估值</a>
      <a href="/methodology/">方法论</a>
      {% endif %}
    </nav>
    <div class="lang-switcher">
      {% if isEnglish %}
      <a href="{{ zhUrl }}" hreflang="zh-CN" lang="zh-CN" class="lang-link">中文</a>
      <a href="{{ enUrl }}" hreflang="en" lang="en" aria-current="page" class="lang-link">English</a>
      {% else %}
      <a href="{{ zhUrl }}" hreflang="zh-CN" lang="zh-CN" aria-current="page" class="lang-link">中文</a>
      <a href="{{ enUrl }}" hreflang="en" lang="en" class="lang-link">English</a>
      {% endif %}
    </div>
  </header>

  {% if breadcrumbs %}
  <nav class="breadcrumb">
    <a href="{{ homeUrl }}">{{ homeNav }}</a>
    {% for crumb in breadcrumbs %}
      <span class="sep">/</span>
      {% if loop.last %}
        <span aria-current="page">{{ crumb.name }}</span>
      {% else %}
        <a href="{{ crumb.url }}">{{ crumb.name }}</a>
      {% endif %}
    {% endfor %}
  </nav>
  {% endif %}

  {% if eyebrow %}
  <div class="eyebrow">{{ eyebrow }}</div>
  {% endif %}
  
  {{ content | safe }}

  <footer class="site-footer" style="margin-top: 80px; padding-top: 40px; border-top: 1px solid #e2e8f0; font-size: 14px; color: #64748b;">
    <div style="display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <strong style="display:block; margin-bottom: 12px; color: #0f172a;">{% if isEnglish %}Tools & Resources{% else %}工具与资源{% endif %}</strong>
        <a href="{{ '/en/calculators/' if isEnglish else '/calculators/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}All Calculators{% else %}全部计算器{% endif %}</a>
        <a href="{{ '/en/values/' if isEnglish else '/values/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}Points Valuations{% else %}积分估值目录{% endif %}</a>
        <a href="{{ '/en/guides/how-to-calculate-point-value/' if isEnglish else '/guides/how-to-calculate-point-value/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}How to Calculate CPP{% else %}如何计算积分价值 (CPP){% endif %}</a>
      </div>
      <div>
        <strong style="display:block; margin-bottom: 12px; color: #0f172a;">{% if isEnglish %}About Us{% else %}关于本站{% endif %}</strong>
        <a href="{{ '/en/about/' if isEnglish else '/about/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}About{% else %}关于我们{% endif %}</a>
        <a href="{{ '/en/methodology/' if isEnglish else '/methodology/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}Methodology{% else %}估值方法论{% endif %}</a>
        <a href="{{ '/en/contact/' if isEnglish else '/contact/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}Contact Us{% else %}联系我们{% endif %}</a>
      </div>
      <div>
        <strong style="display:block; margin-bottom: 12px; color: #0f172a;">{% if isEnglish %}Legal & Policy{% else %}法律与政策{% endif %}</strong>
        <a href="{{ '/en/privacy/' if isEnglish else '/privacy/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}Privacy Policy{% else %}隐私政策{% endif %}</a>
        <a href="{{ '/en/terms/' if isEnglish else '/terms/' }}" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">{% if isEnglish %}Terms & Disclaimer{% else %}免责声明与条款{% endif %}</a>
      </div>
    </div>
    <div style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 24px;">
      &copy; 2026 Points & Miles Calculator. {% if isEnglish %}Not affiliated with any airlines or financial institutions. Results are for reference only and do not constitute financial advice.{% else %}不受任何航空公司或金融机构背书。计算结果仅供参考，不构成财务建议。{% endif %}
    </div>
  </footer>
</div>
</body>
</html>
