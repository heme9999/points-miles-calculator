<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | {{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="google-site-verification" content="wMz2VDeMwD8R6yiCgJIqFD_wM2wSzrSEauzvCtzKHyw" />
{% if canonical %}
<link rel="canonical" href="{{ site.url }}{{ canonical }}">
{% else %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% endif %}
<meta property="og:title" content="{{ title }} | {{ site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">

{% if schemaType %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ schemaType }}",
  "name": "{{ title }}",
  "url": "{{ site.url }}{{ page.url }}",
  "description": "{{ description or site.description }}"
}
</script>
{% endif %}
{% if breadcrumbs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": "{{ site.url }}/"
    }
    {% for crumb in breadcrumbs %}
    ,{
      "@type": "ListItem",
      "position": {{ loop.index + 1 }},
      "name": "{{ crumb.name }}",
      "item": "{{ site.url }}{{ crumb.url | default(page.url) }}"
    }
    {% endfor %}
  ]
}
</script>
{% endif %}
</head>
<body>
<div class="wrap">
  <header class="site-nav">
    <a href="/" class="brand">{{ site.name }}</a>
    <nav>
      <a href="/calculators/">计算器</a>
      <a href="/values/">积分估值</a>
      <a href="/methodology/">方法论</a>
    </nav>
  </header>

  {% if breadcrumbs %}
  <nav class="breadcrumb">
    <a href="/">首页</a>
    {% for crumb in breadcrumbs %}
      <span class="sep">/</span>
      {% if loop.last %}
        <span aria-current="page">{{ crumb.name }}</span>
      {% else %}
        <a href="{{ crumb.url }}">{{ crumb.name }}</a>
      {% endif %}
    {% endfor %}
  </nav>
  {% endif %}

  {% if eyebrow %}
  <div class="eyebrow">{{ eyebrow }}</div>
  {% endif %}
  
  {{ content | safe }}

  <footer class="site-footer" style="margin-top: 80px; padding-top: 40px; border-top: 1px solid #e2e8f0; font-size: 14px; color: #64748b;">
    <div style="display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; margin-bottom: 24px;">
      <div>
        <strong style="display:block; margin-bottom: 12px; color: #0f172a;">工具与资源</strong>
        <a href="/calculators/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">全部计算器</a>
        <a href="/values/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">积分估值目录</a>
        <a href="/guides/how-to-calculate-point-value/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">如何计算积分价值 (CPP)</a>
      </div>
      <div>
        <strong style="display:block; margin-bottom: 12px; color: #0f172a;">关于本站</strong>
        <a href="/about/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">关于我们</a>
        <a href="/methodology/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">估值方法论</a>
        <a href="/contact/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">联系我们</a>
      </div>
      <div>
        <strong style="display:block; margin-bottom: 12px; color: #0f172a;">法律与政策</strong>
        <a href="/privacy/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">隐私政策</a>
        <a href="/terms/" style="display:block; margin-bottom: 8px; color: inherit; text-decoration: none;">免责声明与条款</a>
      </div>
    </div>
    <div style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 24px;">
      &copy; 2026 Points & Miles Calculator. 不受任何航空公司或金融机构背书。计算结果仅供参考，不构成财务建议。
    </div>
  </footer>
</div>
</body>
</html>
