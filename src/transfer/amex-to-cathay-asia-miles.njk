</div>

<script>
  (function() {
    const $ = id => document.getElementById(id);
    const ptsInput = $('amexPoints');
    const bonusInput = $('promotionalBonus');

    function calculate() {
      const pts = parseInt(ptsInput.value, 10) || 0;
      const bonus = parseFloat(bonusInput.value) || 0;

      if (pts < 1000) {
        $('outTransferable').textContent = '0';
        $('outMiles').textContent = '0';
        $('outNote').textContent = '最低起转量为 1,000 点 Amex 积分。';
        $('outValue').textContent = '¥0';
        $('outBaseRatio').textContent = '5:4 (0.80x)';
        $('outBonus').textContent = bonus + '%';
        $('outMultiplier').textContent = '0.80';
        $('outCode').textContent = '比例 5:4 (0.8)';
        return;
      }

      const transferable = Math.floor(pts / 1000) * 1000;
      const remainder = pts - transferable;
      const baseMiles = Math.round((transferable / 1000) * 800);
      const multiplier = (0.80 * (1 + bonus / 100));
      const totalMiles = Math.round(baseMiles * (1 + bonus / 100));
      const estCny = Math.round(totalMiles * 0.013 * 7.0);

      $('outTransferable').textContent = transferable.toLocaleString('zh-CN');
      $('outMiles').textContent = totalMiles.toLocaleString('zh-CN');
      $('outValue').textContent = '¥' + estCny.toLocaleString('zh-CN');
      $('outBaseRatio').textContent = '5:4 (0.80x)';
      $('outBonus').textContent = bonus + '%';
      $('outMultiplier').textContent = multiplier.toFixed(2);
      $('outCode').textContent = bonus > 0 ? `比例 5:4 (${multiplier.toFixed(2)}x)` : '比例 5:4 (0.8)';

      if (remainder > 0) {
        $('outNote').textContent = `按 5:4 基础比例（最终 ${multiplier.toFixed(2)} 倍）转出 ${transferable.toLocaleString('zh-CN')} 点。账户剩余 ${remainder.toLocaleString('zh-CN')} 点零头（起转与步长为 1,000 点）。`;
      } else {
        $('outNote').textContent = `全部 ${transferable.toLocaleString('zh-CN')} 点全额按 5:4 基础比例（最终 ${multiplier.toFixed(2)} 倍）转出。账户无零头残留。`;
      }
    }

    ptsInput.addEventListener('input', calculate);
    bonusInput.addEventListener('input', calculate);
    calculate();
  })();
</script>