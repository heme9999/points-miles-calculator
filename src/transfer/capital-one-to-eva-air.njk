  </ul>
</div>

<script>
  (function() {
    const $ = id => document.getElementById(id);
    const ptsInput = $('caponePoints');
    const bonusInput = $('promotionalBonus');

    function calculate() {
      const pts = parseInt(ptsInput.value, 10) || 0;
      const bonus = parseFloat(bonusInput.value) || 0;

      if (pts < 1000) {
        $('outTransferable').textContent = '0';
        $('outMiles').textContent = '0';
        $('outNote').textContent = '最低起转量为 1,000 点 Capital One 里程。';
        $('outValue').textContent = '¥0';
        return;
      }

      const transferable = Math.floor(pts / 1000) * 1000;
      const remainder = pts - transferable;
      const baseMiles = Math.round((transferable / 1000) * 750);
      const totalMiles = Math.round(baseMiles * (1 + bonus / 100));
      const estCny = Math.round(totalMiles * 0.014 * 7.0);

      $('outTransferable').textContent = transferable.toLocaleString('zh-CN');
      $('outMiles').textContent = totalMiles.toLocaleString('zh-CN');
      $('outValue').textContent = '¥' + estCny.toLocaleString('zh-CN');

      if (remainder > 0) {
        $('outNote').textContent = `按 4:3 比例转出 ${transferable.toLocaleString('zh-CN')} 里程。账户剩余 ${remainder.toLocaleString('zh-CN')} 点零头（起转与步长为 1,000 点）。`;
      } else {
        $('outNote').textContent = `全部 ${transferable.toLocaleString('zh-CN')} 点全额按 4:3 转出。账户无零头残留。`;
      }
    }

    ptsInput.addEventListener('input', calculate);
    bonusInput.addEventListener('input', calculate);
    calculate();
  })();
</script>