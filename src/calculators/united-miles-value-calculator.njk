<script>
(function() {
  const $ = id => document.getElementById(id);

  let currentCurrency = 'USD';
  let defaultFx = 7.0;

  function getActiveFx() {
    const fxInput = $('fxRate');
    if (!fxInput) return defaultFx;
    const v = parseFloat(fxInput.value);
    return (!isNaN(v) && isFinite(v) && v > 0) ? v : defaultFx;
  }

  function getScenarioUsdCpp(scen) {
    if (scen === '1.0') return 1.0;
    if (scen === '1.2') return 1.2;
    if (scen === '1.5') return 1.5;
    return 1.2;
  }

  const parseParam = (key, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };

  parseParam('miles', 'unitedMiles');
  parseParam('points', 'unitedMiles');
  parseParam('cpp', 'cppValue');
  parseParam('valuation', 'cppValue');

  const params = new URLSearchParams(window.location.search);
  const currParam = params.get('currency') || params.get('curr');
  if (currParam && ['USD', 'CNY'].includes(currParam.toUpperCase())) {
    currentCurrency = currParam.toUpperCase();
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && ['USD', 'CNY'].includes(saved)) currentCurrency = saved;
    } catch(e) {}
  }
  if ($('currency')) $('currency').value = currentCurrency;

  const parseScenarioParam = () => {
    const scen = params.get('scenario') || params.get('presetValuation');
    if (scen && $('presetValuation')) {
      const validOptions = ['custom', '1.0', '1.2', '1.5'];
      if (validOptions.includes(scen)) {
        $('presetValuation').value = scen;
        if (scen !== 'custom') {
          const usdCpp = getScenarioUsdCpp(scen);
          const fx = getActiveFx();
          $('cppValue').value = currentCurrency === 'USD' ? usdCpp : parseFloat((usdCpp / 100 * fx).toFixed(4));
        }
      }
    }
  };
  parseScenarioParam();

  function updateCurrencyUI() {
    const isUSD = currentCurrency === 'USD';
    $('hintValuation').textContent = isUSD ? '美分/里' : '元/里';
    $('fieldFx').style.display = isUSD ? 'none' : 'block';

    const select = $('presetValuation');
    if (select) {
      const fx = getActiveFx();
      select.options[1].text = isUSD ? '保守情景：1.0 美分/里（短途经济舱底线）' : `保守情景：¥${(0.01 * fx).toFixed(3)}/里（短途底线）`;
      select.options[2].text = isUSD ? '典型情景：1.2 美分/里（标准经济舱兑换）' : `典型情景：¥${(0.012 * fx).toFixed(3)}/里（标准兑换）`;
      select.options[3].text = isUSD ? '高价值情景：1.5 美分/里（商务舱或伙伴甜点）' : `高价值情景：¥${(0.015 * fx).toFixed(3)}/里（商务舱/甜点）`;
    }
  }

  function calcUnited() {
    const rawM = $('unitedMiles').value.trim();
    const rawC = $('cppValue').value.trim();
    const M = parseFloat(rawM);
    const C = parseFloat(rawC);

    const resetState = (msg = '请输入有效的数值。') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (rawM === '' || rawC === '' || isNaN(M) || isNaN(C) || !isFinite(M) || !isFinite(C) || M < 0 || C < 0) {
      resetState((M < 0 || C < 0) ? '输入不能为负数。' : '请输入里程余额和估值。');
      return;
    }

    if (M === 0 || C === 0) {
      $('dollarValue').textContent = currentCurrency === 'USD' ? '$0' : '¥0';
      $('dollarValue').classList.add('win');
      $('explain').textContent = `里程余额：${M.toLocaleString('zh-CN')} | 测算旅行价值：${currentCurrency === 'USD' ? '$0' : '¥0'}。规划参考，非现金回购价值。`;
      return;
    }

    let total = 0;
    if (currentCurrency === 'USD') {
      total = M * (C / 100);
      $('dollarValue').textContent = '$' + total.toLocaleString('en-US', { maximumFractionDigits: 0 });
      $('explain').textContent = `里程余额：${M.toLocaleString('zh-CN')} | 估值：${C} 美分/里 | 测算旅行价值：$${total.toLocaleString('en-US', { maximumFractionDigits: 0 })}。规划参考，非现金回购价值。`;
    } else {
      total = M * C;
      $('dollarValue').textContent = '¥' + total.toLocaleString('zh-CN', { maximumFractionDigits: 0 });
      $('explain').textContent = `里程余额：${M.toLocaleString('zh-CN')} | 估值：¥${C} 元/里 | 测算旅行价值：¥${total.toLocaleString('zh-CN', { maximumFractionDigits: 0 })}。规划参考，非现金回购价值。`;
    }
    $('dollarValue').classList.add('win');
  }

  if ($('currency')) {
    $('currency').addEventListener('change', e => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      const fx = getActiveFx();
      const select = $('presetValuation');
      const curScen = select ? select.value : 'custom';

      if (curScen !== 'custom') {
        const usdCpp = getScenarioUsdCpp(curScen);
        $('cppValue').value = currentCurrency === 'USD' ? usdCpp : parseFloat((usdCpp / 100 * fx).toFixed(4));
      } else {
        const oldVal = parseFloat($('cppValue').value) || 0;
        if (oldVal > 0) {
          if (currentCurrency === 'USD' && oldCurrency === 'CNY') {
            $('cppValue').value = parseFloat((oldVal / fx * 100).toFixed(2));
          } else if (currentCurrency === 'CNY' && oldCurrency === 'USD') {
            $('cppValue').value = parseFloat((oldVal / 100 * fx).toFixed(4));
          }
        }
      }

      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateCurrencyUI();
      calcUnited();
    });
  }

  if ($('fxRate')) {
    $('fxRate').addEventListener('input', () => {
      updateCurrencyUI();
      const select = $('presetValuation');
      const curScen = select ? select.value : 'custom';
      const fx = getActiveFx();
      if (curScen !== 'custom' && currentCurrency === 'CNY') {
        const usdCpp = getScenarioUsdCpp(curScen);
        $('cppValue').value = parseFloat((usdCpp / 100 * fx).toFixed(4));
      }
      calcUnited();
    });
  }

  document.querySelectorAll('.btn-balance-preset').forEach(btn => {
    btn.addEventListener('click', function() {
      $('unitedMiles').value = this.getAttribute('data-miles');
      calcUnited();
    });
  });

  $('presetValuation').addEventListener('change', e => {
    if (e.target.value !== 'custom') {
      const usdCpp = getScenarioUsdCpp(e.target.value);
      const fx = getActiveFx();
      $('cppValue').value = currentCurrency === 'USD' ? usdCpp : parseFloat((usdCpp / 100 * fx).toFixed(4));
      calcUnited();
    }
  });

  $('cppValue').addEventListener('input', () => {
    $('presetValuation').value = 'custom';
    calcUnited();
  });

  $('unitedMiles').addEventListener('input', calcUnited);

  const btnHelp = $('btnHelpScenario');
  const guideBox = $('helpScenarioGuide');
  if (btnHelp && guideBox) {
    btnHelp.addEventListener('click', () => {
      const isExpanded = btnHelp.getAttribute('aria-expanded') === 'true';
      btnHelp.setAttribute('aria-expanded', !isExpanded);
      guideBox.style.display = isExpanded ? 'none' : 'block';
    });
  }

  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/calculators/united-miles-value-calculator/');
      const m = parseFloat($('unitedMiles').value) || 0;
      const c = parseFloat($('cppValue').value) || 0;
      if (m > 0) url.searchParams.set('miles', m);
      if (c > 0) url.searchParams.set('cpp', c);
      if (currentCurrency) url.searchParams.set('currency', currentCurrency);
      const scen = $('presetValuation').value;
      if (scen && scen !== 'custom') url.searchParams.set('scenario', scen);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      });
    });
  }

  updateCurrencyUI();
  calcUnited();
})();
</script>
