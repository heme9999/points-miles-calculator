  <h3>常见问题 (FAQ)</h3>
  <div class="faq">
    <details>
      <summary>CPP 是越高越好吗？</summary>
      <div>
        <p>理论上是的，但不要盲目追求高 CPP。比如一张两舱机票标价 10 万元，你用了 10 万积分兑换，CPP 达到了 1 元/点。但如果你本来绝不会花 10 万元买这张票，这个 CPP 就只是账面的“虚高”价值。你应该用自己真实愿意支付的金额来重新计算 CPP。</p>
      </div>
    </details>
    
    <details>
      <summary>酒店积分的 CPP 怎么算？</summary>
      <div>
        <p>和机票类似：(包含所有税费的现金总房价 - 积分房额外杂费) ÷ 所需总积分。需要注意的是，希尔顿和凯悦用全积分兑换时会免除度假村费，计算时这部分被免除的费用算作“省下的现金”。</p>
      </div>
    </details>

    <details>
      <summary>我的 CPP 是负数，说明什么？</summary>
      <div>
        <p>这说明你兑换该机票时需要支付的税费和燃油附加费，已经超过了直接购买这张机票的全部费用！通常建议放弃兑换，直接花钱买票。</p>
      </div>
    </details>
  </div>

  </div>

<script>
  const $ = id => document.getElementById(id);

  const params = new URLSearchParams(window.location.search);
  let currentCurrency = 'CNY';
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) {
        currentCurrency = saved;
      }
    } catch(e) {}
  }
  
  const updateUnits = () => {
    if (currentCurrency === 'USD') {
      if($('hintCash')) $('hintCash').textContent = '美元';
      if($('hintTaxes')) $('hintTaxes').textContent = '美元';
    } else {
      if($('hintCash')) $('hintCash').textContent = '元';
      if($('hintTaxes')) $('hintTaxes').textContent = '元';
    }
  };

  if ($('currency')) {
    $('currency').value = currentCurrency;
    $('currency').addEventListener('change', (e) => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      if (oldCurrency !== currentCurrency) {
        $('cashPrice').value = '';
        $('awardTaxes').value = '';
        
        const warningMsg = currentCurrency === 'USD' 
          ? '货币已切换。为避免人民币和美元金额混淆，请重新填写金额。' 
          : '货币已切换。为避免人民币和美元金额混淆，请重新填写金额。';
          
        function clearCalculatorResults() {
          $('cppResult').textContent = '-';
          $('cppResult').classList.remove('win');
          $('explain').innerHTML = `<span style="color:#eab308; font-weight:bold;">${warningMsg}</span>`;
        }
        clearCalculatorResults();
      }
      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateUnits();
      if ($('cashPrice').value) {
        calcCpp();
      }
    });
  }

  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      if (key === 'points' && val === 0) return;
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('cash', 'cashPrice');
  parseParam('points', 'pointsNeeded');
  parseParam('taxes', 'awardTaxes');

  function calcCpp(){
    let C = parseFloat($('cashPrice').value) || 0;
    let T = parseFloat($('awardTaxes').value) || 0;
    let P = parseFloat($('pointsNeeded').value) || 0;
    
    const resetState = (msg = '请输入有效的数值。') => {
      $('savedCash').textContent = '-';
      $('cppResult').textContent = '-';
      $('explain').textContent = msg;
      $('cppResult').classList.remove('win', 'bad');
    };

    if (P <= 0 || C < 0 || T < 0) {
      resetState(P <= 0 ? '请输入里程票所需积分数量。' : '输入不能为负数。');
      return;
    }
    
    const saved = C - T;
    const cpp = saved / P;
    
    if (currentCurrency === 'USD') {
      $('savedCash').textContent = '$' + saved.toLocaleString('en-US', {maximumFractionDigits:2});
      $('cppResult').textContent = (cpp * 100).toFixed(2) + ' 美分/点';
    } else {
      $('savedCash').textContent = '¥' + saved.toLocaleString('zh-CN', {maximumFractionDigits:0});
      $('cppResult').textContent = '¥' + cpp.toFixed(4) + ' 元/点';
    }
    
    const explain = $('explain');
    $('cppResult').classList.remove('win', 'bad');

    if(saved < 0){
      explain.textContent = '警告：倒贴钱！不仅没省钱，你交的税费比直接买机票还贵。';
      $('cppResult').classList.add('bad');
    } else {
      // Comparison logic is simpler if we use CNY reference or generic logic
      // Assuming original logic was for CNY (0.05, 0.20)
      let cppForCompare = currentCurrency === 'USD' ? cpp * 7 : cpp; // rough logic to reuse same messages
      if(cppForCompare < 0.05) {
        explain.textContent = 'CPP 极低。这通常说明你用在了非航司兑换上（例如换微波炉或者极差的经济舱短途），建议直接花现金。';
        $('cppResult').classList.add('bad');
      } else if(cppForCompare > 0.2) {
        explain.textContent = '顶级兑换！这个 CPP 已经处于极高水平，通常只有在兑换热门日期的稀缺两舱（头等舱/商务舱）时才能达到。';
        $('cppResult').classList.add('win');
      } else {
        explain.textContent = '表现不错，处于正常合理区间内，只要航线适合你，就可以果断兑换。';
      }
    }
  }

  ['cashPrice','pointsNeeded','awardTaxes'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcCpp);
  });
  
  updateUnits();
  if($('cashPrice').value) calcCpp();
</script>
