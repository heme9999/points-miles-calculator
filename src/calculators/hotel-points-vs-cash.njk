<script>
  const $ = id => document.getElementById(id);
  
  const params = new URLSearchParams(window.location.search);
  let currentCurrency = 'CNY';
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) {
        currentCurrency = saved;
      }
    } catch(e) {}
  }
  
  const updateUnits = () => {
    const isUSD = currentCurrency === 'USD';
    const cHint = isUSD ? '美元' : '元';
    const cValHint = isUSD ? '美分/点 (选填)' : '元/点 (选填)';
    
    ['hintCash', 'hintTaxes', 'hintCashResort', 'hintValueEarned', 'hintCCRewards', 'hintAwardTaxes', 'hintAwardResort'].forEach(id => {
      if($(id)) $(id).textContent = cHint;
    });
    if($('hintValuation')) $('hintValuation').textContent = cValHint;
  };

  if ($('currency')) {
    $('currency').value = currentCurrency;
    $('currency').addEventListener('change', (e) => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      if (oldCurrency !== currentCurrency) {
        ['cashPrice', 'cashTaxes', 'cashResortFees', 'cashValueEarned', 'ccRewardsValue', 'personalValuation', 'awardTaxes', 'awardResortFees'].forEach(id => {
           if($(id)) $(id).value = '';
        });
        
        const warningMsg = '货币已切换。为避免人民币和美元金额混淆，请重新填写金额与估值。';
          
        function clearCalculatorResults() {
          $('cppResult').textContent = '-';
          $('costCompare').innerHTML = '积分成本: -<br>现金成本: -';
          $('verdictText').textContent = '—';
          $('verdictCode').textContent = '-';
          $('verdictText').className = 'v';
          $('cppResult').classList.remove('win');
          $('explain').innerHTML = `<span style="color:#eab308; font-weight:bold;">${warningMsg}</span>`;
          $('mathBreakdown').style.display = 'none';
        }
        clearCalculatorResults();
      }
      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateUnits();
      if ($('cashPrice').value) calcAdv();
    });
  }

  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      if (key === 'points' && val === 0) return;
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  
  // URL Param Extraction
  parseParam('cash', 'cashPrice');
  parseParam('nights', 'nights', 365);
  parseParam('taxes', 'cashTaxes');
  parseParam('resort', 'cashResortFees');
  parseParam('points', 'pointsPerNight');
  parseParam('ataxes', 'awardTaxes');
  parseParam('aresort', 'awardResortFees');
  parseParam('earned', 'cashValueEarned');
  parseParam('cc', 'ccRewardsValue');
  parseParam('valuation', 'personalValuation', 1000);
  
  const pFreeRule = params.get('freeRule');
  if (['none', '5th', 'custom'].includes(pFreeRule)) {
    $('freeNightRule').value = pFreeRule;
  }
  parseParam('customN', 'customN', 30);
  const pPreset = params.get('preset');
  if (['custom', 'hyatt', 'hilton', 'marriott'].includes(pPreset)) {
    $('programPreset').value = pPreset;
  }

  // Presets logic
  $('programPreset').addEventListener('change', (e) => {
    const v = e.target.value;
    const note = $('presetNote');
    if (v === 'hyatt') {
      note.textContent = '凯悦 (Hyatt): 全积分房通常免度假村费；仅少数高端卡可能有住宿优惠。';
      if (!params.has('valuation')) { $('personalValuation').value = currentCurrency === 'USD' ? '1.7' : '0.12'; }
    } else if (v === 'hilton') {
      note.textContent = '希尔顿 (Hilton): 银卡及以上会员享全积分住五付四；全积分房免度假村费。';
      if (!params.has('valuation')) { $('personalValuation').value = currentCurrency === 'USD' ? '0.5' : '0.035'; }
      $('freeNightRule').value = '5th';
    } else if (v === 'marriott') {
      note.textContent = '万豪 (Marriott): 所有人全积分连住五晚最便宜的一晚免费；积分房仍收度假村费。';
      if (!params.has('valuation')) { $('personalValuation').value = currentCurrency === 'USD' ? '0.7' : '0.05'; }
      $('freeNightRule').value = '5th';
    } else {
      note.textContent = '预订前请查看计划及具体酒店的最新条款。';
    }
    calcAdv();
  });

  $('freeNightRule').addEventListener('change', (e) => {
    $('customNField').style.display = (e.target.value === 'custom') ? 'block' : 'none';
    calcAdv();
  });
  if($('freeNightRule').value === 'custom') $('customNField').style.display = 'block';

  function calcAdv(){
    let cashRate = parseFloat($('cashPrice').value) || 0;
    let nights = parseInt($('nights').value) || 1;
    let cashTaxes = parseFloat($('cashTaxes').value) || 0;
    let cashResort = parseFloat($('cashResortFees').value) || 0;
    let pointsPerNight = parseFloat($('pointsPerNight').value) || 0;
    let awardTaxes = parseFloat($('awardTaxes').value) || 0;
    let awardResort = parseFloat($('awardResortFees').value) || 0;
    let earned = parseFloat($('cashValueEarned').value) || 0;
    let cc = parseFloat($('ccRewardsValue').value) || 0;
    let V = parseFloat($('personalValuation').value) || 0;
    
    let freeRule = $('freeNightRule').value;
    let customN = parseInt($('customN').value) || 4;

    const resetState = (msg) => {
      $('cppResult').textContent = '-';
      $('costCompare').innerHTML = '积分成本: -<br>现金成本: -';
      $('verdictText').textContent = '—';
      $('verdictCode').textContent = 'DIFF —';
      $('explain').textContent = msg;
      $('verdictText').className = 'verdict';
      $('cppResult').classList.remove('win');
      $('cppResult').parentElement.classList.remove('win');
      $('mathBreakdown').style.display = 'none';
    };

    if (pointsPerNight <= 0 || cashRate <= 0) {
      resetState('请输入每晚现金房价和每晚所需积分。');
      return;
    }

    // Free nights logic
    let paidAwardNights = nights;
    let freeNights = 0;
    if (freeRule === '5th') {
      freeNights = Math.floor(nights / 5);
      paidAwardNights = nights - freeNights;
    } else if (freeRule === 'custom') {
      freeNights = Math.floor(nights / customN);
      paidAwardNights = nights - freeNights;
    }

    let totalPointsRequired = paidAwardNights * pointsPerNight;
    let totalCashCost = (cashRate * nights) + cashTaxes + cashResort;
    let forgoneValue = earned + cc;
    let awardCashCost = awardTaxes + awardResort;
    
    let netCashSaved = totalCashCost - forgoneValue - awardCashCost;
    
    if (netCashSaved < 0) {
      resetState('现金房回血和积分房税费过高，导致使用积分反而亏损现金。强烈建议直接买票/订房。');
      $('verdictText').textContent = '不建议兑换';
      $('verdictText').className = 'verdict bad';
      $('verdictCode').textContent = 'DIFF < 0';
      return;
    }

    let displayCpp = '';
    let actualCpp = totalPointsRequired > 0 ? (netCashSaved / totalPointsRequired) : 0; 
    let compActualCpp = actualCpp;

    if (currentCurrency === 'USD') {
      compActualCpp = actualCpp * 100; // cents
      displayCpp = compActualCpp.toFixed(2) + ' 美分/点';
    } else {
      displayCpp = '¥' + actualCpp.toFixed(4) + ' / 点';
    }
    
    $('cppResult').textContent = displayCpp;

    let costIfPoints = 0;
    if (currentCurrency === 'USD') {
      costIfPoints = (totalPointsRequired * (V / 100)) + awardCashCost;
    } else {
      costIfPoints = (totalPointsRequired * V) + awardCashCost;
    }
    const costIfCash = totalCashCost - forgoneValue;

    if (currentCurrency === 'USD') {
      $('costCompare').innerHTML = `积分等价: $${costIfPoints.toLocaleString('en-US', {maximumFractionDigits:0})}<br>现金净成本: $${costIfCash.toLocaleString('en-US', {maximumFractionDigits:0})}`;
    } else {
      $('costCompare').innerHTML = `积分等价: ¥${costIfPoints.toLocaleString('zh-CN', {maximumFractionDigits:0})}<br>现金净成本: ¥${costIfCash.toLocaleString('zh-CN', {maximumFractionDigits:0})}`;
    }

    // Breakdown math
    let currSym = currentCurrency === 'USD' ? '$' : '¥';
    $('mathBreakdown').style.display = 'block';
    $('mathBreakdown').innerHTML = `
      <strong>计算过程:</strong><br>
      • 现金原价: ${nights}晚 × ${currSym}${cashRate} + 税费/度假村费 ${currSym}${cashTaxes + cashResort} = ${currSym}${totalCashCost}<br>
      • 减去放弃的回血: -${currSym}${forgoneValue}<br>
      • 减去积分房所需税费: -${currSym}${awardCashCost}<br>
      • 实际避免的现金支出: <strong>${currSym}${netCashSaved}</strong><br>
      • 实际消耗积分: ${nights}晚 - ${freeNights}晚免费 = ${paidAwardNights}晚 × ${pointsPerNight} = <strong>${totalPointsRequired} 积分</strong>
    `;

    const verdict = $('verdictText');
    const code = $('verdictCode');
    const explain = $('explain');

    $('cppResult').classList.remove('win');
    $('cppResult').parentElement.classList.remove('win');
    verdict.className = 'verdict';

    if (compActualCpp <= 0) {
      verdict.textContent = '不如付现金';
      verdict.className = 'verdict bad';
      explain.textContent = '使用积分并不划算。';
      code.textContent = 'DIFF < 0';
    } else if (compActualCpp > V && V > 0) {
      verdict.textContent = '推荐用积分';
      verdict.className = 'verdict good';
      $('cppResult').classList.add('win');
      const diff = ((compActualCpp - V) / V * 100).toFixed(0);
      explain.textContent = `这次兑换的实际价值高出你的个人估值 ${diff}%。综合来看，使用积分比花现金更划算。`;
      code.textContent = `DIFF +${diff}%`;
    } else if (compActualCpp < V && V > 0) {
      verdict.textContent = '不如付现金';
      verdict.className = 'verdict bad';
      const diff = ((V - compActualCpp) / V * 100).toFixed(0);
      explain.textContent = `实际价值低于你的个人估值，相当于这波积分用亏了 ${diff}%。建议保留积分，直接现金预订。`;
      code.textContent = `DIFF -${diff}%`;
    } else {
      verdict.textContent = '看情况';
      verdict.className = 'verdict';
      explain.textContent = V === 0 ? '你没有输入个人估值，无法直接给出建议。请根据这个 CPP 自行判断。' : '兑换价值与你的心理预期差不多，选哪种都可以。';
      code.textContent = 'DIFF ~0%';
    }
  }

  ['cashPrice','nights','cashTaxes','cashResortFees','cashValueEarned','ccRewardsValue','personalValuation','awardTaxes','awardResortFees','pointsPerNight','customN'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcAdv);
  });
  
  updateUnits();
  if($('cashPrice').value) calcAdv();

  // Share functionality
  $('btnShare').addEventListener('click', () => {
    const newParams = new URLSearchParams();
    const safeSet = (key, id) => {
      const v = parseFloat($(id).value);
      if (!isNaN(v) && v > 0) newParams.set(key, v);
    };
    safeSet('cash', 'cashPrice');
    safeSet('nights', 'nights');
    safeSet('taxes', 'cashTaxes');
    safeSet('resort', 'cashResortFees');
    safeSet('points', 'pointsPerNight');
    safeSet('ataxes', 'awardTaxes');
    safeSet('aresort', 'awardResortFees');
    safeSet('earned', 'cashValueEarned');
    safeSet('cc', 'ccRewardsValue');
    safeSet('valuation', 'personalValuation');
    
    if ($('freeNightRule').value !== 'none') newParams.set('freeRule', $('freeNightRule').value);
    if ($('freeNightRule').value === 'custom') safeSet('customN', 'customN');
    if ($('programPreset').value !== 'custom') newParams.set('preset', $('programPreset').value);
    newParams.set('currency', currentCurrency);
    
    const newUrl = window.location.pathname + '?' + newParams.toString();
    history.replaceState(null, '', newUrl);
    
    navigator.clipboard.writeText(window.location.origin + newUrl).then(() => {
      const toast = $('toast');
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 2500);
    });
  });
</script>
