  </ul>

  <h2>酒店积分 vs 现金 4 大核心考量</h2>
  <div class="faq" style="margin-top: 20px;">
    <details>
      <summary>1. 结账页面的总积分是否已经扣除了“住五免一”？</summary>
      <div>
        <p>是的。在希尔顿和万豪的官方 App 或官网结账页面，当你连续预订 5 晚全积分房且符合会员资格时，系统显示的<strong>“所需总积分”通常已经扣除了免去的一晚</strong>。因此在基础模式下，直接输入结账页面显示的最终总积分即可，切勿手动再扣除一次，否则会导致重复计算、人为拔高 CPP 结果。</p>
      </div>
    </details>

    <details>
      <summary>2. 为什么度假村费 (Resort Fee) 会极大改变兑换价值？</summary>
      <div>
        <p>在拉斯维加斯、夏威夷或奥兰多等热门度假目的地，酒店通常每晚加收 $35 到 $65 美元不等的度假村设施费。<strong>凯悦 (World of Hyatt) 与希尔顿 (Hilton Honors)</strong> 官方条款明确规定，全积分预订免收度假村费；而万豪与大部分洲际酒店在全积分预订时仍强制收取该笔现金。免除度假村费相当于让积分额外抵扣了现金支出，大幅提升每点实际价值。</p>
      </div>
    </details>

    <details>
      <summary>3. 什么是现金预订放弃的回血积分与刷卡价值？</summary>
      <div>
        <p>如果你选择付现金订房，通常可以获得：① 酒店基础常客积分（如每消费 $1 美元积 10 点）；② 精英会员加赠积分（最高达 100% 额外加赠）；③ 季度促销活动积分；④ 联名信用卡多倍返现或积分（如万豪卡 6x 返点）。这部分本能拿到的现金等价回报属于“机会成本”，用积分订房就无法获得。在高级模式中填入这些回血，能够得出最严谨的决策。</p>
      </div>
    </details>

    <details>
      <summary>4. 房券 (Free Night Award / Certificate) 与积分该如何抉择？</summary>
      <div>
        <p>信用卡赠送的年度免房券（如万豪 35k/50k 券、洲际 40k 券、凯悦 C4/C7 券、希尔顿不限等级券）通常有 1 年有效期的硬性限制，且不能享受住五免一优惠。建议在单晚高价停留或临近过期时优先消耗房券，将灵活度更高的通用积分保留用于多晚连住兑换。</p>
      </div>
    </details>
  </div>

  <p class="disclaimer" style="margin-top: 30px; font-size: 0.85em; color: #64748b;">
    <em>最后事实审核：2026年9月。各酒店集团积分规则与预设估值仅作建模参考，非官方保底承诺。预订前请务必确认具体酒店当期的退改与费用政策。</em>
  </p>
</article>

<script src="/assets/calculator-core.js" onload="if(typeof calculate==='function') calculate();"></script>
<script>
  const $ = id => document.getElementById(id);

  const state = {
    currency: 'CNY',
    fxRate: 7.0,
    programId: 'custom',
    inputMode: 'checkout-total',
    userHasCustomValuation: false,
    rawValues: {
      totalCashPrice: 1500,
      totalPointsRequired: 80000,
      awardCashFees: 0,
      personalValuation: 0.070,
      nightlyCashPrice: 300,
      pointsPerNight: 20000,
      cashTaxes: 0,
      cashResortFees: 0,
      awardTaxes: 0,
      awardResortFees: 0,
      hotelPointsEarnedValue: 0,
      creditCardRewardsValue: 0
    }
  };

  const programsData = {
    {% for prog in hotelPrograms %}
    "{{ prog.id }}": {
      id: "{{ prog.id }}",
      nameZh: "{{ prog.nameZh }}",
      nameEn: "{{ prog.nameEn }}",
      usdCents: {{ prog.valuationScenarioUsdCents }},
      cny: {{ prog.valuationScenarioCny }},
      freeNightRule: "{{ prog.freeNightRule }}",
      eligibilityZh: "{{ prog.eligibilityNoteZh | escape }}",
      resortFeeZh: "{{ prog.resortFeeNoteZh | escape }}",
      officialSourceUrl: "{{ prog.officialSourceUrl }}",
      officialSourceName: "{{ prog.officialSourceName }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  };

  const params = new URLSearchParams(window.location.search);
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency') || params.get('curr');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    state.currency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) state.currency = saved;
    } catch(e) {}
  }
  $('currency').value = state.currency;

  function updateCurrencyLabels() {
    const isUSD = state.currency === 'USD';
    const sym = isUSD ? '$' : '¥';
    const valHint = isUSD ? '美分/点 (选填)' : '¥/点 (选填)';
    
    $('hintTotalCash').textContent = sym;
    $('hintAwardCashFees').textContent = sym;
    $('hintValuation').textContent = valHint;
    $('hintNightlyCash').textContent = sym + '/晚';
    $('hintCashTaxes').textContent = sym;
    $('hintCashResort').textContent = sym;
    $('hintAwardTaxes').textContent = sym;
    $('hintAwardResort').textContent = sym;
    $('hintHotelEarned').textContent = sym + ' (选填)';
    $('hintCCEarned').textContent = sym + ' (选填)';
  }

  function updateProgramPolicyCard(progId) {
    const prog = programsData[progId] || programsData.custom;
    const rBadge = $('policyResortBadge');
    const fBadge = $('policyFreeBadge');
    const pText = $('policyText');
    const pLink = $('policySourceLink');

    if (prog.resortFeeZh.includes('免除') && !prog.resortFeeZh.includes('不免除')) {
      rBadge.className = 'policy-badge waived';
      rBadge.textContent = '全积分免度假村费';
    } else if (prog.resortFeeZh.includes('不免除')) {
      rBadge.className = 'policy-badge charged';
      rBadge.textContent = '积分房收度假村费';
    } else {
      rBadge.className = 'policy-badge varies';
      rBadge.textContent = '度假村费视酒店而定';
    }

    if (prog.freeNightRule === '5th') {
      fBadge.className = 'policy-badge waived';
      fBadge.textContent = '含住五免一优惠';
      $('freeNightRule').value = '5th';
    } else {
      fBadge.className = 'policy-badge varies';
      fBadge.textContent = '无常态住五免一';
      if ($('freeNightRule').value === '5th') $('freeNightRule').value = 'none';
    }

    pText.textContent = prog.eligibilityZh + ' ' + prog.resortFeeZh;

    if (prog.officialSourceUrl) {
      pLink.href = prog.officialSourceUrl;
      pLink.textContent = prog.officialSourceName;
      pLink.style.display = 'inline';
    } else {
      pLink.textContent = '用户自定义';
      pLink.removeAttribute('href');
    }

    if (!state.userHasCustomValuation) {
      const defaultVal = state.currency === 'USD' ? prog.usdCents : prog.cny;
      state.rawValues.personalValuation = defaultVal;
      $('personalValuation').value = defaultVal;
    }
  }

  function renderResults(result) {
    const isUSD = state.currency === 'USD';
    const sym = isUSD ? '$' : '¥';

    const cppResultEl = $('cppResult');
    const costCompareEl = $('costCompare');
    const explainEl = $('explain');
    const verdictTextEl = $('verdictText');
    const verdictCodeEl = $('verdictCode');
    const tier2El = $('tier2Breakdown');

    verdictTextEl.className = 'verdict';
    cppResultEl.classList.remove('win');
    cppResultEl.parentElement.classList.remove('win');

    if (result.actualPointsUsed <= 0 || result.grossCashCost <= 0) {
      cppResultEl.textContent = '-';
      costCompareEl.innerHTML = '积分等价: -<br>现金净成本: -';
      verdictTextEl.textContent = '—';
      verdictCodeEl.textContent = 'DIFF —';
      explainEl.textContent = '请输入现金总价和兑换所需积分。';
      tier2El.style.display = 'none';
      return;
    }

    let displayCpp = '';
    if (isUSD) {
      displayCpp = result.cpp.toFixed(2) + ' ¢/点';
    } else {
      displayCpp = '¥' + result.localPerPoint.toFixed(4) + ' / 点';
    }
    cppResultEl.textContent = displayCpp;

    let pointsEquivalentCost = 0;
    if (result.personalValuation) {
      if (isUSD) {
        pointsEquivalentCost = (result.actualPointsUsed * (result.personalValuation / 100)) + result.awardCashCost;
      } else {
        pointsEquivalentCost = (result.actualPointsUsed * result.personalValuation) + result.awardCashCost;
      }
    }

    costCompareEl.innerHTML = `
      积分等价: ${result.personalValuation ? sym + Math.round(pointsEquivalentCost).toLocaleString() : '未设估值'}<br>
      现金净成本: ${sym + Math.round(result.netCashCost).toLocaleString()}
    `;

    tier2El.style.display = 'block';
    $('stepGrossCash').innerHTML = '1. 现金预订总支出: <strong>' + sym + result.grossCashCost.toLocaleString() + '</strong>';
    
    if (result.hotelPointsEarnedValue > 0 || result.creditCardRewardsValue > 0) {
      $('stepForgone').style.display = 'block';
      $('stepForgone').innerHTML = '2. 扣除放弃的现金房回血: -' + sym + (result.hotelPointsEarnedValue + result.creditCardRewardsValue).toLocaleString() + ' (净现金: ' + sym + result.netCashCost.toLocaleString() + ')';
    } else {
      $('stepForgone').style.display = 'none';
    }

    $('stepAwardCash').innerHTML = '3. 积分房自付现金税费: <strong>' + sym + result.awardCashCost.toLocaleString() + '</strong>';
    $('stepNetSaved').innerHTML = '4. 实际避免的现金支出: <strong>' + sym + result.avoidedCashSpend.toLocaleString() + '</strong>';
    $('stepPoints').innerHTML = '5. 实际消耗积分: <strong>' + result.actualPointsUsed.toLocaleString() + ' 点</strong> (入住 ' + result.nights + ' 晚' + (result.freeNights > 0 ? '，含 ' + result.freeNights + ' 晚免费' : '') + ')';

    if (result.personalValuationDifference !== null) {
      const diffSign = result.personalValuationDifference >= 0 ? '+' : '';
      $('stepValuationComp').innerHTML = '6. 与个人估值对比: 实际每点价值比你的基准估值 (' + result.personalValuation + (isUSD ? '¢' : '元') + ') <strong>' + diffSign + result.personalValuationDifference + '%</strong>';
    } else {
      $('stepValuationComp').innerHTML = '6. 个人估值未填: 请根据实际兑出价值 (' + displayCpp + ') 结合你的积分获取成本综合决策。';
    }

    if (result.calculationWarnings.includes('award_cash_exceeds_cash_price')) {
      verdictTextEl.textContent = '不建议用分';
      verdictTextEl.className = 'verdict bad';
      verdictCodeEl.textContent = 'FEES > CASH';
      explainEl.textContent = '警告：积分房自付现金税费已达到或超过直接订现金房的总价，使用积分毫无节省。';
    } else if (result.calculationWarnings.includes('negative_avoided_cash')) {
      verdictTextEl.textContent = '不如付现金';
      verdictTextEl.className = 'verdict bad';
      verdictCodeEl.textContent = 'SAVINGS < 0';
      explainEl.textContent = '扣除税费与放弃的回血后，使用积分并不能节省现金。建议直接现金预订。';
    } else if (result.recommendation === 'points') {
      verdictTextEl.textContent = '推荐用积分';
      verdictTextEl.className = 'verdict good';
      cppResultEl.classList.add('win');
      cppResultEl.parentElement.classList.add('win');
      verdictCodeEl.textContent = 'DIFF +' + Math.round(result.personalValuationDifference) + '%';
      explainEl.textContent = '实际兑出价值高出你的基准估值 ' + Math.round(result.personalValuationDifference) + '%。在当前假设下，使用积分比花现金更具价值。';
    } else if (result.recommendation === 'cash') {
      verdictTextEl.textContent = '推荐付现金';
      verdictTextEl.className = 'verdict bad';
      verdictCodeEl.textContent = 'DIFF ' + Math.round(result.personalValuationDifference) + '%';
      explainEl.textContent = '实际兑出价值低于你的基准估值 (' + Math.abs(Math.round(result.personalValuationDifference)) + '% 差距)。建议保留积分，选择直接付现金。';
    } else if (result.recommendation === 'even') {
      verdictTextEl.textContent = '两者皆可';
      verdictTextEl.className = 'verdict';
      verdictCodeEl.textContent = 'DIFF ~0%';
      explainEl.textContent = '实际兑出价值与你的个人估值基本持平，可根据手头现金流动性或积分过期时间自由选择。';
    } else {
      verdictTextEl.textContent = '自行判断';
      verdictTextEl.className = 'verdict';
      verdictCodeEl.textContent = 'NO VAL';
      explainEl.textContent = '你未输入个人估值基准。实际兑出价值如上，请与你自己的心理估值或使用计划进行比对。';
    }
  }

  function calculate() {
    if (!window.CalculatorCore || !window.CalculatorCore.calculateHotelPointsVsCash) return;
    const input = {
      inputMode: state.inputMode,
      currency: state.currency,
      fxRate: state.fxRate,
      nights: parseInt($('nights').value, 10) || 1,
      totalCashPrice: parseFloat($('totalCashPrice').value) || 0,
      totalPointsRequired: parseFloat($('totalPointsRequired').value) || 0,
      awardCashFees: parseFloat($('awardCashFees').value) || 0,
      personalValuation: $('personalValuation').value !== '' ? parseFloat($('personalValuation').value) : null,
      nightlyCashPrice: parseFloat($('nightlyCashPrice').value) || 0,
      cashTaxes: parseFloat($('cashTaxes').value) || 0,
      cashResortFees: parseFloat($('cashResortFees').value) || 0,
      pointsPerNight: parseFloat($('pointsPerNight').value) || 0,
      freeNightRule: $('freeNightRule').value,
      customFreeNightInterval: parseInt($('customFreeNightInterval').value, 10) || 4,
      awardTaxes: parseFloat($('awardTaxes').value) || 0,
      awardResortFees: parseFloat($('awardResortFees').value) || 0,
      hotelPointsEarnedValue: parseFloat($('hotelPointsEarnedValue').value) || 0,
      creditCardRewardsValue: parseFloat($('creditCardRewardsValue').value) || 0
    };

    const res = window.CalculatorCore.calculateHotelPointsVsCash(input);
    renderResults(res);
  }

  function syncAdvancedToSimple() {
    state.inputMode = 'nightly-breakdown';
    const nights = parseInt($('nights').value, 10) || 1;
    const nightlyPrice = parseFloat($('nightlyCashPrice').value) || 0;
    const cashTaxes = parseFloat($('cashTaxes').value) || 0;
    const cashResort = parseFloat($('cashResortFees').value) || 0;
    const pointsPerNight = parseFloat($('pointsPerNight').value) || 0;
    const awardTaxes = parseFloat($('awardTaxes').value) || 0;
    const awardResort = parseFloat($('awardResortFees').value) || 0;

    let freeNights = 0;
    const rule = $('freeNightRule').value;
    if (rule === '5th' && nights >= 5) freeNights = Math.floor(nights / 5);
    else if (rule === '4th' && nights >= 4) freeNights = Math.floor(nights / 4);
    else if (rule === 'custom') {
      const interval = parseInt($('customFreeNightInterval').value, 10) || 4;
      if (interval >= 2 && nights >= interval) freeNights = Math.floor(nights / interval);
    }

    const grossCash = (nightlyPrice * nights) + cashTaxes + cashResort;
    const awardCash = awardTaxes + awardResort;
    const totalPts = Math.max(0, (nights - freeNights) * pointsPerNight);

    if (nightlyPrice > 0) $('totalCashPrice').value = grossCash;
    if (pointsPerNight > 0) $('totalPointsRequired').value = totalPts;
    $('awardCashFees').value = awardCash;
  }

  ['totalCashPrice', 'totalPointsRequired', 'awardCashFees', 'nights'].forEach(id => {
    $(id).addEventListener('input', () => {
      state.inputMode = 'checkout-total';
      calculate();
    });
  });

  $('personalValuation').addEventListener('input', () => {
    state.userHasCustomValuation = true;
    calculate();
  });

  ['nightlyCashPrice', 'pointsPerNight', 'cashTaxes', 'cashResortFees', 'awardTaxes', 'awardResortFees', 'hotelPointsEarnedValue', 'creditCardRewardsValue'].forEach(id => {
    $(id).addEventListener('input', () => {
      syncAdvancedToSimple();
      calculate();
    });
  });

  $('freeNightRule').addEventListener('change', (e) => {
    $('customIntervalField').style.display = e.target.value === 'custom' ? 'block' : 'none';
    if ($('advancedDetails').open) {
      syncAdvancedToSimple();
    }
    calculate();
  });
  $('customFreeNightInterval').addEventListener('input', () => {
    syncAdvancedToSimple();
    calculate();
  });

  $('programPreset').addEventListener('change', (e) => {
    state.programId = e.target.value;
    updateProgramPolicyCard(e.target.value);
    calculate();
  });

  $('currency').addEventListener('change', (e) => {
    const oldCurr = state.currency;
    const newCurr = e.target.value;
    if (oldCurr === newCurr) return;

    state.currency = newCurr;
    try { localStorage.setItem('preferredCurrency', newCurr); } catch(err) {}
    updateCurrencyLabels();

    const fx = state.fxRate;
    const toUSD = newCurr === 'USD';

    const scaleField = (id) => {
      const el = $(id);
      const val = parseFloat(el.value);
      if (!isNaN(val) && val > 0) {
        el.value = toUSD ? parseFloat((val / fx).toFixed(2)) : Math.round(val * fx);
      }
    };

    scaleField('totalCashPrice');
    scaleField('awardCashFees');
    scaleField('nightlyCashPrice');
    scaleField('cashTaxes');
    scaleField('cashResortFees');
    scaleField('awardTaxes');
    scaleField('awardResortFees');
    scaleField('hotelPointsEarnedValue');
    scaleField('creditCardRewardsValue');

    if (!state.userHasCustomValuation) {
      const prog = programsData[state.programId] || programsData.custom;
      $('personalValuation').value = toUSD ? prog.usdCents : prog.cny;
    } else {
      const pVal = parseFloat($('personalValuation').value);
      if (!isNaN(pVal) && pVal > 0) {
        $('personalValuation').value = toUSD ? parseFloat(((pVal * 100) / fx).toFixed(2)) : parseFloat(((pVal * fx) / 100).toFixed(4));
      }
    }

    calculate();
  });

  $('exampleHilton').addEventListener('click', () => {
    state.programId = 'hilton';
    $('programPreset').value = 'hilton';
    updateProgramPolicyCard('hilton');
    $('nights').value = '5';
    $('totalCashPrice').value = state.currency === 'USD' ? '1500' : '10500';
    $('totalPointsRequired').value = '240000';
    $('awardCashFees').value = '0';
    $('personalValuation').value = state.currency === 'USD' ? '0.5' : '0.035';
    state.userHasCustomValuation = false;
    state.inputMode = 'checkout-total';
    calculate();
  });

  $('exampleMarriott').addEventListener('click', () => {
    state.programId = 'marriott';
    $('programPreset').value = 'marriott';
    updateProgramPolicyCard('marriott');
    $('nights').value = '5';
    $('totalCashPrice').value = state.currency === 'USD' ? '1250' : '8750';
    $('totalPointsRequired').value = '140000';
    $('awardCashFees').value = '0';
    $('personalValuation').value = state.currency === 'USD' ? '0.7' : '0.049';
    state.userHasCustomValuation = false;
    state.inputMode = 'checkout-total';
    calculate();
  });

  $('exampleHyatt').addEventListener('click', () => {
    state.programId = 'hyatt';
    $('programPreset').value = 'hyatt';
    updateProgramPolicyCard('hyatt');
    $('nights').value = '2';
    $('totalCashPrice').value = state.currency === 'USD' ? '850' : '5950';
    $('totalPointsRequired').value = '42000';
    $('awardCashFees').value = '0';
    $('personalValuation').value = state.currency === 'USD' ? '1.7' : '0.119';
    state.userHasCustomValuation = false;
    state.inputMode = 'checkout-total';
    calculate();
  });

  $('btnShare').addEventListener('click', () => {
    const shareParams = new URLSearchParams();
    shareParams.set('currency', state.currency);
    shareParams.set('prog', state.programId);
    shareParams.set('mode', state.inputMode);
    shareParams.set('nights', $('nights').value);
    shareParams.set('cash', $('totalCashPrice').value);
    shareParams.set('points', $('totalPointsRequired').value);
    if ($('awardCashFees').value !== '0') shareParams.set('fees', $('awardCashFees').value);
    if ($('personalValuation').value) shareParams.set('val', $('personalValuation').value);

    const shareUrl = window.location.origin + window.location.pathname + '?' + shareParams.toString();
    history.replaceState(null, '', shareUrl);

    if (navigator.clipboard) {
      navigator.clipboard.writeText(shareUrl).then(() => {
        const toast = $('toast');
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 2500);
      });
    }
  });

  function loadUrlParams() {
    const pProg = params.get('prog') || params.get('preset');
    if (pProg && programsData[pProg]) {
      state.programId = pProg;
      $('programPreset').value = pProg;
    }
    const pNights = params.get('nights');
    if (pNights) $('nights').value = pNights;
    const pCash = params.get('cash') || params.get('cashTotal');
    if (pCash) $('totalCashPrice').value = pCash;
    const pPoints = params.get('points') || params.get('pts') || params.get('pointsTotal');
    if (pPoints) $('totalPointsRequired').value = pPoints;
    const pFees = params.get('fees') || params.get('awardCash');
    if (pFees) $('awardCashFees').value = pFees;
    const pVal = params.get('val') || params.get('valuation');
    if (pVal) {
      $('personalValuation').value = pVal;
      state.userHasCustomValuation = true;
    }
  }

  updateCurrencyLabels();
  loadUrlParams();
  updateProgramPolicyCard(state.programId);
  calculate();
</script>
