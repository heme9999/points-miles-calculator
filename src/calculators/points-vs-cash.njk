<script>
  const $ = id => document.getElementById(id);
  
  const params = new URLSearchParams(window.location.search);
  let currentCurrency = 'CNY';
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) {
        currentCurrency = saved;
      }
    } catch(e) {}
  }
  
  const updateUnits = () => {
    if (currentCurrency === 'USD') {
      if($('hintCash')) $('hintCash').textContent = '美元';
      if($('hintTaxes')) $('hintTaxes').textContent = '美元';
      if($('hintForgone')) $('hintForgone').textContent = '美元 (选填)';
      if($('hintValuation')) $('hintValuation').textContent = '美分/点 (选填)';
    } else {
      if($('hintCash')) $('hintCash').textContent = '元';
      if($('hintTaxes')) $('hintTaxes').textContent = '元';
      if($('hintForgone')) $('hintForgone').textContent = '元 (选填)';
      if($('hintValuation')) $('hintValuation').textContent = '元/点 (选填)';
    }
  };

  if ($('currency')) {
    $('currency').value = currentCurrency;
    $('currency').addEventListener('change', (e) => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      if (oldCurrency !== currentCurrency) {
        $('cashPrice').value = '';
        $('awardTaxes').value = '';
        $('forgoneValue').value = '';
        $('personalValuation').value = '';
        
        const warningMsg = currentCurrency === 'USD' 
          ? '货币已切换。为避免人民币和美元金额混淆，请重新填写金额与个人估值。' 
          : '货币已切换。为避免人民币和美元金额混淆，请重新填写金额与个人估值。';
          
        function clearCalculatorResults() {
          $('cppResult').textContent = '-';
          $('costCompare').innerHTML = '积分成本: -<br>现金成本: -';
          $('verdictText').textContent = '—';
          $('verdictCode').textContent = '-';
          $('verdictText').className = 'v';
          $('cppResult').classList.remove('win');
          $('explain').innerHTML = `<span style="color:#eab308; font-weight:bold;">${warningMsg}</span>`;
        }
        clearCalculatorResults();
      }
      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateUnits();
      if ($('cashPrice').value) {
        calcAdv();
      }
    });
  }

  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      if (key === 'points' && val === 0) return;
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('cash', 'cashPrice');
  parseParam('points', 'pointsNeeded');
  parseParam('taxes', 'awardTaxes');
  parseParam('forgone', 'forgoneValue');
  parseParam('bonus', 'transferBonus', 1000);
  parseParam('valuation', 'personalValuation', 1000);

  function calcAdv(){
    let C = parseFloat($('cashPrice').value) || 0;
    let P = parseFloat($('pointsNeeded').value) || 0;
    let T = parseFloat($('awardTaxes').value) || 0;
    let F = parseFloat($('forgoneValue').value) || 0;
    let V = parseFloat($('personalValuation').value) || 0;
    let B = parseFloat($('transferBonus').value) || 0;

    const resetState = (msg = '请输入里程票所需积分数量。') => {
      $('cppResult').textContent = '-';
      $('costCompare').innerHTML = '积分成本: -<br>现金成本: -';
      $('verdictText').textContent = '—';
      $('verdictCode').textContent = 'DIFF —';
      $('explain').textContent = msg;
      
      $('verdictText').className = 'verdict';
      $('cppResult').classList.remove('win');
      $('cppResult').parentElement.classList.remove('win');
    };

    if (P <= 0 || C < 0 || T < 0 || F < 0 || V < 0 || B < 0) {
      resetState(P <= 0 ? '请输入里程票所需积分数量。' : '输入不能为负数。');
      return;
    }

    if (T >= C && C > 0) {
      resetState('税费已经等于或超过了直接买票的现金价格，不建议使用积分兑换！');
      $('verdictText').textContent = '不建议兑换';
      $('verdictText').className = 'verdict bad';
      $('verdictCode').textContent = 'DIFF < 0';
      return;
    }

    const actualPointsUsed = P / (1 + (B / 100));
    const netCashSaved = C - T - F;
    
    let displayCpp = '';
    let actualCpp = netCashSaved / actualPointsUsed;
    
    if (currentCurrency === 'USD') {
      displayCpp = (actualCpp * 100).toFixed(2) + ' 美分/点';
      actualCpp = actualCpp * 100;
    } else {
      displayCpp = '¥' + actualCpp.toFixed(4) + ' / 点';
    }
    
    $('cppResult').textContent = displayCpp;

    let costIfPoints = 0;
    if (currentCurrency === 'USD') {
      costIfPoints = (actualPointsUsed * (V / 100)) + T;
    } else {
      costIfPoints = (actualPointsUsed * V) + T;
    }
    const costIfCash = C - F;

    if (currentCurrency === 'USD') {
      $('costCompare').innerHTML = `积分等价: $${costIfPoints.toLocaleString('en-US', {maximumFractionDigits:0})}<br>现金净成本: $${costIfCash.toLocaleString('en-US', {maximumFractionDigits:0})}`;
    } else {
      $('costCompare').innerHTML = `积分等价: ¥${costIfPoints.toLocaleString('zh-CN', {maximumFractionDigits:0})}<br>现金净成本: ¥${costIfCash.toLocaleString('zh-CN', {maximumFractionDigits:0})}`;
    }

    const verdict = $('verdictText');
    const code = $('verdictCode');
    const explain = $('explain');

    $('cppResult').classList.remove('win');
    $('cppResult').parentElement.classList.remove('win');
    verdict.className = 'verdict';

    if (actualCpp <= 0) {
      verdict.textContent = '不建议兑换';
      verdict.className = 'verdict bad';
      explain.textContent = '税费和损失的回血已经超过了直接买票的现金价格，使用积分并不划算。';
      code.textContent = 'DIFF < 0';
    } else if (actualCpp > V && V > 0) {
      verdict.textContent = '推荐用积分';
      verdict.className = 'verdict good';
      $('cppResult').classList.add('win');
      
      const diffPercent = ((actualCpp - V) / V) * 100;
      code.textContent = 'DIFF +' + diffPercent.toFixed(0) + '%';
      
      if (currentCurrency === 'USD') {
        explain.textContent = `实际用出 ${actualCpp.toFixed(2)} 美分/点的价值，高出个人期望 (${V} 美分/点)，兑换收益突出。`;
      } else {
        explain.textContent = `实际用出 ¥${actualCpp.toFixed(4)}/点的价值，高出个人估值 (¥${V}/点)，非常划算。`;
      }
    } else if (actualCpp < V && V > 0) {
      verdict.textContent = '建议付现金';
      verdict.className = 'verdict bad';
      
      const diffPercent = ((V - actualCpp) / V) * 100;
      code.textContent = 'DIFF -' + diffPercent.toFixed(0) + '%';
      
      if (currentCurrency === 'USD') {
        explain.textContent = `实际仅用出 ${actualCpp.toFixed(2)} 美分/点，低于期望估值 (${V} 美分/点)，建议保留积分直接买票。`;
      } else {
        explain.textContent = `实际仅用出 ¥${actualCpp.toFixed(4)}/点，低于个人估值 (¥${V}/点)，建议直接花钱买票并积累新里程。`;
      }
    } else {
      verdict.textContent = '两者皆可';
      verdict.className = 'verdict ok';
      code.textContent = 'DIFF ~0%';
      explain.textContent = '实际兑出价值与个人期望基本持平，可根据手头流动现金与出行计划灵活决定。';
    }
  }

  ['cashPrice','pointsNeeded','awardTaxes','forgoneValue','personalValuation','transferBonus'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcAdv);
  });
  
  updateUnits();
  calcAdv();

  // Share functionality
  $('btnShare').addEventListener('click', () => {
    const p = new URLSearchParams();
    p.set('cash', $('cashPrice').value);
    p.set('points', $('pointsNeeded').value);
    p.set('taxes', $('awardTaxes').value);
    p.set('forgone', $('forgoneValue').value);
    p.set('bonus', $('transferBonus').value);
    p.set('valuation', $('personalValuation').value);
    p.set('currency', currentCurrency);
    
    const shareUrl = `${window.location.origin}${window.location.pathname}?${p.toString()}`;
    navigator.clipboard.writeText(shareUrl).then(() => {
      const toast = $('toast');
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 2500);
    });
  });
</script>
