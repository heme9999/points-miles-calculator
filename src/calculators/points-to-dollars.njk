  <h2>为什么要计算“积分折现价值”？</h2>
  <p>计算“积分折现价值”（Points to Dollars）主要有两个实际意义：</p>
  <ul>
    <li><strong>清算个人资产</strong>：了解自己手头的“非现金资产”总盘子有多大。很多时候，我们持有的航空里程和酒店积分加起来，代表了一定规模的旅行消费力。</li>
    <li><strong>衡量持卡成本</strong>：许多高端信用卡每年会收取年费。通过折算积分价值，可以更理性地评估持卡收益是否符合预期。</li>
  </ul>

  <h3>更多常旅客决策计算器</h3>
  <p>针对具体的换票和出行场景，建议搭配使用以下核心工具：</p>
  <ul>
    <li><a href="/calculators/cents-per-point/">单点价值 (CPP) 计算器</a>：精准计算单次机票或酒店兑换扣除税费后的每点实际价值。</li>
    <li><a href="/calculators/points-vs-cash/">积分与现金决策计算器</a>：综合税费与放弃累积的刷卡返利，对比直接买票还是里程换票。</li>
    <li><a href="/calculators/transfer-bonus/">信用卡转点加赠计算器</a>：计算银行加赠活动期间凑齐目标航司里程所需转出的最低积分。</li>
  </ul>

  <h2>积分/里程管理的三大实用原则</h2>
  <ol>
    <li><strong>计划性积累</strong><br>
    长期持有积分可能因计划贬值而降低购买力。围绕明确的出行或兑换目标使用积分，有助于锁住真实价值。</li>
    <li><strong>灵活性优于单一锁定</strong><br>
    像 <a href="/values/chase-ultimate-rewards/">Chase UR</a> 或 <a href="/values/amex-membership-rewards/">Amex MR</a> 这样可以转给多家不同航空公司的“灵活银行积分”，其适应力远高于被锁定在单一航司的里程。在没有明确出行计划前，建议将积分留在银行端，避免提前转入航司。</li>
    <li><strong>了解保级与过期规则</strong><br>
    各计划过期规则不同。请务必以各家航司最新官方规则为准，避免积分失效。</li>
  </ol>

  <h3>常见问题 (FAQ)</h3>
  <div class="faq">
    <details>
      <summary>如果我的积分即将过期怎么办？</summary>
      <div>
        <p>很多计划（如万豪、英国航空）只要账户有任何余额变动（如赚取或消费积分）即可顺延所有积分的有效期。最简单的办法是通过相关信用卡消费一笔，或者通过购物返利网站（Shopping Portal）赚取少量积分来激活账户。</p>
      </div>
    </details>
    
    <details>
      <summary>我可以把积分卖给别人换成现金吗？</summary>
      <div>
        <p>许多常旅客计划限制或禁止未经授权的积分出售或交换，请以具体计划条款为准。违规交易可能导致账户被封禁、积分清零或机票取消。你可以合法地为亲友兑换机票，但应遵守各计划的使用规范。</p>
      </div>
    </details>

    <details>
      <summary>这个计算器可以直接提现吗？</summary>
      <div>
        <p>本计算器仅提供资产估算功能，不能进行任何实际的金融交易。我们只是帮你弄清楚“你的积分大概值多少钱”。</p>
      </div>
    </details>
  </div>
</div>

<script>
  const $ = id => document.getElementById(id);
  
  const params = new URLSearchParams(window.location.search);
  let currentCurrency = 'CNY';
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) {
        currentCurrency = saved;
      }
    } catch(e) {}
  }
  
  const updateUnits = () => {
    if (currentCurrency === 'USD') {
      if($('hintValuation')) $('hintValuation').textContent = '美分/点';
    } else {
      if($('hintValuation')) $('hintValuation').textContent = '元/点';
    }
  };

  if ($('currency')) {
    $('currency').value = currentCurrency;
    $('currency').addEventListener('change', (e) => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      if (oldCurrency !== currentCurrency) {
        $('cppValue').value = '';
        
        const warningMsg = currentCurrency === 'USD' 
          ? '货币已切换。为避免人民币和美元金额混淆，请重新填写个人估值。' 
          : '货币已切换。为避免人民币和美元金额混淆，请重新填写个人估值。';
          
        function clearCalculatorResults() {
          $('dollarValue').textContent = '-';
          $('dollarValue').classList.remove('win');
          $('explain').innerHTML = `<span style="color:#eab308; font-weight:bold;">${warningMsg}</span>`;
        }
        clearCalculatorResults();
      }
      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateUnits();
      if ($('cppValue').value) {
        calcDollars();
      }
    });
  }

  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      if (key === 'points' && val === 0) return;
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('points', 'totalPoints');
  parseParam('totalPoints', 'totalPoints');
  parseParam('valuation', 'cppValue', 1000);
  parseParam('cppValue', 'cppValue', 1000);

  function calcDollars(){
    let P = parseFloat($('totalPoints').value) || 0;
    let V = parseFloat($('cppValue').value) || 0;
    
    const resetState = (msg = '请输入有效的数值。') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (P <= 0 || V <= 0 || !$('cppValue').value) {
      resetState(P < 0 || V < 0 ? '输入不能为负数。' : '请输入积分余额和估值。');
      return;
    }
    
    // If USD, V is in Cents, we divide by 100 to get dollar amount
    let total = 0;
    if (currentCurrency === 'USD') {
      total = P * (V / 100);
      $('dollarValue').textContent = '$' + total.toLocaleString('en-US', {maximumFractionDigits:2});
      $('explain').textContent = `按 ${V} 美分/点的估值计算，你账户里的 ${P.toLocaleString('zh-CN', {maximumFractionDigits:0})} 积分相当于 $${total.toLocaleString('en-US', {maximumFractionDigits:2})} 的购买力。如果一直闲置不用，这笔无形资产将面临缩水风险。`;
    } else {
      total = P * V;
      $('dollarValue').textContent = '¥' + total.toLocaleString('zh-CN', {maximumFractionDigits:0});
      $('explain').textContent = `按 ${V} 元/点的估值计算，你账户里的 ${P.toLocaleString('zh-CN', {maximumFractionDigits:0})} 积分相当于 ${total.toLocaleString('zh-CN', {maximumFractionDigits:0})} 元的购买力。如果一直闲置不用，这笔无形资产将面临缩水风险。`;
    }
    $('dollarValue').classList.add('win');
  }

  $('presetValuation').addEventListener('change', e => {
    if(e.target.value !== 'custom'){
      $('cppValue').value = e.target.value;
      calcDollars();
    }
  });
  ['totalPoints','cppValue'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcDollars);
  });
  
  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/calculators/points-to-dollars/');
      const p = parseFloat($('totalPoints').value) || 0;
      const v = parseFloat($('cppValue').value) || 0;
      if (p > 0) url.searchParams.set('points', p);
      if (v > 0) url.searchParams.set('valuation', v);
      if (currentCurrency) url.searchParams.set('currency', currentCurrency);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
      });
    });
  }

  updateUnits();
  if($('cppValue').value) calcDollars();
</script>
