  <h3>常见问题 (FAQ)</h3>
  <div class="faq">
    <details>
      <summary>如果我的积分即将过期怎么办？</summary>
      <div>
        <p>很多计划（如万豪、英国航空）只要账户有任何余额变动（如赚取或消费积分）即可顺延所有积分的有效期。最简单的办法是通过相关信用卡消费一笔，或者通过购物返利网站（Shopping Portal）赚取少量积分来激活账户。</p>
      </div>
    </details>
    
    <details>
      <summary>我可以把积分卖给别人换成现金吗？</summary>
      <div>
        <p>许多常旅客计划限制或禁止未经授权的积分出售或交换，请以具体计划条款为准。违规交易可能导致账户被封禁、积分清零或机票取消。你可以合法地为亲友兑换机票，但应遵守各计划的使用规范。</p>
      </div>
    </details>

    <details>
      <summary>这个计算器可以直接提现吗？</summary>
      <div>
        <p>本计算器仅提供资产估算功能，不能进行任何实际的金融交易。我们只是帮你弄清楚“你的积分大概值多少钱”。</p>
      </div>
    </details>
  </div>
</div>

<script>
  const $ = id => document.getElementById(id);
  
  // Accessible help drawer toggle
  const btnHelp = $('btnHelpScenario');
  const guideBox = $('helpScenarioGuide');
  if (btnHelp && guideBox) {
    btnHelp.addEventListener('click', () => {
      const isExpanded = btnHelp.getAttribute('aria-expanded') === 'true';
      btnHelp.setAttribute('aria-expanded', !isExpanded);
      guideBox.style.display = isExpanded ? 'none' : 'block';
    });
  }

  const params = new URLSearchParams(window.location.search);
  let currentCurrency = 'CNY';
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) {
        currentCurrency = saved;
      }
    } catch(e) {}
  }

  // FX Rate setup
  let defaultFx = 7.0;
  const rawFx = parseFloat(params.get('fx'));
  if (!isNaN(rawFx) && isFinite(rawFx) && rawFx >= 0.1 && rawFx <= 20) {
    defaultFx = rawFx;
  }
  if ($('fxRate')) $('fxRate').value = defaultFx;

  const getActiveFx = () => {
    if (!$('fxRate')) return 7.0;
    const v = parseFloat($('fxRate').value);
    if (!isNaN(v) && isFinite(v) && v >= 0.1 && v <= 20) {
      return v;
    }
    return 7.0;
  };

  const getScenarioUsdCpp = (scenarioKey) => {
    switch(scenarioKey) {
      case '0.6': return 0.6;
      case '1.2': return 1.2;
      case '1.5': return 1.5;
      case '2.0': return 2.0;
      default: return null;
    }
  };

  const updateSelectOptions = () => {
    const fx = getActiveFx();
    const select = $('presetValuation');
    if (!select) return;

    const currentSelected = select.value;

    if (currentCurrency === 'USD') {
      select.options[0].text = 'Custom value per mile';
      select.options[1].text = 'Low-value miles scenario: 0.6¢ per mile';
      select.options[2].text = 'Conservative scenario: 1.2¢ per mile';
      select.options[3].text = 'Typical airline-mile scenario: 1.5¢ per mile';
      select.options[4].text = 'Higher-value redemption scenario: 2.0¢ per mile';
      
      select.options[1].value = '0.6';
      select.options[2].value = '1.2';
      select.options[3].value = '1.5';
      select.options[4].value = '2.0';
    } else {
      const cny06 = (0.6 / 100 * fx).toFixed(3).replace(/\.?0+$/, '');
      const cny12 = (1.2 / 100 * fx).toFixed(3).replace(/\.?0+$/, '');
      const cny15 = (1.5 / 100 * fx).toFixed(3).replace(/\.?0+$/, '');
      const cny20 = (2.0 / 100 * fx).toFixed(3).replace(/\.?0+$/, '');

      select.options[0].text = '自定义每里估值';
      select.options[1].text = `低面值里程情景：0.6美分/里 (约${cny06}元/里)`;
      select.options[2].text = `保守估值情景：1.2美分/里 (约${cny12}元/里)`;
      select.options[3].text = `中性航空里程情景：1.5美分/里 (约${cny15}元/里)`;
      select.options[4].text = `较高价值兑换情景：2.0美分/里 (约${cny20}元/里)`;

      select.options[1].value = '0.6';
      select.options[2].value = '1.2';
      select.options[3].value = '1.5';
      select.options[4].value = '2.0';
    }

    if (currentSelected) {
      select.value = currentSelected;
    }
  };

  const updateUnitsAndVisibility = () => {
    const fx = getActiveFx();
    if (currentCurrency === 'USD') {
      if($('hintValuation')) $('hintValuation').textContent = '¢ / 里';
      if($('fieldFx')) $('fieldFx').style.display = 'none';
      if($('spanFxEcho')) $('spanFxEcho').textContent = fx.toString();
      if($('spanCnyCppEcho')) $('spanCnyCppEcho').textContent = (1.5 / 100 * fx).toFixed(3);
      if($('spanEgCny')) $('spanEgCny').textContent = '¥' + (50000 * (1.5 / 100 * fx)).toLocaleString('zh-CN', {maximumFractionDigits:0});
    } else {
      if($('hintValuation')) $('hintValuation').textContent = '元/里';
      if($('fieldFx')) $('fieldFx').style.display = 'block';
      if($('spanFxEcho')) $('spanFxEcho').textContent = fx.toString();
      const cnyRate = (1.5 / 100 * fx).toFixed(3).replace(/\.?0+$/, '');
      if($('spanCnyCppEcho')) $('spanCnyCppEcho').textContent = cnyRate;
      if($('spanEgCny')) $('spanEgCny').textContent = '¥' + (50000 * (1.5 / 100 * fx)).toLocaleString('zh-CN', {maximumFractionDigits:0});
    }
    updateSelectOptions();
  };

  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      if (key === 'points' && val === 0) return;
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('points', 'totalPoints');
  parseParam('totalPoints', 'totalPoints');

  // Scenario parse
  const scenParam = params.get('presetValuation') || params.get('scenario');
  if (scenParam && ['custom', '0.6', '1.2', '1.5', '2.0'].includes(scenParam)) {
    if ($('presetValuation')) $('presetValuation').value = scenParam;
  }

  // Parse valuation parameter
  const rawVal = parseFloat(params.get('valuation') || params.get('cppValue'));
  if (!isNaN(rawVal) && isFinite(rawVal) && rawVal > 0) {
    if ($('cppValue')) $('cppValue').value = rawVal;
  } else {
    // Set default value according to currency
    const activeScen = $('presetValuation') ? $('presetValuation').value : '1.5';
    const fx = getActiveFx();
    if (activeScen !== 'custom') {
      const usdCpp = getScenarioUsdCpp(activeScen) || 1.5;
      if (currentCurrency === 'USD') {
        if ($('cppValue')) $('cppValue').value = usdCpp;
      } else {
        if ($('cppValue')) $('cppValue').value = parseFloat((usdCpp / 100 * fx).toFixed(4));
      }
    }
  }

  if ($('currency')) {
    $('currency').value = currentCurrency;
    $('currency').addEventListener('change', (e) => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      const fx = getActiveFx();
      const select = $('presetValuation');
      const curScen = select ? select.value : 'custom';

      if (curScen !== 'custom') {
        const usdCpp = getScenarioUsdCpp(curScen);
        if (currentCurrency === 'USD') {
          $('cppValue').value = usdCpp;
        } else {
          $('cppValue').value = parseFloat((usdCpp / 100 * fx).toFixed(4));
        }
      } else {
        // Converting custom input accurately without drift
        const oldVal = parseFloat($('cppValue').value) || 0;
        if (oldVal > 0) {
          if (currentCurrency === 'USD' && oldCurrency === 'CNY') {
            $('cppValue').value = parseFloat((oldVal / fx * 100).toFixed(2));
          } else if (currentCurrency === 'CNY' && oldCurrency === 'USD') {
            $('cppValue').value = parseFloat((oldVal / 100 * fx).toFixed(4));
          }
        }
      }

      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateUnitsAndVisibility();
      calcDollars();
    });
  }

  if ($('fxRate')) {
    $('fxRate').addEventListener('input', () => {
      updateUnitsAndVisibility();
      const select = $('presetValuation');
      const curScen = select ? select.value : 'custom';
      const fx = getActiveFx();
      if (curScen !== 'custom' && currentCurrency === 'CNY') {
        const usdCpp = getScenarioUsdCpp(curScen);
        $('cppValue').value = parseFloat((usdCpp / 100 * fx).toFixed(4));
      }
      calcDollars();
    });
  }

  function updatePresetButtonsAria(currentPoints) {
    const targetStr = String(currentPoints);
    document.querySelectorAll('.btn-balance-preset').forEach(btn => {
      const isMatch = btn.getAttribute('data-points') === targetStr;
      btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
    });
  }

  function calcDollars(){
    let P = parseFloat($('totalPoints').value) || 0;
    let V = parseFloat($('cppValue').value) || 0;
    
    const resetState = (msg = '请输入有效的数值。') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (P <= 0 || V <= 0 || !$('cppValue').value) {
      resetState(P < 0 || V < 0 ? '输入不能为负数。' : '请输入里程余额和估值。');
      return;
    }
    
    let total = 0;
    if (currentCurrency === 'USD') {
      total = P * (V / 100);
      $('dollarValue').textContent = '$' + total.toLocaleString('en-US', {maximumFractionDigits:2});
      $('explain').textContent = `航空里程余额：${P.toLocaleString('zh-CN', {maximumFractionDigits:0})} 里 | 估值：${V}美分/里（演示假设）| 预估折合旅行价值：$${total.toLocaleString('en-US', {maximumFractionDigits:2})}。该数值为测算购买力演示，非官方保底提现金额。`;
    } else {
      total = P * V;
      $('dollarValue').textContent = '¥' + total.toLocaleString('zh-CN', {maximumFractionDigits:0});
      $('explain').textContent = `航空里程余额：${P.toLocaleString('zh-CN', {maximumFractionDigits:0})} 里 | 估值：${V}元/里（演示假设）| 预估折合旅行价值：¥${total.toLocaleString('zh-CN', {maximumFractionDigits:0})}。该数值为测算购买力演示，非官方保底提现金额。`;
    }
    $('dollarValue').classList.add('win');
  }

  // Preset balance buttons
  document.querySelectorAll('.btn-balance-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const pts = btn.getAttribute('data-points');
      $('totalPoints').value = pts;
      updatePresetButtonsAria(pts);
      calcDollars();
    });
  });

  $('presetValuation').addEventListener('change', e => {
    const scen = e.target.value;
    const fx = getActiveFx();
    if(scen !== 'custom'){
      const usdCpp = getScenarioUsdCpp(scen);
      if (currentCurrency === 'USD') {
        $('cppValue').value = usdCpp;
      } else {
        $('cppValue').value = parseFloat((usdCpp / 100 * fx).toFixed(4));
      }
      calcDollars();
    }
  });

  $('cppValue').addEventListener('input', () => {
    const val = parseFloat($('cppValue').value) || 0;
    const fx = getActiveFx();
    let matched = 'custom';
    ['0.6', '1.2', '1.5', '2.0'].forEach(s => {
      const usdCpp = getScenarioUsdCpp(s);
      const targetVal = currentCurrency === 'USD' ? usdCpp : parseFloat((usdCpp / 100 * fx).toFixed(4));
      if (Math.abs(val - targetVal) < 0.0001) {
        matched = s;
      }
    });
    $('presetValuation').value = matched;
    calcDollars();
  });

  $('totalPoints').addEventListener('input', () => {
    updatePresetButtonsAria($('totalPoints').value);
    calcDollars();
  });

  updatePresetButtonsAria($('totalPoints').value);
  
  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/calculators/points-to-dollars/');
      const p = parseFloat($('totalPoints').value) || 0;
      const v = parseFloat($('cppValue').value) || 0;
      const scen = $('presetValuation').value;
      const fx = getActiveFx();

      if (p > 0) url.searchParams.set('points', p);
      if (v > 0) url.searchParams.set('valuation', v);
      if (scen && scen !== 'custom') url.searchParams.set('scenario', scen);
      if (currentCurrency) url.searchParams.set('currency', currentCurrency);
      if (currentCurrency === 'CNY' && fx !== 7.0) url.searchParams.set('fx', fx);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        if (toast) {
          toast.style.display = 'block';
          setTimeout(() => { toast.style.display = 'none'; }, 2000);
        }
      });
    });
  }

  updateUnitsAndVisibility();
  if($('cppValue').value) calcDollars();
</script>
