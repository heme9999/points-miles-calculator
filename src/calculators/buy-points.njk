        <div class="k">买分实际成本 (Cost per Point)</div>
        <div class="v" id="cppResult" style="word-break: break-word; overflow-wrap: anywhere;">-</div>
      </div>
      <div class="item">
        <div class="k">总计</div>
        <div class="v" id="totalsResult" style="font-size:16px; margin-top:10px; word-break: break-word; overflow-wrap: anywhere; line-height: 1.5;">获得积分: -<br>总现金支出: -</div>
      </div>
