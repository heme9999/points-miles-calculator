    </div>
    <div class="field">
      <label for="purchasePrice">基础购买价格<span class="hint" id="hintPrice">货币单位</span></label>
      <input type="number" id="purchasePrice" min="0" step="1" inputmode="decimal" placeholder="例如: 500">
    </div>
  </div>
  
  <div class="row">
