      <label for="bonusPercentage">购买奖励比例<span class="hint">% (选填)</span></label>
      <input type="number" id="bonusPercentage" value="0" min="0" step="1" inputmode="numeric">
      <div class="unit">如遇到 100% 加赠，填 100</div>
    </div>
    <div class="field">
      <label for="fixedBonusPoints">固定额外赠送积分<span class="hint">点 (选填)</span></label>
      <input type="number" id="fixedBonusPoints" value="0" min="0" step="1" inputmode="numeric">
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="purchaseTaxes">买分税费<span class="hint" id="hintTaxes">货币单位 (选填)</span></label>
      <input type="number" id="purchaseTaxes" value="0" min="0" step="1" inputmode="decimal">
    </div>
    <div class="field">
      <label for="fxFees">外币/手续费<span class="hint" id="hintFxFees">货币单位 (选填)</span></label>
      <input type="number" id="fxFees" value="0" min="0" step="1" inputmode="decimal">
    </div>
  </div>
</div>

<div class="panel">
  <h3>目标兑换与估值 (选填，用于决策建议)</h3>
  
  <div class="row">
    <div class="field">
      <label for="targetPoints">目标兑换所需积分<span class="hint">点</span></label>
      <input type="number" id="targetPoints" min="0" step="1" inputmode="numeric" placeholder="例如: 60000">
    </div>
    <div class="field">
      <label for="targetCash">目标兑换的现金价<span class="hint" id="hintTargetCash">货币单位</span></label>
      <input type="number" id="targetCash" min="0" step="1" inputmode="decimal">
    </div>
  </div>
  <div class="row">
    <div class="field">
      <label for="targetAwardTaxes">兑换奖励房/票的税费<span class="hint" id="hintTargetAwardTaxes">货币单位</span></label>
      <input type="number" id="targetAwardTaxes" value="0" min="0" step="1" inputmode="decimal">
    </div>
    <div class="field">
      <label for="personalValuation">你的积分个人估值<span class="hint" id="hintValuation">价值/点</span></label>
      <input type="number" id="personalValuation" value="0" min="0" step="0.0001" inputmode="decimal">
    </div>
