<script src="/assets/calculator-core.js"></script>
<script>
  (function() {
    const $ = id => document.getElementById(id);
    const core = window.CalculatorCore;

    if (!core) {
      console.error('CalculatorCore failed to load.');
      const errBox = document.createElement('div');
      errBox.className = 'error-box';
      errBox.textContent = '计算引擎加载失败，请刷新页面重试。';
      document.querySelector('.panel').prepend(errBox);
      return;
    }

    const STORAGE_KEY = 'tripBudgetState.v2.zh';
    const LEGACY_KEY = 'savedTripBudget';

    function showToast(msg) {
      const t = $('toast');
      if (!t) return;
      t.textContent = msg;
      t.style.display = 'block';
      setTimeout(() => { t.style.display = 'none'; }, 3000);
    }

    function collectTripState() {
      return {
        origin: $('origin') ? $('origin').value.trim() : '',
        destination: $('destination') ? $('destination').value.trim() : '',
        tripDays: $('tripDays') ? $('tripDays').value : 7,
        adults: $('adults') ? $('adults').value : 2,
        children: $('children') ? $('children').value : 0,
        currency: $('currency') ? $('currency').value : 'CNY',
        fxRate: $('fxRate') ? $('fxRate').value : 7.0,
        travelStyle: $('travelStyle') ? $('travelStyle').value : 'balanced',
        expenses: {
          flights: $('expFlights') ? $('expFlights').value : 0,
          hotel: $('expHotel') ? $('expHotel').value : 0,
          dining: $('expDining') ? $('expDining').value : 0,
          transit: $('expTransit') ? $('expTransit').value : 0,
          carRental: $('expCarRental') ? $('expCarRental').value : 0,
          parkingTolls: $('expParkingTolls') ? $('expParkingTolls').value : 0,
          activities: $('expActivities') ? $('expActivities').value : 0,
          visaInsurance: $('expVisaInsurance') ? $('expVisaInsurance').value : 0,
          connectivity: $('expConnectivity') ? $('expConnectivity').value : 0,
          other: $('expOther') ? $('expOther').value : 0
        },
        flightRedemption: {
          enabled: $('enableFlightPoints') ? $('enableFlightPoints').checked : true,
          programName: $('flightProgramName') ? $('flightProgramName').value.trim() : '',
          awardMilesRequired: $('flightMilesNeeded') ? $('flightMilesNeeded').value : 0,
          awardTaxes: $('flightAwardTaxes') ? $('flightAwardTaxes').value : 0,
          awardCashCopay: $('flightAwardCopay') ? $('flightAwardCopay').value : 0,
          airlineMilesBalance: $('flightMilesBalance') && $('flightMilesBalance').value !== '' ? $('flightMilesBalance').value : null,
          baseTransferRatio: $('flightBaseTransferRatio') ? $('flightBaseTransferRatio').value : 1.0,
          transferBonusPercent: $('flightTransferBonus') ? $('flightTransferBonus').value : 0,
          transferIncrement: $('flightTransferIncrement') ? $('flightTransferIncrement').value : 1000,
          transferablePointsBalance: $('flightTransferableBalance') && $('flightTransferableBalance').value !== '' ? $('flightTransferableBalance').value : null
        },
        hotelRedemption: {
          enabled: $('enableHotelPoints') ? $('enableHotelPoints').checked : true,
          programName: $('hotelProgramName') ? $('hotelProgramName').value.trim() : '',
          pointsNeeded: $('hotelPointsNeeded') ? $('hotelPointsNeeded').value : 0,
          awardTaxes: $('hotelAwardTaxes') ? $('hotelAwardTaxes').value : 0,
          resortFees: $('hotelResortFees') ? $('hotelResortFees').value : 0,
          hotelCashCopay: $('hotelCashCopay') ? $('hotelCashCopay').value : 0,
          pointsBalance: $('hotelPointsBalance') && $('hotelPointsBalance').value !== '' ? $('hotelPointsBalance').value : null
        }
      };
    }

    function restoreTripState(raw) {
      const s = core.normalizeTripState(raw);
      if ($('origin')) $('origin').value = s.origin;
      if ($('destination')) $('destination').value = s.destination;
      if ($('tripDays')) $('tripDays').value = s.tripDays;
      if ($('adults')) $('adults').value = s.adults;
      if ($('children')) $('children').value = s.children;
      if ($('currency')) $('currency').value = s.currency;
      if ($('fxRate')) $('fxRate').value = s.fxRate;
      if ($('travelStyle')) $('travelStyle').value = s.travelStyle;

      if ($('expFlights')) $('expFlights').value = s.expenses.flights;
      if ($('expHotel')) $('expHotel').value = s.expenses.hotel;
      if ($('expDining')) $('expDining').value = s.expenses.dining;
      if ($('expTransit')) $('expTransit').value = s.expenses.transit;
      if ($('expCarRental')) $('expCarRental').value = s.expenses.carRental;
      if ($('expParkingTolls')) $('expParkingTolls').value = s.expenses.parkingTolls;
      if ($('expActivities')) $('expActivities').value = s.expenses.activities;
      if ($('expVisaInsurance')) $('expVisaInsurance').value = s.expenses.visaInsurance;
      if ($('expConnectivity')) $('expConnectivity').value = s.expenses.connectivity;
      if ($('expOther')) $('expOther').value = s.expenses.other;

      if ($('enableFlightPoints')) {
        $('enableFlightPoints').checked = s.flightRedemption.enabled;
        if ($('flightPointsFields')) {
          $('flightPointsFields').style.opacity = s.flightRedemption.enabled ? '1' : '0.5';
        }
      }
      if ($('flightProgramName')) $('flightProgramName').value = s.flightRedemption.programName;
      if ($('flightMilesNeeded')) $('flightMilesNeeded').value = s.flightRedemption.awardMilesRequired;
      if ($('flightAwardTaxes')) $('flightAwardTaxes').value = s.flightRedemption.awardTaxes;
      if ($('flightAwardCopay')) $('flightAwardCopay').value = s.flightRedemption.awardCashCopay;
      if ($('flightMilesBalance')) $('flightMilesBalance').value = s.flightRedemption.airlineMilesBalance !== null ? s.flightRedemption.airlineMilesBalance : '';
      if ($('flightBaseTransferRatio')) $('flightBaseTransferRatio').value = s.flightRedemption.baseTransferRatio;
      if ($('flightTransferBonus')) $('flightTransferBonus').value = s.flightRedemption.transferBonusPercent;
      if ($('flightTransferIncrement')) $('flightTransferIncrement').value = s.flightRedemption.transferIncrement;
      if ($('flightTransferableBalance')) $('flightTransferableBalance').value = s.flightRedemption.transferablePointsBalance !== null ? s.flightRedemption.transferablePointsBalance : '';

      if ($('enableHotelPoints')) {
        $('enableHotelPoints').checked = s.hotelRedemption.enabled;
        if ($('hotelPointsFields')) {
          $('hotelPointsFields').style.opacity = s.hotelRedemption.enabled ? '1' : '0.5';
        }
      }
      if ($('hotelProgramName')) $('hotelProgramName').value = s.hotelRedemption.programName;
      if ($('hotelPointsNeeded')) $('hotelPointsNeeded').value = s.hotelRedemption.pointsNeeded;
      if ($('hotelAwardTaxes')) $('hotelAwardTaxes').value = s.hotelRedemption.awardTaxes;
      if ($('hotelResortFees')) $('hotelResortFees').value = s.hotelRedemption.resortFees;
      if ($('hotelCashCopay')) $('hotelCashCopay').value = s.hotelCashCopay;
      if ($('hotelPointsBalance')) $('hotelPointsBalance').value = s.hotelRedemption.pointsBalance !== null ? s.hotelRedemption.pointsBalance : '';

      updateCurrencyLabels(s.currency);
    }

    function updateCurrencyLabels(curr) {
      const sym = curr === 'USD' ? '$' : '¥';
      const hints = [
        'hintExpFlights','hintExpHotel','hintExpDining','hintExpTransit',
        'hintExpCarRental','hintExpParkingTolls','hintExpActivities',
        'hintExpVisaInsurance','hintExpConnectivity','hintExpOther',
        'hintFlightTaxes','hintFlightCopay','hintHotelTaxes','hintHotelResort','hintHotelCopay'
      ];
      hints.forEach(hId => {
        const el = $(hId);
        if (!el) return;
        if (hId.includes('Exp')) el.textContent = `${sym} 全体总额`;
        else if (hId.includes('Copay')) el.textContent = `${sym} 选填`;
        else el.textContent = `${sym} 自付现金`;
      });
      if ($('fieldFx')) {
        $('fieldFx').style.display = curr === 'CNY' ? 'block' : 'none';
      }
    }

    function renderCalculator() {
      const rawState = collectTripState();
      const state = core.normalizeTripState(rawState);
      const res = core.calculateTripCostAfterPoints(state);
      const curr = state.currency;

      // Update Card Prices
      $('cardOriginalPrice').textContent = core.formatCurrency(res.cashTripCost, curr, 'zh');
      $('cardFinalPrice').textContent = core.formatCurrency(res.finalOutOfPocket, curr, 'zh');
      
      const badge = $('badgeTotalSavings');
      if (res.totalSavings > 0) {
        badge.textContent = `省 ${core.formatCurrency(res.totalSavings, curr, 'zh')}`;
        badge.className = 'badge-status badge-success';
      } else {
        badge.textContent = '无节省';
        badge.className = 'badge-status badge-neutral';
      }

      $('valCoverageRate').textContent = `${res.pointsCoverageRate.toFixed(1)}%`;
      $('valPerPersonCash').textContent = core.formatCurrency(res.perPersonCashFinal, curr, 'zh');
      $('unitPerPerson').textContent = `按 ${res.totalTravelers} 位旅客平摊（原全现金 ${core.formatCurrency(res.perPersonCashOriginal, curr, 'zh')}/人）`;

      $('valDailyCash').textContent = core.formatCurrency(res.dailyCashFinal, curr, 'zh');
      $('unitDaily').textContent = `按 ${res.tripDays} 天行程平摊（原全现金 ${core.formatCurrency(res.dailyCashOriginal, curr, 'zh')}/天）`;

      // Flight Summary Box
      const flightBox = $('flightRedemptionSummary');
      if (res.flight.enabled) {
        $('valFlightCpp').textContent = `${res.flight.cpp.toFixed(2)} ¢/点`;
        $('valFlightLocal').textContent = curr === 'CNY' 
          ? `折合 ¥${res.flight.localPerPoint.toFixed(4)} / 里`
          : `折合 $${res.flight.localPerPoint.toFixed(4)} / 里`;
        
        let transHtml = '';
        if (res.flight.transferDetails && res.flight.transferDetails.bankPointsNeeded > 0) {
          const td = res.flight.transferDetails;
          transHtml = `<br>💳 <strong>转点测算：</strong>需从信用卡转出 <strong>${td.bankPointsNeeded.toLocaleString()}</strong> 积分` +
            (td.bankPointsSaved > 0 ? ` (加赠节省 <strong>${td.bankPointsSaved.toLocaleString()}</strong> 积分)` : '') +
            ` ➔ 获得 <strong>${td.milesReceived.toLocaleString()}</strong> 里程` +
            ` · 信用卡每点有效价值: <strong>${res.flight.effectiveBankCpp.toFixed(2)} ¢/点</strong>`;
          if (td.bankBalanceSufficient === false) {
            transHtml += ` · <span style="color:#f87171;">⚠️ 信用卡积分余额不足</span>`;
          } else if (td.bankBalanceSufficient === true) {
            transHtml += ` · <span style="color:#4ade80;">✓ 信用卡积分充足</span>`;
          }
        }

        let airlineBalHtml = '';
        if (res.flight.transferDetails && res.flight.transferDetails.airlineBalanceSufficient === false) {
          airlineBalHtml = ` · <span style="color:#f87171;">⚠️ 航司里程余额不足</span>`;
        } else if (res.flight.transferDetails && res.flight.transferDetails.airlineBalanceSufficient === true) {
          airlineBalHtml = ` · <span style="color:#4ade80;">✓ 航司里程充足</span>`;
        }

        flightBox.innerHTML = `✈️ <strong>机票抵扣详情：</strong> 原现金机票 <strong>${core.formatCurrency(res.flight.cashPrice, curr, 'zh')}</strong> ➔ 用 <strong>${res.flight.milesNeeded.toLocaleString()}</strong> 里程抵扣，自付税杂费 <strong>${core.formatCurrency(res.flight.outOfPocket, curr, 'zh')}</strong>，净省 <strong>${core.formatCurrency(res.flight.netSavings, curr, 'zh')}</strong> (兑出 <strong>${res.flight.cpp.toFixed(2)} ¢/点</strong>)${airlineBalHtml}${transHtml}`;
      } else {
        $('valFlightCpp').textContent = '—';
        $('valFlightLocal').textContent = '未启用里程抵扣';
        flightBox.innerHTML = '✈️ 机票里程抵扣未启用或机票现金价为 0。';
      }

      // Hotel Summary Box
      const hotelBox = $('hotelRedemptionSummary');
      if (res.hotel.enabled) {
        $('valHotelCpp').textContent = `${res.hotel.cpp.toFixed(2)} ¢/点`;
        $('valHotelLocal').textContent = curr === 'CNY' 
          ? `折合 ¥${res.hotel.localPerPoint.toFixed(4)} / 点`
          : `折合 $${res.hotel.localPerPoint.toFixed(4)} / 点`;
        
        let hotelBalHtml = '';
        if (res.hotel.hotelBalanceSufficient === false) {
          hotelBalHtml = ` · <span style="color:#f87171;">⚠️ 酒店积分余额不足</span>`;
        } else if (res.hotel.hotelBalanceSufficient === true) {
          hotelBalHtml = ` · <span style="color:#4ade80;">✓ 酒店积分充足</span>`;
        }

        hotelBox.innerHTML = `🏨 <strong>酒店抵扣详情：</strong> 原现金房费 <strong>${core.formatCurrency(res.hotel.cashPrice, curr, 'zh')}</strong> ➔ 用 <strong>${res.hotel.pointsNeeded.toLocaleString()}</strong> 积分抵扣，自付杂费 <strong>${core.formatCurrency(res.hotel.outOfPocket, curr, 'zh')}</strong>，净省 <strong>${core.formatCurrency(res.hotel.netSavings, curr, 'zh')}</strong> (兑出 <strong>${res.hotel.cpp.toFixed(2)} ¢/点</strong>)${hotelBalHtml}`;
      } else {
        $('valHotelCpp').textContent = '—';
        $('valHotelLocal').textContent = '未启用积分抵扣';
        hotelBox.innerHTML = '🏨 酒店积分抵扣未启用或酒店现金价为 0。';
      }

      // Waterfall Table
      const wb = $('waterfallBody');
      const b = res.breakdown;
      const rows = [
        { name: '✈️ 往返机票', cash: b.flights, deduction: res.flight.enabled ? -b.flights : 0, taxes: res.flight.enabled ? res.flight.outOfPocket : 0, final: res.flight.enabled ? res.flight.outOfPocket : b.flights },
        { name: '🏨 酒店住宿', cash: b.hotel, deduction: res.hotel.enabled ? -b.hotel : 0, taxes: res.hotel.enabled ? res.hotel.outOfPocket : 0, final: res.hotel.enabled ? res.hotel.outOfPocket : b.hotel },
        { name: '🍜 餐饮美食', cash: b.dining, deduction: 0, taxes: 0, final: b.dining },
        { name: '🚇 城市交通', cash: b.transit, deduction: 0, taxes: 0, final: b.transit },
        { name: '🚗 租车费用', cash: b.carRental, deduction: 0, taxes: 0, final: b.carRental },
        { name: '⛽ 油费与停车', cash: b.parkingTolls, deduction: 0, taxes: 0, final: b.parkingTolls },
        { name: '🎟️ 景点与活动', cash: b.activities, deduction: 0, taxes: 0, final: b.activities },
        { name: '📄 签证与保险', cash: b.visaInsurance, deduction: 0, taxes: 0, final: b.visaInsurance },
        { name: '📶 电话卡与eSIM', cash: b.connectivity, deduction: 0, taxes: 0, final: b.connectivity },
        { name: '🛍️ 其他杂费', cash: b.other, deduction: 0, taxes: 0, final: b.other }
      ];

      let html = '';
      rows.forEach(r => {
        if (r.cash === 0 && r.final === 0) return;
        html += `<tr>
          <td><strong>${r.name}</strong></td>
          <td>${core.formatCurrency(r.cash, curr, 'zh')}</td>
          <td style="color:${r.deduction < 0 ? '#4ade80' : 'var(--muted)'};">${r.deduction !== 0 ? core.formatCurrency(r.deduction, curr, 'zh') : '—'}</td>
          <td style="color:${r.taxes > 0 ? '#f87171' : 'var(--muted)'};">${r.taxes > 0 ? '+' + core.formatCurrency(r.taxes, curr, 'zh') : '—'}</td>
          <td><strong>${core.formatCurrency(r.final, curr, 'zh')}</strong></td>
        </tr>`;
      });
      html += `<tr style="font-weight:700; background:rgba(255,255,255,0.04); border-top: 2px solid var(--line);">
        <td>全行程总计</td>
        <td>${core.formatCurrency(res.cashTripCost, curr, 'zh')}</td>
        <td style="color:#4ade80;">-${core.formatCurrency(res.cashTripCost - res.finalOutOfPocket + (res.flight.enabled ? res.flight.outOfPocket : 0) + (res.hotel.enabled ? res.hotel.outOfPocket : 0), curr, 'zh')}</td>
        <td style="color:#f87171;">+${core.formatCurrency((res.flight.enabled ? res.flight.outOfPocket : 0) + (res.hotel.enabled ? res.hotel.outOfPocket : 0), curr, 'zh')}</td>
        <td style="color:var(--gold); font-size:16px;">${core.formatCurrency(res.finalOutOfPocket, curr, 'zh')}</td>
      </tr>`;
      wb.innerHTML = html;

      // Verdict Box
      const vBadge = $('verdictBadge');
      const vCode = $('verdictCode');
      const vBox = $('verdictBox');
      if (res.flight.isNegativeSavings || res.hotel.isNegativeSavings) {
        vBadge.textContent = '部分项目不建议用分';
        vBadge.className = 'verdict bad';
        vCode.textContent = 'AVOID DEFICIT';
        vBox.innerHTML = `<div class="verdict-label">最终决策</div><div class="verdict bad">不建议兑换亏损项</div><p style="font-size:12px; margin-top:8px; color:#f87171;">存在税费高于原现金价的负收益项目，建议改付现金。</p>`;
      } else if (res.totalSavings > 0) {
        vBadge.textContent = '推荐使用积分';
        vBadge.className = 'verdict good';
        vCode.textContent = `省 ${res.pointsCoverageRate.toFixed(0)}%`;
        vBox.innerHTML = `<div class="verdict-label">最终决策</div><div class="verdict good">推荐使用积分</div><p style="font-size:12px; margin-top:8px;">本次抵扣净省 <strong>${core.formatCurrency(res.totalSavings, curr, 'zh')}</strong>，覆盖 <strong>${res.pointsCoverageRate.toFixed(1)}%</strong> 预算。` +
          (res.flight.enabled && res.hotel.enabled ? `<br>机票 CPP (${res.flight.cpp.toFixed(2)}¢) ${res.flight.cpp >= res.hotel.cpp ? '≥' : '<'} 酒店 CPP (${res.hotel.cpp.toFixed(2)}¢)` : '') + `</p>`;
      } else {
        vBadge.textContent = '纯现金出行';
        vBadge.className = 'verdict';
        vCode.textContent = 'ALL CASH';
        vBox.innerHTML = `<div class="verdict-label">最终决策</div><div class="verdict">全现金方案</div><p style="font-size:12px; margin-top:8px;">当前未启用积分抵扣或无节省。</p>`;
      }
    }

    // Bind event listeners
    const allInputIds = [
      'origin','destination','tripDays','adults','children','travelStyle',
      'currency','fxRate',
      'expFlights','expHotel','expDining','expTransit','expCarRental','expParkingTolls',
      'expActivities','expVisaInsurance','expConnectivity','expOther',
      'flightMilesNeeded','flightAwardTaxes','flightAwardCopay','flightMilesBalance',
      'flightProgramName','flightBaseTransferRatio','flightTransferBonus','flightTransferIncrement','flightTransferableBalance',
      'hotelPointsNeeded','hotelAwardTaxes','hotelResortFees','hotelCashCopay','hotelPointsBalance','hotelProgramName'
    ];

    allInputIds.forEach(id => {
      const el = $(id);
      if (el) el.addEventListener('input', renderCalculator);
    });

    $('enableFlightPoints').addEventListener('change', (e) => {
      $('flightPointsFields').style.opacity = e.target.checked ? '1' : '0.5';
      renderCalculator();
    });

    $('enableHotelPoints').addEventListener('change', (e) => {
      $('hotelPointsFields').style.opacity = e.target.checked ? '1' : '0.5';
      renderCalculator();
    });

    $('currency').addEventListener('change', (e) => {
      updateCurrencyLabels(e.target.value);
      renderCalculator();
    });

    // Toolbar buttons
    $('btnReset').addEventListener('click', () => {
      try {
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(LEGACY_KEY);
      } catch(e) {}
      restoreTripState({
        tripDays: 7, adults: 2, children: 0, currency: 'CNY', fxRate: 7.0, travelStyle: 'balanced',
        expenses: { flights: 0, hotel: 0, dining: 0, transit: 0, carRental: 0, parkingTolls: 0, activities: 0, visaInsurance: 0, connectivity: 0, other: 0 },
        flightRedemption: { enabled: true, awardMilesRequired: 0, awardTaxes: 0, awardCashCopay: 0, baseTransferRatio: 1.0, transferBonusPercent: 0, transferIncrement: 1000 },
        hotelRedemption: { enabled: true, pointsNeeded: 0, awardTaxes: 0, resortFees: 0, hotelCashCopay: 0 }
      });
      renderCalculator();
      showToast('已重置表单并清除本地暂存');
    });

    $('btnPrint').addEventListener('click', () => {
      window.print();
    });

    $('btnSaveLocal').addEventListener('click', () => {
      const s = core.normalizeTripState(collectTripState());
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
        showToast('预算数据已成功暂存至本地浏览器');
      } catch(e) {
        showToast('暂存失败，请检查浏览器权限');
      }
    });

    $('btnCopySummary').addEventListener('click', () => {
      const s = core.normalizeTripState(collectTripState());
      const res = core.calculateTripCostAfterPoints(s);
      const curr = s.currency;
      const summary = `【里程账 - 旅行预算摘要】\n目的地: ${s.destination || '未指定'} (${s.tripDays}天 / ${s.adults}大${s.children}小)\n全现金总成本: ${core.formatCurrency(res.cashTripCost, curr, 'zh')}\n积分抵扣后实际自付: ${core.formatCurrency(res.finalOutOfPocket, curr, 'zh')}\n累计节省金额: ${core.formatCurrency(res.totalSavings, curr, 'zh')} (覆盖率 ${res.pointsCoverageRate.toFixed(1)}%)\n人均自付现金: ${core.formatCurrency(res.perPersonCashFinal, curr, 'zh')}\n日均自付现金: ${core.formatCurrency(res.dailyCashFinal, curr, 'zh')}\n计算生成自: ${window.location.href}`;
      navigator.clipboard.writeText(summary).then(() => {
        showToast('预算摘要已复制到剪贴板');
      }).catch(() => {
        showToast('复制失败，请手动复制');
      });
    });

    $('btnShare').addEventListener('click', () => {
      const s = core.normalizeTripState(collectTripState());
      const query = core.serializeTripState(s);
      const shareUrl = `${window.location.origin}${window.location.pathname}?${query}`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        showToast('分享链接已复制到剪贴板！');
      }).catch(() => {
        showToast('分享链接已生成');
      });
    });

    // Initialization logic: URL params > LocalStorage > Default
    function init() {
      if (window.location.search) {
        const urlState = core.parseTripParams(window.location.search);
        restoreTripState(urlState);
      } else {
        let loaded = false;
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            restoreTripState(JSON.parse(saved));
            loaded = true;
          } else {
            const legacy = localStorage.getItem(LEGACY_KEY);
            if (legacy) {
              const legData = JSON.parse(legacy);
              restoreTripState(legData);
              localStorage.setItem(STORAGE_KEY, JSON.stringify(core.normalizeTripState(legData)));
              loaded = true;
            }
          }
        } catch(e) {}

        if (!loaded) {
          updateCurrencyLabels('CNY');
        }
      }
      renderCalculator();
    }

    init();
  })();
</script>
