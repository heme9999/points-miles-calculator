<script>
  const $ = id => document.getElementById(id);
  const fmt = n => '$' + n.toLocaleString('en-US', {maximumFractionDigits: 0});

  function calc(){
    let points = parseFloat($('points').value) || 0;
    let cashRatio = parseFloat($('cashRatio').value) || 0;
    let milesRatio = parseFloat($('milesRatio').value) || 0;
    let mileValueCents = parseFloat($('mileValue').value) || 0;

    const resetState = (msg = 'Please enter valid numbers.') => {
      $('cashOut').textContent = '-';
      $('milesOut').textContent = '-';
      $('verdictText').textContent = '—';
      $('verdictCode').textContent = 'RATIO —';
      $('explain').textContent = msg;
      
      $('verdictText').className = 'verdict';
      $('cashOut').classList.remove('win');
      $('milesOut').classList.remove('win');
    };

    if (points <= 0 || cashRatio <= 0 || milesRatio <= 0 || mileValueCents <= 0) {
      resetState(points <= 0 ? 'Please enter a valid points amount.' : 'Ratios and valuation must be greater than zero.');
      return;
    }

    const cashValue = points / cashRatio;
    const miles = points / milesRatio;
    const milesValue = miles * (mileValueCents / 100);

    $('cashOut').textContent = fmt(cashValue);
    $('milesOut').textContent = fmt(milesValue);

    $('cashOut').classList.remove('win');
    $('milesOut').classList.remove('win');

    const ratio = cashValue > 0 ? (milesValue / cashValue) : 0;
    const verdict = $('verdictText');
    const code = $('verdictCode');
    const explain = $('explain');
    
    verdict.className = 'verdict';

    if(milesValue > cashValue * 1.05){
      verdict.textContent = 'Potentially Higher Modeled Value';
      verdict.className = 'verdict good';
      $('milesOut').classList.add('win');
      explain.textContent = 'Transferring may provide more estimated travel value under the selected assumptions. Confirm the live transfer ratio and award availability before moving points.';
    } else if(cashValue > milesValue * 1.05){
      verdict.textContent = 'Cashout Shows Higher Modeled Value';
      verdict.className = 'verdict bad';
      $('cashOut').classList.add('win');
      explain.textContent = 'Cashout provides more modeled value under the selected assumptions. Compare your real redemption options before deciding.';
    } else {
      verdict.textContent = 'Results Are Close';
      explain.textContent = 'Both options offer similar modeled value under the selected assumptions. Compare your actual travel plans before deciding.';
    }
    code.textContent = `RATIO ${ratio.toFixed(2)}×`;
  }

  $('programPreset').addEventListener('change', e => {
    if(e.target.value !== 'custom'){
      $('mileValue').value = e.target.value;
      calc();
    }
  });
  ['points','cashRatio','milesRatio','mileValue'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calc);
  });
  if($('points')) calc();
</script>
