      <label for="targetPoints">Target Required Points<span class="hint">pts</span></label>
      <input type="number" id="targetPoints" min="0" step="1" inputmode="numeric" placeholder="e.g. 60000">
    </div>
    <div class="field">
      <label for="targetCash">Target Cash Price<span class="hint" id="hintTargetCash">Currency</span></label>
      <input type="number" id="targetCash" min="0" step="1" inputmode="decimal">
    </div>
  </div>
  <div class="row">
