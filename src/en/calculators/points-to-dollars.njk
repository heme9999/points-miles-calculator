<script>
  const $ = id => document.getElementById(id);

  const PROGRAM_DATA = {
    custom: {
      name: 'Custom Airline / User-Defined Rate',
      type: 'User Custom',
      scope: 'Applicable scope: Enter any target airline miles and custom benchmark valuation.',
      sourceText: 'Editorial Valuation Benchmarks',
      sourceUrl: '/en/values/',
      verified: 'November 2026',
      defaultCpp: null
    },
    united: {
      name: 'United Airlines (MileagePlus)',
      type: 'Editorial Benchmark',
      scope: 'Applicable scope: United Airlines flights, Star Alliance partner awards (domestic US & international).',
      sourceText: 'United Miles Value Guide & MileagePlus Rules',
      sourceUrl: '/en/calculators/united-miles-value-calculator/',
      verified: 'November 2026',
      defaultCpp: 1.2
    },
    aeroplan: {
      name: 'Air Canada (Aeroplan)',
      type: 'Editorial Benchmark',
      scope: 'Applicable scope: Air Canada flights & Star Alliance/partner awards (no carrier fuel surcharges).',
      sourceText: 'Aeroplan Valuation Guide',
      sourceUrl: '/en/values/aeroplan-points/',
      verified: 'November 2026',
      defaultCpp: 1.5
    },
    asiamiles: {
      name: 'Cathay Pacific (Asia Miles)',
      type: 'Editorial Benchmark',
      scope: 'Applicable scope: Cathay Pacific & oneworld partner award flights (distance-based zone chart).',
      sourceText: 'Asia Miles Valuation Guide',
      sourceUrl: '/en/blog/yazhouwanlitong-licheng-jiazhi/',
      verified: 'November 2026',
      defaultCpp: 1.3
    },
    avios: {
      name: 'British Airways / Qatar (Avios)',
      type: 'Editorial Benchmark',
      scope: 'Applicable scope: British Airways, Qatar Airways, Iberia (distance-based short-haul & Qsuite awards).',
      sourceText: 'Avios Points Valuation Guide',
      sourceUrl: '/en/values/avios/',
      verified: 'November 2026',
      defaultCpp: 1.3
    }
  };

  function updateProgramMeta(progKey, isCustomValuation = false) {
    const data = PROGRAM_DATA[progKey] || PROGRAM_DATA.custom;
    const nameEl = $('metaProgramName');
    const typeEl = $('metaValuationType');
    const scopeEl = $('metaScope');
    const sourceLink = $('metaSourceLink');
    const verifiedEl = $('metaVerified');

    if (nameEl) {
      if (isCustomValuation && progKey !== 'custom') {
        nameEl.textContent = data.name + ' · Custom Input';
      } else {
        nameEl.textContent = data.name;
      }
    }
    if (scopeEl) scopeEl.textContent = data.scope;
    if (sourceLink) {
      sourceLink.textContent = data.sourceText;
      sourceLink.href = data.sourceUrl;
    }
    if (verifiedEl) verifiedEl.textContent = 'Verified: ' + data.verified;

    if (typeEl) {
      if (isCustomValuation || progKey === 'custom') {
        typeEl.textContent = 'User Custom';
        typeEl.style.background = '#fef3c7';
        typeEl.style.color = '#92400e';
      } else {
        typeEl.textContent = data.type;
        typeEl.style.background = '#e2e8f0';
        typeEl.style.color = '#475569';
      }
    }
  }

  function syncPresetDropdownAndMeta() {
    const curVal = parseFloat($('cppValue').value);
    const progKey = $('airlineProgram') ? $('airlineProgram').value : 'custom';
    const defaultProgCpp = PROGRAM_DATA[progKey]?.defaultCpp;

    let matched = 'custom';
    if (!isNaN(curVal)) {
      ['0.6', '1.2', '1.5', '2.0'].forEach(s => {
        if (Math.abs(curVal - parseFloat(s)) < 0.00001) {
          matched = s;
        }
      });
    }
    if ($('presetValuation')) {
      $('presetValuation').value = matched;
    }

    const isCustom = progKey === 'custom' || (defaultProgCpp !== null && Math.abs(curVal - defaultProgCpp) > 0.00001);
    updateProgramMeta(progKey, isCustom);
  }

  function updatePresetButtonsAria(currentPoints) {
    const targetStr = String(currentPoints);
    document.querySelectorAll('.btn-balance-preset').forEach(btn => {
      const isMatch = btn.getAttribute('data-points') === targetStr;
      btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
    });
  }

  // Help toggle accessible interaction
  const btnHelp = $('btnHelpScenario');
  const guideBox = $('helpScenarioGuide');
  if (btnHelp && guideBox) {
    btnHelp.addEventListener('click', () => {
      const isExpanded = btnHelp.getAttribute('aria-expanded') === 'true';
      btnHelp.setAttribute('aria-expanded', !isExpanded);
      guideBox.style.display = isExpanded ? 'none' : 'block';
    });
  }

  const urlParams = new URLSearchParams(window.location.search);

  // 1. Check URL for program
  const progParam = (urlParams.get('program') || urlParams.get('airlineProgram') || '').toLowerCase();
  if (progParam && PROGRAM_DATA[progParam] && $('airlineProgram')) {
    $('airlineProgram').value = progParam;
    if (PROGRAM_DATA[progParam].defaultCpp !== null) {
      $('cppValue').value = PROGRAM_DATA[progParam].defaultCpp;
    }
  }

  // 2. Parse balance params
  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(urlParams.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('totalPoints', 'totalPoints');
  parseParam('points', 'totalPoints');
  parseParam('miles', 'totalPoints');

  // 3. Parse scenario parameter
  const scenParam = urlParams.get('presetValuation') || urlParams.get('scenario');
  if (scenParam && $('presetValuation')) {
    const validOptions = ['custom', '0.6', '1.2', '1.5', '2.0'];
    if (validOptions.includes(scenParam)) {
      $('presetValuation').value = scenParam;
      if (scenParam !== 'custom') {
        $('cppValue').value = scenParam;
      }
    }
  }

  // 4. Parse explicit valuation param (Highest Priority - overrides program/scenario preset)
  let explicitCpp = parseFloat(urlParams.get('cpp') || urlParams.get('cppValue') || urlParams.get('valuation'));
  if (!isNaN(explicitCpp) && isFinite(explicitCpp) && explicitCpp > 0) {
    $('cppValue').value = explicitCpp;
  }

  function calcDollars(){
    let P = parseFloat($('totalPoints').value) || 0;
    let V = parseFloat($('cppValue').value) || 0;
    
    const resetState = (msg = 'Please enter valid numbers.') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (P <= 0 || V <= 0 || !$('cppValue').value) {
      resetState(P < 0 || V < 0 ? 'Inputs cannot be negative.' : 'Please enter your points balance and valuation.');
      return;
    }
    
    const total = P * (V / 100);
    
    $('dollarValue').textContent = '$' + total.toLocaleString('en-US', {maximumFractionDigits:0});
    $('dollarValue').classList.add('win');
    $('explain').textContent = `Balance: ${P.toLocaleString('en-US')} miles | Valuation: ${V}¢/mile (editable assumption) | Estimated travel value: $${total.toLocaleString('en-US', {maximumFractionDigits:0})}. This is an illustrative modeled travel value, not a guaranteed cashout amount or cash redemption rate.`;
  }

  // Airline Program change
  if ($('airlineProgram')) {
    $('airlineProgram').addEventListener('change', e => {
      const prog = e.target.value;
      if (prog !== 'custom' && PROGRAM_DATA[prog]?.defaultCpp !== null) {
        $('cppValue').value = PROGRAM_DATA[prog].defaultCpp;
      }
      syncPresetDropdownAndMeta();
      calcDollars();
    });
  }

  // Preset balance buttons
  document.querySelectorAll('.btn-balance-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const pts = btn.getAttribute('data-points');
      $('totalPoints').value = pts;
      updatePresetButtonsAria(pts);
      calcDollars();
    });
  });

  $('presetValuation').addEventListener('change', e => {
    if(e.target.value !== 'custom'){
      $('cppValue').value = e.target.value;
      syncPresetDropdownAndMeta();
      calcDollars();
    }
  });

  $('cppValue').addEventListener('input', () => {
    syncPresetDropdownAndMeta();
    calcDollars();
  });

  $('totalPoints').addEventListener('input', () => {
    updatePresetButtonsAria($('totalPoints').value);
    calcDollars();
  });

  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const shareUrl = new URL(window.location.href);
      shareUrl.searchParams.set('miles', $('totalPoints').value);
      shareUrl.searchParams.set('cpp', $('cppValue').value);
      if ($('airlineProgram') && $('airlineProgram').value !== 'custom') {
        shareUrl.searchParams.set('program', $('airlineProgram').value);
      } else {
        shareUrl.searchParams.delete('program');
      }
      if ($('presetValuation') && $('presetValuation').value !== 'custom') {
        shareUrl.searchParams.set('scenario', $('presetValuation').value);
      } else {
        shareUrl.searchParams.delete('scenario');
      }

      navigator.clipboard.writeText(shareUrl.toString()).then(() => {
        const toast = $('toast');
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
      }).catch(() => {});
    });
  }

  syncPresetDropdownAndMeta();
  updatePresetButtonsAria($('totalPoints').value);
  calcDollars();
</script>
