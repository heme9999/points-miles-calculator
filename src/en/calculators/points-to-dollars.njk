<script>
  const $ = id => document.getElementById(id);

  // Help toggle accessible interaction
  const btnHelp = $('btnHelpScenario');
  const guideBox = $('helpScenarioGuide');
  if (btnHelp && guideBox) {
    btnHelp.addEventListener('click', () => {
      const isExpanded = btnHelp.getAttribute('aria-expanded') === 'true';
      btnHelp.setAttribute('aria-expanded', !isExpanded);
      guideBox.style.display = isExpanded ? 'none' : 'block';
    });
  }

  const parseParam = (key, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('totalPoints', 'totalPoints');
  parseParam('points', 'totalPoints');
  parseParam('cppValue', 'cppValue');
  parseParam('valuation', 'cppValue');

  const parseScenarioParam = () => {
    const params = new URLSearchParams(window.location.search);
    const scen = params.get('presetValuation') || params.get('scenario');
    if (scen && $('presetValuation')) {
      const validOptions = ['custom', '0.6', '1.2', '1.5', '2.0'];
      if (validOptions.includes(scen)) {
        $('presetValuation').value = scen;
        if (scen !== 'custom') {
          $('cppValue').value = scen;
        }
      }
    }
  };
  parseScenarioParam();

  function calcDollars(){
    let P = parseFloat($('totalPoints').value) || 0;
    let V = parseFloat($('cppValue').value) || 0;
    
    const resetState = (msg = 'Please enter valid numbers.') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (P <= 0 || V <= 0 || !$('cppValue').value) {
      resetState(P < 0 || V < 0 ? 'Inputs cannot be negative.' : 'Please enter your points balance and valuation.');
      return;
    }
    
    const total = P * (V / 100);
    
    $('dollarValue').textContent = '$' + total.toLocaleString('en-US', {maximumFractionDigits:0});
    $('dollarValue').classList.add('win');
    $('explain').textContent = `At an illustrative valuation of ${V}¢ / point, your ${P.toLocaleString('en-US', {maximumFractionDigits:0})} points hold roughly $${total.toLocaleString('en-US', {maximumFractionDigits:0})} in modeled purchasing power. This is an illustrative scenario, not a guaranteed cashout.`;
  }

  $('presetValuation').addEventListener('change', e => {
    if(e.target.value !== 'custom'){
      $('cppValue').value = e.target.value;
      calcDollars();
    }
  });

  $('cppValue').addEventListener('input', () => {
    const val = $('cppValue').value;
    const matched = ['0.6', '1.2', '1.5', '2.0'].includes(val);
    if (!matched) {
      $('presetValuation').value = 'custom';
    } else {
      $('presetValuation').value = val;
    }
    calcDollars();
  });

  $('totalPoints').addEventListener('input', calcDollars);

  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/en/calculators/points-to-dollars/');
      const p = parseFloat($('totalPoints').value) || 0;
      const v = parseFloat($('cppValue').value) || 0;
      const scen = $('presetValuation').value;
      if (p > 0) url.searchParams.set('totalPoints', p);
      if (v > 0) url.searchParams.set('cppValue', v);
      if (scen && scen !== 'custom') url.searchParams.set('scenario', scen);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        if (toast) {
          toast.style.display = 'block';
          setTimeout(() => { toast.style.display = 'none'; }, 2000);
        }
      });
    });
  }

  calcDollars();
</script>
