  <h2>Why Calculate "Points to Dollars"?</h2>
  <p>Calculating the cash equivalent of your points offers two key benefits:</p>
  <ul>
    <li><strong>Asset Tracking</strong>: Understand the size of your rewards portfolio. For frequent travelers, airline miles and hotel points combined can represent thousands of dollars in travel purchasing power.</li>
    <li><strong>Evaluating Annual Fees</strong>: Premium travel cards carry annual fees. If the cash value of points earned doesn't exceed the card's cost, you may want to rethink your card strategy.</li>
  </ul>

  <h3>Related Calculators for Award Travel</h3>
  <p>If you're evaluating a specific flight or hotel redemption rather than your overall balance, use these dedicated tools:</p>
  <ul>
    <li><a href="/en/calculators/cents-per-point/">Cents Per Point (CPP) Calculator</a>: Calculate the exact CPP value of a specific flight or hotel ticket after taxes.</li>
    <li><a href="/en/calculators/points-vs-cash/">Points vs Cash Calculator</a>: Compare paying cash vs redeeming miles, factoring in taxes and forgone credit card rewards.</li>
    <li><a href="/en/calculators/transfer-bonus/">Transfer Bonus Calculator</a>: Calculate how many flexible bank points you need to transfer to hit a target mileage requirement during bonus promotions.</li>
  </ul>

  <h2>Three Rules of Points Management</h2>
  <ol>
    <li><strong>Earn and Burn</strong><br>
    Points only deliver value once redeemed. Loyalty programs adjust pricing dynamically and change award charts over time. Keeping points indefinitely guarantees loss of purchasing power.</li>
    <li><strong>Flexibility is King</strong><br>
    Transferable points like <a href="/en/values/chase-ultimate-rewards/">Chase UR</a> or <a href="/en/values/amex-membership-rewards/">Amex MR</a> are more valuable than points locked into a single airline. Keep points in your bank account until you have verified award availability.</li>
    <li><strong>Understand Expiration Policies</strong><br>
    Expiration rules vary. Some programs expire miles after 24–36 months of inactivity, while others allow extensions through qualifying card spending or shopping portal activity.</li>
  </ol>

  <h3>Frequently Asked Questions</h3>
  <div class="faq">
    <details>
      <summary>What should I do if my points are about to expire?</summary>
      <div>
        <p>For programs that extend expiration with activity, you can reset the clock with a small purchase on a co-branded card, transferring a small number of points, or earning miles through an online shopping portal.</p>
      </div>
    </details>
    
    <details>
      <summary>Can I sell my airline miles for cash?</summary>
      <div>
        <p>No. Airline and hotel loyalty program terms strictly prohibit the commercial sale or barter of points. Doing so can lead to account closure and forfeiture of rewards. You can, however, legally book award travel for friends or family.</p>
      </div>
    </details>

    <details>
      <summary>Does this calculator cash out my points?</summary>
      <div>
        <p>No. This calculator is strictly an informational tool to estimate purchasing power. We do not buy, sell, or process points redemptions.</p>
      </div>
    </details>
  </div>
</div>

<script>
  const $ = id => document.getElementById(id);

  const parseParam = (key, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('totalPoints', 'totalPoints');
  parseParam('points', 'totalPoints');
  parseParam('presetValuation', 'presetValuation');
  parseParam('cppValue', 'cppValue');
  parseParam('valuation', 'cppValue');

  function calcDollars(){
    let P = parseFloat($('totalPoints').value) || 0;
    let V = parseFloat($('cppValue').value) || 0;
    
    const resetState = (msg = 'Please enter valid numbers.') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (P <= 0 || V <= 0) {
      resetState(P < 0 || V < 0 ? 'Inputs cannot be negative.' : 'Please enter your points balance and valuation.');
      return;
    }
    
    const total = P * (V / 100);
    
    $('dollarValue').textContent = '$' + total.toLocaleString('en-US', {maximumFractionDigits:0});
    $('dollarValue').classList.add('win');
    $('explain').textContent = `At a valuation of ${V}¢ / point, your ${P.toLocaleString('en-US', {maximumFractionDigits:0})} points hold roughly $${total.toLocaleString('en-US', {maximumFractionDigits:0})} in purchasing power. If left unused, this asset is at risk of future program devaluation.`;
  }

  $('presetValuation').addEventListener('change', e => {
    if(e.target.value !== 'custom'){
      $('cppValue').value = e.target.value;
      calcDollars();
    }
  });
  ['totalPoints','cppValue'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcDollars);
  });

  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/en/calculators/points-to-dollars/');
      const p = parseFloat($('totalPoints').value) || 0;
      const v = parseFloat($('cppValue').value) || 0;
      if (p > 0) url.searchParams.set('totalPoints', p);
      if (v > 0) url.searchParams.set('cppValue', v);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
      });
    });
  }

  calcDollars();
</script>
