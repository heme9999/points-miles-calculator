<script>
  const $ = id => document.getElementById(id);

  function calcAdv(){
    let C = parseFloat($('cashPrice').value) || 0;
    let P = parseFloat($('pointsNeeded').value) || 0;
    let T = parseFloat($('awardTaxes').value) || 0;
    let F = parseFloat($('forgoneValue').value) || 0;
    let V = parseFloat($('personalValuation').value) || 0;
    let B = parseFloat($('transferBonus').value) || 0;

    const resetState = (msg = 'Please enter the required points.') => {
      $('cppResult').textContent = '-';
      $('costCompare').innerHTML = 'Points Cost: -<br>Cash Cost: -';
      $('verdictText').textContent = '—';
      $('verdictCode').textContent = 'DIFF —';
      $('explain').textContent = msg;
      
      $('verdictText').className = 'verdict';
      $('cppResult').classList.remove('win');
      $('cppResult').parentElement.classList.remove('win');
    };

    if (P <= 0 || C < 0 || T < 0 || F < 0 || V < 0 || B < 0) {
      resetState(P <= 0 ? 'Please enter the required points.' : 'Inputs cannot be negative.');
      return;
    }

    if (T >= C && C > 0) {
      resetState('Taxes are equal to or higher than the cash price. Avoid this redemption!');
      $('verdictText').textContent = 'Avoid';
      $('verdictText').className = 'verdict bad';
      $('verdictCode').textContent = 'DIFF < 0';
      return;
    }

    const actualPointsUsed = P / (1 + (B / 100));
    const netCashSaved = C - T - F;
    const actualCpp = (netCashSaved / actualPointsUsed) * 100; // in cents
    
    $('cppResult').textContent = actualCpp.toFixed(2) + '¢ / point';

    const costIfPoints = (actualPointsUsed * (V / 100)) + T;
    const costIfCash = C - F;

    $('costCompare').innerHTML = `Points Equiv: $${costIfPoints.toLocaleString('en-US', {maximumFractionDigits:0})}<br>Net Cash: $${costIfCash.toLocaleString('en-US', {maximumFractionDigits:0})}`;

    const verdict = $('verdictText');
    const code = $('verdictCode');
    const explain = $('explain');

    $('cppResult').classList.remove('win');
    $('cppResult').parentElement.classList.remove('win');
    verdict.className = 'verdict';

    if (actualCpp <= 0) {
      verdict.textContent = 'Avoid';
      verdict.className = 'verdict bad';
      explain.textContent = 'Taxes and forgone points wipe out the cash price. Save your points!';
      code.textContent = 'DIFF < 0';
    } else if (actualCpp > V && V > 0) {
      verdict.textContent = 'Use Points';
      verdict.className = 'verdict good';
      $('cppResult').classList.add('win');
      const diff = ((actualCpp - V) / V * 100).toFixed(0);
      explain.textContent = `This redemption offers ${diff}% more value than your personal valuation. It's a solid use of points.`;
      code.textContent = `DIFF +${diff}%`;
    } else if (actualCpp < V && V > 0) {
      verdict.textContent = 'Pay Cash';
      verdict.className = 'verdict bad';
      const diff = ((V - actualCpp) / V * 100).toFixed(0);
      explain.textContent = `The actual value falls ${diff}% short of your personal valuation. You are better off paying cash and saving the points.`;
      code.textContent = `DIFF -${diff}%`;
    } else {
      verdict.textContent = 'Either Option';
      verdict.className = 'verdict';
      explain.textContent = V === 0 ? 'You did not enter a personal valuation. Decide based on the CPP above.' : 'The redemption value closely matches your expectations. Either option is reasonable.';
      code.textContent = 'DIFF ~0%';
    }
  }

  ['cashPrice','pointsNeeded','awardTaxes','forgoneValue','personalValuation','transferBonus'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcAdv);
  });
  if($('cashPrice')) calcAdv();
</script>
