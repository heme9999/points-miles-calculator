<script src="/assets/calculator-core.js"></script>
<script>
  const $ = id => document.getElementById(id);
  const core = window.CalculatorCore || (function() {
    const DEFAULT_FX_RATE = 7.0;
    function toNum(val, fallback = 0) { const n = parseFloat(val); return !isNaN(n) && isFinite(n) && n >= 0 ? n : fallback; }
    function formatCurrency(amount, currency = 'USD', lang = 'en') {
      const val = toNum(amount);
      if (currency === 'CNY') return '¥' + val.toLocaleString('zh-CN', { maximumFractionDigits: 0 });
      return '$' + val.toLocaleString('en-US', { maximumFractionDigits: 0 });
    }
    function calculateCPP(netSavingsLocal, pointsUsed, currency = 'USD', fxRate = DEFAULT_FX_RATE) {
      const net = parseFloat(netSavingsLocal) || 0;
      const pts = parseFloat(pointsUsed) || 0;
      if (pts <= 0) return 0;
      let netUsd = currency === 'CNY' ? (fxRate > 0 ? net / fxRate : 0) : net;
      return (netUsd / pts) * 100;
    }
    function calculateLocalPerPoint(netSavingsLocal, pointsUsed) {
      const net = parseFloat(netSavingsLocal) || 0;
      const pts = parseFloat(pointsUsed) || 0;
      return pts > 0 ? net / pts : 0;
    }
    function calculateTripCostAfterPoints(params) {
      const data = params || {};
      const currency = data.currency === 'USD' ? 'USD' : 'CNY';
      const fxRate = toNum(data.fxRate, DEFAULT_FX_RATE);
      const tripDays = Math.max(1, parseInt(data.tripDays, 10) || 1);
      const adults = Math.max(1, parseInt(data.adults, 10) || 1);
      const children = Math.max(0, parseInt(data.children, 10) || 0);
      const totalTravelers = adults + children;
      const expenses = data.expenses || {};
      const flightsCash = toNum(expenses.flights);
      const hotelCash = toNum(expenses.hotel);
      const diningCash = toNum(expenses.dining);
      const transitCash = toNum(expenses.transit);
      const carRentalCash = toNum(expenses.carRental);
      const parkingTollsCash = toNum(expenses.parkingTolls);
      const activitiesCash = toNum(expenses.activities);
      const visaInsuranceCash = toNum(expenses.visaInsurance);
      const connectivityCash = toNum(expenses.connectivity);
      const otherCash = toNum(expenses.other);
      const cashTripCost = flightsCash + hotelCash + diningCash + transitCash + carRentalCash + parkingTollsCash + activitiesCash + visaInsuranceCash + connectivityCash + otherCash;
      
      const flightRedemption = data.flightRedemption || {};
      const isFlightPointsActive = Boolean(flightRedemption.enabled && flightsCash > 0 && flightRedemption.milesNeeded > 0);
      let flightRes = { enabled: false, netSavings: 0, outOfPocket: 0, isNegativeSavings: false, cpp: 0, localPerPoint: 0, cashPrice: flightsCash };
      if (isFlightPointsActive) {
        const outOfPocket = toNum(flightRedemption.awardTaxes) + toNum(flightRedemption.awardCashCopay);
        const netSavings = flightsCash - outOfPocket;
        const miles = toNum(flightRedemption.milesNeeded);
        flightRes = { enabled: true, cashPrice: flightsCash, milesNeeded: miles, outOfPocket, netSavings, isNegativeSavings: netSavings < 0, cpp: calculateCPP(netSavings, miles, currency, fxRate), localPerPoint: calculateLocalPerPoint(netSavings, miles) };
      }

      const hotelRedemption = data.hotelRedemption || {};
      const isHotelPointsActive = Boolean(hotelRedemption.enabled && hotelCash > 0 && hotelRedemption.pointsNeeded > 0);
      let hotelRes = { enabled: false, netSavings: 0, outOfPocket: 0, isNegativeSavings: false, cpp: 0, localPerPoint: 0, cashPrice: hotelCash };
      if (isHotelPointsActive) {
        const outOfPocket = toNum(hotelRedemption.awardTaxes) + toNum(hotelRedemption.resortFees) + toNum(hotelRedemption.hotelCashCopay);
        const netSavings = hotelCash - outOfPocket;
        const points = toNum(hotelRedemption.pointsNeeded);
        hotelRes = { enabled: true, cashPrice: hotelCash, pointsNeeded: points, outOfPocket, netSavings, isNegativeSavings: netSavings < 0, cpp: calculateCPP(netSavings, points, currency, fxRate), localPerPoint: calculateLocalPerPoint(netSavings, points) };
      }

      let finalOutOfPocket = cashTripCost;
      if (flightRes.enabled) finalOutOfPocket = finalOutOfPocket - flightsCash + flightRes.outOfPocket;
      if (hotelRes.enabled) finalOutOfPocket = finalOutOfPocket - hotelCash + hotelRes.outOfPocket;
      finalOutOfPocket = Math.max(0, finalOutOfPocket);
      const totalSavings = Math.max(0, cashTripCost - finalOutOfPocket);
      const pointsCoverageRate = cashTripCost > 0 ? (totalSavings / cashTripCost) * 100 : 0;
      
      const flightBalance = flightRedemption.milesBalance !== undefined && flightRedemption.milesBalance !== '' ? toNum(flightRedemption.milesBalance) : null;
      const hotelBalance = hotelRedemption.pointsBalance !== undefined && hotelRedemption.pointsBalance !== '' ? toNum(hotelRedemption.pointsBalance) : null;

      return {
        currency, fxRate, tripDays, adults, children, totalTravelers, cashTripCost, finalOutOfPocket, totalSavings, pointsCoverageRate,
        perPersonCashOriginal: totalTravelers > 0 ? cashTripCost / totalTravelers : 0,
        perPersonCashFinal: totalTravelers > 0 ? finalOutOfPocket / totalTravelers : 0,
        dailyCashOriginal: tripDays > 0 ? cashTripCost / tripDays : 0,
        dailyCashFinal: tripDays > 0 ? finalOutOfPocket / tripDays : 0,
        flight: flightRes, hotel: hotelRes,
        flightBalanceSufficient: flightBalance !== null ? flightBalance >= flightRedemption.milesNeeded : null,
        hotelBalanceSufficient: hotelBalance !== null ? hotelBalance >= hotelRedemption.pointsNeeded : null,
        breakdown: { flightsCash, hotelCash, diningCash, transitCash, carRentalCash, parkingTollsCash, activitiesCash, visaInsuranceCash, connectivityCash, otherCash }
      };
    }
    return { formatCurrency, calculateTripCostAfterPoints, calculateCPP, calculateLocalPerPoint };
  })();

  let currentCurrency = 'USD';
  let currentFx = 7.0;

  const validCurrencies = ['USD', 'CNY'];
  const params = new URLSearchParams(window.location.search);

  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) currentCurrency = saved;
    } catch(e) {}
  }
  if ($('currency')) $('currency').value = currentCurrency;

  function showToast(msg) {
    const t = $('toast');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 3000);
  }

  function getTripInputData() {
    return {
      currency: currentCurrency,
      fxRate: currentFx,
      tripDays: parseFloat($('tripDays').value) || 1,
      adults: parseFloat($('adults').value) || 1,
      children: parseFloat($('children').value) || 0,
      expenses: {
        flights: parseFloat($('expFlights').value) || 0,
        hotel: parseFloat($('expHotel').value) || 0,
        dining: parseFloat($('expDining').value) || 0,
        transit: parseFloat($('expTransit').value) || 0,
        carRental: parseFloat($('expCarRental').value) || 0,
        parkingTolls: parseFloat($('expParkingTolls').value) || 0,
        activities: parseFloat($('expActivities').value) || 0,
        visaInsurance: parseFloat($('expVisaInsurance').value) || 0,
        connectivity: parseFloat($('expConnectivity').value) || 0,
        other: parseFloat($('expOther').value) || 0
      },
      flightRedemption: {
        enabled: $('enableFlightPoints').checked,
        milesNeeded: parseFloat($('flightMilesNeeded').value) || 0,
        awardTaxes: parseFloat($('flightAwardTaxes').value) || 0,
        awardCashCopay: parseFloat($('flightAwardCopay').value) || 0,
        milesBalance: $('flightMilesBalance').value !== '' ? parseFloat($('flightMilesBalance').value) : undefined
      },
      hotelRedemption: {
        enabled: $('enableHotelPoints').checked,
        pointsNeeded: parseFloat($('hotelPointsNeeded').value) || 0,
        awardTaxes: parseFloat($('hotelAwardTaxes').value) || 0,
        resortFees: parseFloat($('hotelResortFees').value) || 0,
        hotelCashCopay: parseFloat($('hotelCashCopay').value) || 0,
        pointsBalance: $('hotelPointsBalance').value !== '' ? parseFloat($('hotelPointsBalance').value) : undefined
      }
    };
  }

  function updateCurrencyLabels() {
    const sym = currentCurrency === 'USD' ? '$' : '¥';
    ['hintExpFlights','hintExpHotel','hintExpDining','hintExpTransit','hintExpCarRental',
     'hintExpParkingTolls','hintExpActivities','hintExpVisaInsurance','hintExpConnectivity',
     'hintExpOther'].forEach(id => {
      const el = $(id);
      if (el) el.textContent = `${sym} Total for all travelers`;
    });
    if ($('hintFlightTaxes')) $('hintFlightTaxes').textContent = `${sym} Out of pocket`;
    if ($('hintFlightCopay')) $('hintFlightCopay').textContent = `${sym} Optional`;
    if ($('hintHotelTaxes')) $('hintHotelTaxes').textContent = `${sym} Out of pocket`;
    if ($('hintHotelResort')) $('hintHotelResort').textContent = `${sym} Out of pocket`;
    if ($('hintHotelCopay')) $('hintHotelCopay').textContent = `${sym} Optional`;
  }

  function renderCalculator() {
    const data = getTripInputData();
    const res = core.calculateTripCostAfterPoints(data);

    $('cashTripTotalBadge').textContent = `All-Cash Total: ${core.formatCurrency(res.cashTripCost, currentCurrency, 'en')}`;
    $('cardCashPrice').textContent = core.formatCurrency(res.cashTripCost, currentCurrency, 'en');
    $('cardFinalPrice').textContent = core.formatCurrency(res.finalOutOfPocket, currentCurrency, 'en');
    $('badgeTotalSavings').textContent = core.formatCurrency(res.totalSavings, currentCurrency, 'en');
    $('badgeCoveragePct').textContent = `${res.pointsCoverageRate.toFixed(1)}%`;

    $('metricCashPerPerson').textContent = core.formatCurrency(res.perPersonCashOriginal, currentCurrency, 'en');
    $('metricCashDaily').textContent = core.formatCurrency(res.dailyCashOriginal, currentCurrency, 'en');
    $('metricFinalPerPerson').textContent = core.formatCurrency(res.perPersonCashFinal, currentCurrency, 'en');
    $('metricFinalDaily').textContent = core.formatCurrency(res.dailyCashFinal, currentCurrency, 'en');

    const fPct = res.cashTripCost > 0 ? ((res.breakdown.flightsCash / res.cashTripCost) * 100).toFixed(1) : '0.0';
    const hPct = res.cashTripCost > 0 ? ((res.breakdown.hotelCash / res.cashTripCost) * 100).toFixed(1) : '0.0';
    $('metricCashFlightPct').textContent = `${fPct}%`;
    $('metricCashHotelPct').textContent = `${hPct}%`;

    $('metricFlightCpp').textContent = res.flight.enabled 
      ? `${res.flight.cpp.toFixed(2)} ¢/point`
      : 'Not Applied';
    $('metricHotelCpp').textContent = res.hotel.enabled 
      ? `${res.hotel.cpp.toFixed(2)} ¢/point`
      : 'Not Applied';

    const fSummary = $('flightRedemptionSummary');
    if (fSummary) {
      if (!res.flight.enabled) {
        fSummary.innerHTML = '<span>ℹ️ Flight miles redemption is currently disabled or missing inputs.</span>';
      } else if (res.flight.isNegativeSavings) {
        fSummary.innerHTML = `<span style="color:#f87171; font-weight:600;">⚠️ Warning: Award taxes (${core.formatCurrency(res.flight.outOfPocket, currentCurrency, 'en')}) exceed cash ticket price (${core.formatCurrency(res.flight.cashPrice, currentCurrency, 'en')}). Paying cash is strongly recommended!</span>`;
      } else {
        const balNote = res.flightBalanceSufficient === false ? ' <span style="color:#f87171;">(⚠️ Balance insufficient)</span>' : '';
        fSummary.innerHTML = `<strong>Flight Net Savings: ${core.formatCurrency(res.flight.netSavings, currentCurrency, 'en')}</strong> | Value: <strong>${res.flight.cpp.toFixed(2)} ¢/mile</strong>${balNote}`;
      }
    }

    const hSummary = $('hotelRedemptionSummary');
    if (hSummary) {
      if (!res.hotel.enabled) {
        hSummary.innerHTML = '<span>ℹ️ Hotel points redemption is currently disabled or missing inputs.</span>';
      } else if (res.hotel.isNegativeSavings) {
        hSummary.innerHTML = `<span style="color:#f87171; font-weight:600;">⚠️ Warning: Resort fees & taxes (${core.formatCurrency(res.hotel.outOfPocket, currentCurrency, 'en')}) exceed cash room price (${core.formatCurrency(res.hotel.cashPrice, currentCurrency, 'en')}). Paying cash is recommended!</span>`;
      } else {
        const balNote = res.hotelBalanceSufficient === false ? ' <span style="color:#f87171;">(⚠️ Balance insufficient)</span>' : '';
        hSummary.innerHTML = `<strong>Hotel Net Savings: ${core.formatCurrency(res.hotel.netSavings, currentCurrency, 'en')}</strong> | Value: <strong>${res.hotel.cpp.toFixed(2)} ¢/point</strong>${balNote}`;
      }
    }

    const tbody = $('waterfallBody');
    tbody.innerHTML = '';

    const addRow = (step, desc, amount, type = 'normal') => {
      const tr = document.createElement('tr');
      if (type === 'negative') tr.className = 'waterfall-row-negative';
      if (type === 'positive') tr.className = 'waterfall-row-positive';
      if (type === 'total') tr.className = 'waterfall-row-total';
      tr.innerHTML = `<td><strong>${step}</strong></td><td>${desc}</td><td>${amount}</td>`;
      tbody.appendChild(tr);
    };

    addRow('1. All-Cash Budget Baseline', 'Sum of all 10 cash expense categories', core.formatCurrency(res.cashTripCost, currentCurrency, 'en'));

    if (res.flight.enabled) {
      addRow('2. Deduct Flight Cash Price', 'Replaced cash flights with airline miles', `-${core.formatCurrency(res.breakdown.flightsCash, currentCurrency, 'en')}`, 'negative');
      addRow('3. Add Back Award Flight Taxes', 'Mandatory airport taxes and fuel surcharges', `+${core.formatCurrency(res.flight.outOfPocket, currentCurrency, 'en')}`, 'positive');
    }

    if (res.hotel.enabled) {
      addRow('4. Deduct Hotel Cash Price', 'Replaced cash hotel rooms with hotel points', `-${core.formatCurrency(res.breakdown.hotelCash, currentCurrency, 'en')}`, 'negative');
      if (res.hotel.outOfPocket > 0) {
        addRow('5. Add Back Hotel Resort Fees', 'Mandatory hotel destination & resort fees', `+${core.formatCurrency(res.hotel.outOfPocket, currentCurrency, 'en')}`, 'positive');
      }
    }

    addRow('Final Out-of-Pocket Cash', `Total cash required from your checking/credit card`, core.formatCurrency(res.finalOutOfPocket, currentCurrency, 'en'), 'total');

    const vBadge = $('verdictBadge');
    const vCode = $('verdictCode');
    const vBox = $('verdictSummaryBox');

    vBadge.className = 'verdict';
    if (res.totalSavings > 0 && !res.flight.isNegativeSavings && !res.hotel.isNegativeSavings) {
      vBadge.textContent = 'Redeem Points';
      vBadge.className = 'verdict good';
      vCode.textContent = `SAVE ${res.pointsCoverageRate.toFixed(0)}%`;
      vBox.innerHTML = `<strong>💡 Recommendation:</strong> Applying rewards saves <strong>${core.formatCurrency(res.totalSavings, currentCurrency, 'en')}</strong> in cash outlays, covering <strong>${res.pointsCoverageRate.toFixed(1)}%</strong> of your total vacation budget.` +
        (res.flight.enabled && res.hotel.enabled ? ` Realized <strong>${res.flight.cpp.toFixed(2)} ¢/pt</strong> on flights and <strong>${res.hotel.cpp.toFixed(2)} ¢/pt</strong> on hotels, with ${res.flight.cpp >= res.hotel.cpp ? 'flights providing higher unit redemption value.' : 'hotels providing higher unit redemption value.'}` : '');
    } else if (res.flight.isNegativeSavings || res.hotel.isNegativeSavings) {
      vBadge.textContent = 'Pay Cash on Items';
      vBadge.className = 'verdict bad';
      vCode.textContent = 'AVOID DEFICIT';
      vBox.innerHTML = `<strong style="color:#f87171;">⚠️ Warning:</strong> Certain redemptions carry taxes/fees higher than their cash equivalent. Pay cash for those items to avoid a net loss.`;
    } else {
      vBadge.textContent = 'All-Cash Plan';
      vCode.textContent = 'ALL CASH';
      vBox.innerHTML = 'No points applied. Toggle the flight or hotel redemption modules above to estimate your savings.';
    }
  }

  const allInputIds = [
    'tripDays','adults','children','travelStyle',
    'expFlights','expHotel','expDining','expTransit','expCarRental','expParkingTolls',
    'expActivities','expVisaInsurance','expConnectivity','expOther',
    'flightMilesNeeded','flightAwardTaxes','flightAwardCopay','flightMilesBalance',
    'hotelPointsNeeded','hotelAwardTaxes','hotelResortFees','hotelCashCopay','hotelPointsBalance'
  ];

  allInputIds.forEach(id => {
    const el = $(id);
    if (el) el.addEventListener('input', renderCalculator);
  });

  $('enableFlightPoints').addEventListener('change', (e) => {
    $('flightPointsFields').style.opacity = e.target.checked ? '1' : '0.5';
    renderCalculator();
  });

  $('enableHotelPoints').addEventListener('change', (e) => {
    $('hotelPointsFields').style.opacity = e.target.checked ? '1' : '0.5';
    renderCalculator();
  });

  $('currency').addEventListener('change', (e) => {
    currentCurrency = e.target.value;
    try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
    updateCurrencyLabels();
    renderCalculator();
  });

  $('btnReset').addEventListener('click', () => {
    allInputIds.forEach(id => {
      const el = $(id);
      if (el) {
        if (id === 'tripDays') el.value = '7';
        else if (id === 'adults') el.value = '2';
        else if (id === 'children') el.value = '0';
        else el.value = '0';
      }
    });
    $('origin').value = '';
    $('destination').value = '';
    renderCalculator();
    showToast('Reset all inputs to defaults');
  });

  $('btnPrint').addEventListener('click', () => {
    window.print();
  });

  $('btnSaveLocal').addEventListener('click', () => {
    const data = getTripInputData();
    data.origin = $('origin').value;
    data.destination = $('destination').value;
    try {
      localStorage.setItem('savedTripBudget', JSON.stringify(data));
      showToast('Budget draft successfully saved to local browser');
    } catch(e) {
      showToast('Failed to save to local storage');
    }
  });

  $('btnCopySummary').addEventListener('click', () => {
    const data = getTripInputData();
    const res = core.calculateTripCostAfterPoints(data);
    const summary = `[Points & Miles Calculator - Trip Budget Summary]\nDestination: ${$('destination').value || 'Unspecified'} (${data.tripDays} days / ${data.adults} Adults, ${data.children} Children)\nAll-Cash Budget: ${core.formatCurrency(res.cashTripCost, currentCurrency, 'en')}\nOut-of-Pocket After Points: ${core.formatCurrency(res.finalOutOfPocket, currentCurrency, 'en')}\nNet Cash Savings: ${core.formatCurrency(res.totalSavings, currentCurrency, 'en')} (${res.pointsCoverageRate.toFixed(1)}% covered)\nOut-of-Pocket Per Person: ${core.formatCurrency(res.perPersonCashFinal, currentCurrency, 'en')}\nOut-of-Pocket Per Day: ${core.formatCurrency(res.dailyCashFinal, currentCurrency, 'en')}\nCalculated at: ${window.location.href}`;
    navigator.clipboard.writeText(summary).then(() => {
      showToast('Budget summary copied to clipboard');
    }).catch(() => {
      showToast('Failed to copy summary');
    });
  });

  $('btnShare').addEventListener('click', () => {
    const p = new URLSearchParams();
    p.set('currency', currentCurrency);
    p.set('days', $('tripDays').value);
    p.set('adults', $('adults').value);
    p.set('children', $('children').value);
    if ($('expFlights').value) p.set('fCash', $('expFlights').value);
    if ($('expHotel').value) p.set('hCash', $('expHotel').value);
    if ($('expDining').value) p.set('dCash', $('expDining').value);
    if ($('enableFlightPoints').checked && $('flightMilesNeeded').value) {
      p.set('fMiles', $('flightMilesNeeded').value);
      p.set('fTaxes', $('flightAwardTaxes').value);
    }
    if ($('enableHotelPoints').checked && $('hotelPointsNeeded').value) {
      p.set('hPoints', $('hotelPointsNeeded').value);
      p.set('hTaxes', $('hotelAwardTaxes').value);
      p.set('hResort', $('hotelResortFees').value);
    }
    const shareUrl = `${window.location.origin}${window.location.pathname}?${p.toString()}`;
    navigator.clipboard.writeText(shareUrl).then(() => {
      showToast('Shareable link copied to clipboard!');
    }).catch(() => {
      showToast('Share link ready');
    });
  });

  function parseUrlParams() {
    if (!window.location.search) return;
    ['expFlights','expHotel','expDining','expTransit','expCarRental','expParkingTolls',
     'expActivities','expVisaInsurance','expConnectivity','expOther'].forEach(id => {
      const el = $(id);
      if (el) el.value = '0';
    });

    const parse = (key, id) => {
      const val = params.get(key);
      if (val !== null && !isNaN(parseFloat(val))) {
        const el = $(id);
        if (el) el.value = val;
      }
    };
    parse('days', 'tripDays');
    parse('adults', 'adults');
    parse('children', 'children');
    parse('fCash', 'expFlights');
    parse('hCash', 'expHotel');
    parse('dCash', 'expDining');
    parse('tCash', 'expTransit');
    parse('carCash', 'expCarRental');
    parse('gasCash', 'expParkingTolls');
    parse('actCash', 'expActivities');
    parse('visaCash', 'expVisaInsurance');
    parse('simCash', 'expConnectivity');
    parse('othCash', 'expOther');
    parse('fMiles', 'flightMilesNeeded');
    parse('fTaxes', 'flightAwardTaxes');
    parse('fCopay', 'flightAwardCopay');
    parse('hPoints', 'hotelPointsNeeded');
    parse('hTaxes', 'hotelAwardTaxes');
    parse('hResort', 'hotelResortFees');
    parse('hCopay', 'hotelCashCopay');
  }

  function tryRestoreLocalStorage() {
    if (window.location.search) return;
    try {
      const saved = localStorage.getItem('savedTripBudget');
      if (saved) {
        const d = JSON.parse(saved);
        if (d.origin) $('origin').value = d.origin;
        if (d.destination) $('destination').value = d.destination;
        if (d.tripDays) $('tripDays').value = d.tripDays;
        if (d.adults) $('adults').value = d.adults;
        if (d.children !== undefined) $('children').value = d.children;
        if (d.expenses) {
          if (d.expenses.flights !== undefined) $('expFlights').value = d.expenses.flights;
          if (d.expenses.hotel !== undefined) $('expHotel').value = d.expenses.hotel;
          if (d.expenses.dining !== undefined) $('expDining').value = d.expenses.dining;
          if (d.expenses.transit !== undefined) $('expTransit').value = d.expenses.transit;
          if (d.expenses.carRental !== undefined) $('expCarRental').value = d.expenses.carRental;
          if (d.expenses.parkingTolls !== undefined) $('expParkingTolls').value = d.expenses.parkingTolls;
          if (d.expenses.activities !== undefined) $('expActivities').value = d.expenses.activities;
          if (d.expenses.visaInsurance !== undefined) $('expVisaInsurance').value = d.expenses.visaInsurance;
          if (d.expenses.connectivity !== undefined) $('expConnectivity').value = d.expenses.connectivity;
          if (d.expenses.other !== undefined) $('expOther').value = d.expenses.other;
        }
      }
    } catch(e) {}
  }

  parseUrlParams();
  tryRestoreLocalStorage();
  updateCurrencyLabels();
  renderCalculator();
</script>
