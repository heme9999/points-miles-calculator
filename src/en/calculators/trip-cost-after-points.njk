          programName: $('flightProgramName') ? $('flightProgramName').value.trim() : '',
          awardMilesRequired: $('flightMilesNeeded') ? $('flightMilesNeeded').value : 0,
          awardTaxes: $('flightAwardTaxes') ? $('flightAwardTaxes').value : 0,
          awardCashCopay: $('flightAwardCopay') ? $('flightAwardCopay').value : 0,
          airlineMilesBalance: $('flightMilesBalance') && $('flightMilesBalance').value !== '' ? $('flightMilesBalance').value : null,
          baseTransferRatio: $('flightBaseTransferRatio') ? $('flightBaseTransferRatio').value : 1.0,
          transferBonusPercent: $('flightTransferBonus') ? $('flightTransferBonus').value : 0,
          transferIncrement: $('flightTransferIncrement') ? $('flightTransferIncrement').value : 1000,
          transferablePointsBalance: $('flightTransferableBalance') && $('flightTransferableBalance').value !== '' ? $('flightTransferableBalance').value : null
        },
        hotelRedemption: {
          enabled: $('enableHotelPoints') ? $('enableHotelPoints').checked : true,
          programName: $('hotelProgramName') ? $('hotelProgramName').value.trim() : '',
          pointsNeeded: $('hotelPointsNeeded') ? $('hotelPointsNeeded').value : 0,
          awardTaxes: $('hotelAwardTaxes') ? $('hotelAwardTaxes').value : 0,
          resortFees: $('hotelResortFees') ? $('hotelResortFees').value : 0,
          hotelCashCopay: $('hotelCashCopay') ? $('hotelCashCopay').value : 0,
          pointsBalance: $('hotelPointsBalance') && $('hotelPointsBalance').value !== '' ? $('hotelPointsBalance').value : null
        }
      };
    }

    function restoreTripState(raw) {
      const s = core.normalizeTripState(raw);
      if ($('origin')) $('origin').value = s.origin;
      if ($('destination')) $('destination').value = s.destination;
      if ($('tripDays')) $('tripDays').value = s.tripDays;
      if ($('adults')) $('adults').value = s.adults;
      if ($('children')) $('children').value = s.children;
      if ($('currency')) $('currency').value = s.currency;
      if ($('fxRate')) $('fxRate').value = s.fxRate;
      if ($('travelStyle')) $('travelStyle').value = s.travelStyle;

      if ($('expFlights')) $('expFlights').value = s.expenses.flights;
      if ($('expHotel')) $('expHotel').value = s.expenses.hotel;
      if ($('expDining')) $('expDining').value = s.expenses.dining;
      if ($('expTransit')) $('expTransit').value = s.expenses.transit;
      if ($('expCarRental')) $('expCarRental').value = s.expenses.carRental;
      if ($('expParkingTolls')) $('expParkingTolls').value = s.expenses.parkingTolls;
      if ($('expActivities')) $('expActivities').value = s.expenses.activities;
      if ($('expVisaInsurance')) $('expVisaInsurance').value = s.expenses.visaInsurance;
      if ($('expConnectivity')) $('expConnectivity').value = s.expenses.connectivity;
      if ($('expOther')) $('expOther').value = s.expenses.other;

      if ($('enableFlightPoints')) {
        $('enableFlightPoints').checked = s.flightRedemption.enabled;
        if ($('flightPointsFields')) {
          $('flightPointsFields').style.opacity = s.flightRedemption.enabled ? '1' : '0.5';
        }
      }
      if ($('flightProgramName')) $('flightProgramName').value = s.flightRedemption.programName;
      if ($('flightMilesNeeded')) $('flightMilesNeeded').value = s.flightRedemption.awardMilesRequired;
      if ($('flightAwardTaxes')) $('flightAwardTaxes').value = s.flightRedemption.awardTaxes;
      if ($('flightAwardCopay')) $('flightAwardCopay').value = s.flightRedemption.awardCashCopay;
      if ($('flightMilesBalance')) $('flightMilesBalance').value = s.flightRedemption.airlineMilesBalance !== null ? s.flightRedemption.airlineMilesBalance : '';
      if ($('flightBaseTransferRatio')) $('flightBaseTransferRatio').value = s.flightRedemption.baseTransferRatio;
      if ($('flightTransferBonus')) $('flightTransferBonus').value = s.flightRedemption.transferBonusPercent;
      if ($('flightTransferIncrement')) $('flightTransferIncrement').value = s.flightRedemption.transferIncrement;
      if ($('flightTransferableBalance')) $('flightTransferableBalance').value = s.flightRedemption.transferablePointsBalance !== null ? s.flightRedemption.transferablePointsBalance : '';

      if ($('enableHotelPoints')) {
        $('enableHotelPoints').checked = s.hotelRedemption.enabled;
        if ($('hotelPointsFields')) {
          $('hotelPointsFields').style.opacity = s.hotelRedemption.enabled ? '1' : '0.5';
        }
      }
      if ($('hotelProgramName')) $('hotelProgramName').value = s.hotelRedemption.programName;
      if ($('hotelPointsNeeded')) $('hotelPointsNeeded').value = s.hotelRedemption.pointsNeeded;
      if ($('hotelAwardTaxes')) $('hotelAwardTaxes').value = s.hotelRedemption.awardTaxes;
      if ($('hotelResortFees')) $('hotelResortFees').value = s.hotelRedemption.resortFees;
      if ($('hotelCashCopay')) $('hotelCashCopay').value = s.hotelCashCopay;
      if ($('hotelPointsBalance')) $('hotelPointsBalance').value = s.hotelRedemption.pointsBalance !== null ? s.hotelRedemption.pointsBalance : '';

      updateCurrencyLabels(s.currency);
    }

    function updateCurrencyLabels(curr) {
      const sym = curr === 'USD' ? '$' : '¥';
      const hints = [
        'hintExpFlights','hintExpHotel','hintExpDining','hintExpTransit',
        'hintExpCarRental','hintExpParkingTolls','hintExpActivities',
        'hintExpVisaInsurance','hintExpConnectivity','hintExpOther',
        'hintFlightTaxes','hintFlightCopay','hintHotelTaxes','hintHotelResort','hintHotelCopay'
      ];
      hints.forEach(hId => {
        const el = $(hId);
        if (!el) return;
        if (hId.includes('Exp')) el.textContent = `${sym} Total Party`;
        else if (hId.includes('Copay')) el.textContent = `${sym} Optional`;
        else el.textContent = `${sym} Out of Pocket`;
      });
      if ($('fieldFx')) {
        $('fieldFx').style.display = curr === 'CNY' ? 'block' : 'none';
      }
    }

    function renderCalculator() {
      const rawState = collectTripState();
      const state = core.normalizeTripState(rawState);
      const res = core.calculateTripCostAfterPoints(state);
      const curr = state.currency;

      // Update Card Prices
      $('cardOriginalPrice').textContent = core.formatCurrency(res.cashTripCost, curr, 'en');
      $('cardFinalPrice').textContent = core.formatCurrency(res.finalOutOfPocket, curr, 'en');
      
      const badge = $('badgeTotalSavings');
      if (res.totalSavings > 0) {
        badge.textContent = `Saved ${core.formatCurrency(res.totalSavings, curr, 'en')}`;
        badge.className = 'badge-status badge-success';
      } else {
        badge.textContent = 'No savings';
        badge.className = 'badge-status badge-neutral';
      }

      $('valCoverageRate').textContent = `${res.pointsCoverageRate.toFixed(1)}%`;
      $('valPerPersonCash').textContent = core.formatCurrency(res.perPersonCashFinal, curr, 'en');
      $('unitPerPerson').textContent = `Per traveler (${res.totalTravelers} total, was ${core.formatCurrency(res.perPersonCashOriginal, curr, 'en')})`;

      $('valDailyCash').textContent = core.formatCurrency(res.dailyCashFinal, curr, 'en');
      $('unitDaily').textContent = `Per day (${res.tripDays} days, was ${core.formatCurrency(res.dailyCashOriginal, curr, 'en')})`;

      // Flight Summary Box
      const flightBox = $('flightRedemptionSummary');
      if (res.flight.enabled) {
        $('valFlightCpp').textContent = `${res.flight.cpp.toFixed(2)} ¢/pt`;
        $('valFlightLocal').textContent = curr === 'CNY' 
          ? `Net value ¥${res.flight.localPerPoint.toFixed(4)} / pt`
          : `Net value $${res.flight.localPerPoint.toFixed(4)} / pt`;
        
        const td = res.flight.transferDetails || {};
        const awardMiles = (td.awardMilesRequired || 0).toLocaleString();
        const existingMiles = td.airlineMilesBalance !== null && td.airlineMilesBalance !== undefined ? td.airlineMilesBalance.toLocaleString() : 'None';
        const remainingMiles = (td.remainingMilesNeeded !== undefined ? td.remainingMilesNeeded : 0).toLocaleString();
        const bankNeeded = (td.bankPointsNeeded || 0).toLocaleString();
        const bankSaved = (td.bankPointsSaved || 0).toLocaleString();
        const milesRec = (td.milesReceived || 0).toLocaleString();
        const projMiles = (td.projectedAirlineMiles !== undefined ? td.projectedAirlineMiles : 0).toLocaleString();
        const excessMiles = (td.excessMilesAfterTransfer || 0).toLocaleString();
        const transInc = (td.transferIncrement || 1000).toLocaleString();
        const transRatio = td.baseTransferRatio !== undefined ? td.baseTransferRatio : 1.0;
        const bonusPct = td.transferBonusPercent || 0;
        const transBal = td.transferablePointsBalance !== null && td.transferablePointsBalance !== undefined ? td.transferablePointsBalance.toLocaleString() : 'None';

        let transHtml = '';

        if (td.airlineBalanceBeforeTransferSufficient) {
          transHtml = `<div style="margin-top:8px; padding-top:8px; border-top:1px dashed rgba(255,255,255,0.15);">
            ✈️ <strong>Airline Miles Sufficient:</strong> Award flight requires <span id="resultAwardMilesRequired">${awardMiles}</span> miles. Account balance: <span id="resultExistingAirlineMiles">${existingMiles}</span> miles.<br>
            💡 <strong>Current airline miles are sufficient. No bank points transfer required.</strong>
            <span id="resultRemainingMiles" style="display:none;">0</span>
            <span id="resultBankPointsNeeded" style="display:none;">0</span>
            <span id="resultBankPointsSaved" style="display:none;">0</span>
            <span id="resultMilesReceived" style="display:none;">0</span>
            <span id="resultProjectedAirlineMiles" style="display:none;">${projMiles}</span>
            <span id="resultExcessMiles" style="display:none;">${excessMiles}</span>
            <span id="resultBankBalanceStatus" style="display:none;">No transfer needed</span>
            <span id="resultAirlineBalanceBeforeStatus" style="display:none;">Sufficient</span>
            <span id="resultAirlineBalanceAfterStatus" style="display:none;">Sufficient</span>
          </div>`;
        } else {
          let unfillHint = '';
          if (td.airlineMilesBalance === null || td.airlineMilesBalance === undefined) {
            unfillHint = `<div style="color:var(--muted); font-size:12.5px; margin-bottom:4px;">ℹ️ Airline balance not provided; transfer estimate assumes 0 existing miles.</div>`;
          }

          let excessText = '';
          if ((td.excessMilesAfterTransfer || 0) > 0) {
            excessText = `, excess <span id="resultExcessMiles">${excessMiles}</span> miles`;
          } else {
            excessText = `<span id="resultExcessMiles" style="display:none;">0</span>`;
          }

          let bankBalText = '';
          if (td.bankBalanceSufficient === true) {
            bankBalText = `, <span id="resultBankBalanceStatus" style="color:#4ade80;">Sufficient balance</span>`;
          } else if (td.bankBalanceSufficient === false) {
            bankBalText = `, <span id="resultBankBalanceStatus" style="color:#f87171;">⚠️ Insufficient bank balance</span>`;
          } else {
            bankBalText = `, <span id="resultBankBalanceStatus">Not verified</span>`;
          }

          transHtml = `<div style="margin-top:8px; padding-top:8px; border-top:1px dashed rgba(255,255,255,0.15);">
            ${unfillHint}
            💳 <strong>Points Transfer & Mileage Gap Breakdown:</strong><br>
            1. Award flight requires <span id="resultAwardMilesRequired">${awardMiles}</span> miles. Existing balance: <span id="resultExistingAirlineMiles">${existingMiles}</span> miles, remaining gap: <span id="resultRemainingMiles">${remainingMiles}</span> miles.<br>
            2. At ${transRatio} miles per bank point, ${bonusPct}% bonus, rounded to ${transInc} pts, transfer <span id="resultBankPointsNeeded">${bankNeeded}</span> bank points` +
            (td.bankPointsSaved > 0 ? ` (Bonus saved <span id="resultBankPointsSaved">${bankSaved}</span> pts)` : `<span id="resultBankPointsSaved" style="display:none;">0</span>`) + `.<br>
            3. Yields <span id="resultMilesReceived">${milesRec}</span> miles. Projected airline balance: <span id="resultProjectedAirlineMiles">${projMiles}</span> miles${excessText}.<br>
            4. Transferable bank points balance: ${transBal}${bankBalText} · Effective bank point value: <strong>${res.flight.effectiveBankCpp.toFixed(2)} ¢/pt</strong>.
            <span id="resultAirlineBalanceBeforeStatus" style="display:none;">${td.airlineBalanceBeforeTransferSufficient ? 'Sufficient' : 'Insufficient'}</span>
            <span id="resultAirlineBalanceAfterStatus" style="display:none;">${td.airlineBalanceAfterTransferSufficient ? 'Sufficient' : 'Insufficient'}</span>
          </div>`;
        }

        flightBox.innerHTML = `✈️ <strong>Flight Deduction:</strong> Cash fare <strong>${core.formatCurrency(res.flight.cashPrice, curr, 'en')}</strong> ➔ Covered by <strong>${res.flight.milesNeeded.toLocaleString()}</strong> miles, paying <strong>${core.formatCurrency(res.flight.outOfPocket, curr, 'en')}</strong> in cash taxes/fees. Net cash saved: <strong>${core.formatCurrency(res.flight.netSavings, curr, 'en')}</strong> (Realized <strong>${res.flight.cpp.toFixed(2)} ¢/pt</strong>)${transHtml}`;
      } else {
        $('valFlightCpp').textContent = '—';
        $('valFlightLocal').textContent = 'No flight miles applied';
        flightBox.innerHTML = `✈️ Flight miles deduction is disabled or cash flight price is $0.
          <span id="resultAwardMilesRequired" style="display:none;">0</span>
          <span id="resultExistingAirlineMiles" style="display:none;">0</span>
          <span id="resultRemainingMiles" style="display:none;">0</span>
          <span id="resultBankPointsNeeded" style="display:none;">0</span>
          <span id="resultBankPointsSaved" style="display:none;">0</span>
          <span id="resultMilesReceived" style="display:none;">0</span>
          <span id="resultProjectedAirlineMiles" style="display:none;">0</span>
          <span id="resultExcessMiles" style="display:none;">0</span>
          <span id="resultBankBalanceStatus" style="display:none;">Disabled</span>
          <span id="resultAirlineBalanceBeforeStatus" style="display:none;">Disabled</span>
          <span id="resultAirlineBalanceAfterStatus" style="display:none;">Disabled</span>`;
      }

      // Hotel Summary Box
      const hotelBox = $('hotelRedemptionSummary');
      if (res.hotel.enabled) {
        $('valHotelCpp').textContent = `${res.hotel.cpp.toFixed(2)} ¢/pt`;
        $('valHotelLocal').textContent = curr === 'CNY' 
          ? `Net value ¥${res.hotel.localPerPoint.toFixed(4)} / pt`
          : `Net value $${res.hotel.localPerPoint.toFixed(4)} / pt`;
        
        let hotelBalHtml = '';
        if (res.hotel.hotelBalanceSufficient === false) {
          hotelBalHtml = ` · <span style="color:#f87171;">⚠️ Insufficient hotel points</span>`;
        } else if (res.hotel.hotelBalanceSufficient === true) {
          hotelBalHtml = ` · <span style="color:#4ade80;">✓ Hotel points sufficient</span>`;
        }

        hotelBox.innerHTML = `🏨 <strong>Hotel Deduction:</strong> Cash room cost <strong>${core.formatCurrency(res.hotel.cashPrice, curr, 'en')}</strong> ➔ Covered by <strong>${res.hotel.pointsNeeded.toLocaleString()}</strong> points, paying <strong>${core.formatCurrency(res.hotel.outOfPocket, curr, 'en')}</strong> out-of-pocket. Net cash saved: <strong>${core.formatCurrency(res.hotel.netSavings, curr, 'en')}</strong> (Realized <strong>${res.hotel.cpp.toFixed(2)} ¢/pt</strong>)${hotelBalHtml}`;
      } else {
        $('valHotelCpp').textContent = '—';
        $('valHotelLocal').textContent = 'No hotel points applied';
        hotelBox.innerHTML = '🏨 Hotel points deduction is disabled or cash hotel price is $0.';
      }

      // Waterfall Table
      const wb = $('waterfallBody');
      const b = res.breakdown;
      const rows = [
        { name: '✈️ Roundtrip Flights', cash: b.flights, deduction: res.flight.enabled ? -b.flights : 0, taxes: res.flight.enabled ? res.flight.outOfPocket : 0, final: res.flight.enabled ? res.flight.outOfPocket : b.flights },
        { name: '🏨 Hotel / Lodging', cash: b.hotel, deduction: res.hotel.enabled ? -b.hotel : 0, taxes: res.hotel.enabled ? res.hotel.outOfPocket : 0, final: res.hotel.enabled ? res.hotel.outOfPocket : b.hotel },
        { name: '🍜 Dining & Food', cash: b.dining, deduction: 0, taxes: 0, final: b.dining },
        { name: '🚇 Public Transit', cash: b.transit, deduction: 0, taxes: 0, final: b.transit },
        { name: '🚗 Car Rental', cash: b.carRental, deduction: 0, taxes: 0, final: b.carRental },
        { name: '⛽ Gas & Parking', cash: b.parkingTolls, deduction: 0, taxes: 0, final: b.parkingTolls },
        { name: '🎟️ Activities & Tours', cash: b.activities, deduction: 0, taxes: 0, final: b.activities },
        { name: '📄 Visas & Insurance', cash: b.visaInsurance, deduction: 0, taxes: 0, final: b.visaInsurance },
        { name: '📶 eSIM & Cellular', cash: b.connectivity, deduction: 0, taxes: 0, final: b.connectivity },
        { name: '🛍️ Miscellaneous', cash: b.other, deduction: 0, taxes: 0, final: b.other }
      ];

      let html = '';
      rows.forEach(r => {
        if (r.cash === 0 && r.final === 0) return;
        html += `<tr>
          <td><strong>${r.name}</strong></td>
          <td>${core.formatCurrency(r.cash, curr, 'en')}</td>
          <td style="color:${r.deduction < 0 ? '#4ade80' : 'var(--muted)'};">${r.deduction !== 0 ? core.formatCurrency(r.deduction, curr, 'en') : '—'}</td>
          <td style="color:${r.taxes > 0 ? '#f87171' : 'var(--muted)'};">${r.taxes > 0 ? '+' + core.formatCurrency(r.taxes, curr, 'en') : '—'}</td>
          <td><strong>${core.formatCurrency(r.final, curr, 'en')}</strong></td>
        </tr>`;
      });
      html += `<tr style="font-weight:700; background:rgba(255,255,255,0.04); border-top: 2px solid var(--line);">
        <td>Total Trip Budget</td>
        <td>${core.formatCurrency(res.cashTripCost, curr, 'en')}</td>
        <td style="color:#4ade80;">-${core.formatCurrency(res.cashTripCost - res.finalOutOfPocket + (res.flight.enabled ? res.flight.outOfPocket : 0) + (res.hotel.enabled ? res.hotel.outOfPocket : 0), curr, 'en')}</td>
        <td style="color:#f87171;">+${core.formatCurrency((res.flight.enabled ? res.flight.outOfPocket : 0) + (res.hotel.enabled ? res.hotel.outOfPocket : 0), curr, 'en')}</td>
        <td style="color:var(--gold); font-size:16px;">${core.formatCurrency(res.finalOutOfPocket, curr, 'en')}</td>
      </tr>`;
      wb.innerHTML = html;

      // Verdict Box
      const vBadge = $('verdictBadge');
      const vCode = $('verdictCode');
      const vBox = $('verdictBox');
      if (res.flight.isNegativeSavings || res.hotel.isNegativeSavings) {
        vBadge.textContent = 'Avoid Deficit Items';
        vBadge.className = 'verdict bad';
        vCode.textContent = 'AVOID DEFICIT';
        vBox.innerHTML = `<div class="verdict-label">Recommendation</div><div class="verdict bad">Deficit Warning</div><p style="font-size:12px; margin-top:8px; color:#f87171;">Taxes or copays exceed the cash price for certain items. Pay cash for those items.</p>`;
      } else if (res.totalSavings > 0) {
        vBadge.textContent = 'Points Recommended';
        vBadge.className = 'verdict good';
        vCode.textContent = `SAVED ${res.pointsCoverageRate.toFixed(0)}%`;
        vBox.innerHTML = `<div class="verdict-label">Recommendation</div><div class="verdict good">Points Recommended</div><p style="font-size:12px; margin-top:8px;">Net savings of <strong>${core.formatCurrency(res.totalSavings, curr, 'en')}</strong> covers <strong>${res.pointsCoverageRate.toFixed(1)}%</strong> of your budget.` +
          (res.flight.enabled && res.hotel.enabled ? `<br>Flight CPP (${res.flight.cpp.toFixed(2)}¢) ${res.flight.cpp >= res.hotel.cpp ? '≥' : '<'} Hotel CPP (${res.hotel.cpp.toFixed(2)}¢)` : '') + `</p>`;
      } else {
        vBadge.textContent = 'All-Cash Plan';
        vBadge.className = 'verdict';
        vCode.textContent = 'ALL CASH';
        vBox.innerHTML = `<div class="verdict-label">Recommendation</div><div class="verdict">All-Cash Baseline</div><p style="font-size:12px; margin-top:8px;">No points deductions applied or no savings generated.</p>`;
      }
    }

    // Bind event listeners
    const allInputIds = [
      'origin','destination','tripDays','adults','children','travelStyle',
      'currency','fxRate',
      'expFlights','expHotel','expDining','expTransit','expCarRental','expParkingTolls',
      'expActivities','expVisaInsurance','expConnectivity','expOther',
      'flightMilesNeeded','flightAwardTaxes','flightAwardCopay','flightMilesBalance',
      'flightProgramName','flightBaseTransferRatio','flightTransferBonus','flightTransferIncrement','flightTransferableBalance',
      'hotelPointsNeeded','hotelAwardTaxes','hotelResortFees','hotelCashCopay','hotelPointsBalance','hotelProgramName'
    ];

    allInputIds.forEach(id => {
      const el = $(id);
      if (el) el.addEventListener('input', renderCalculator);
    });

    $('enableFlightPoints').addEventListener('change', (e) => {
      $('flightPointsFields').style.opacity = e.target.checked ? '1' : '0.5';
      renderCalculator();
    });

    $('enableHotelPoints').addEventListener('change', (e) => {
      $('hotelPointsFields').style.opacity = e.target.checked ? '1' : '0.5';
      renderCalculator();
    });

    $('currency').addEventListener('change', (e) => {
      updateCurrencyLabels(e.target.value);
      renderCalculator();
    });

    // Toolbar buttons
    $('btnReset').addEventListener('click', () => {
      try {
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(LEGACY_KEY);
      } catch(e) {}
      restoreTripState({
        tripDays: 10, adults: 2, children: 1, currency: 'USD', fxRate: 7.0, travelStyle: 'balanced',
        expenses: { flights: 0, hotel: 0, dining: 0, transit: 0, carRental: 0, parkingTolls: 0, activities: 0, visaInsurance: 0, connectivity: 0, other: 0 },
        flightRedemption: { enabled: true, awardMilesRequired: 0, awardTaxes: 0, awardCashCopay: 0, baseTransferRatio: 1.0, transferBonusPercent: 0, transferIncrement: 1000 },
        hotelRedemption: { enabled: true, pointsNeeded: 0, awardTaxes: 0, resortFees: 0, hotelCashCopay: 0 }
      });
      renderCalculator();
      showToast('Form reset and saved budget cleared');
    });

    $('btnPrint').addEventListener('click', () => {
      window.print();
    });

    $('btnSaveLocal').addEventListener('click', () => {
      const s = core.normalizeTripState(collectTripState());
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
        showToast('Budget data saved to browser local storage');
      } catch(e) {
        showToast('Save failed, please check browser permissions');
      }
    });

    $('btnCopySummary').addEventListener('click', () => {
      const s = core.normalizeTripState(collectTripState());
      const res = core.calculateTripCostAfterPoints(s);
      const curr = s.currency;
      const summary = `[Trip Budget Summary - Points & Miles Calculator]\nDestination: ${s.destination || 'Unspecified'} (${s.tripDays} Days / ${s.adults} Adults, ${s.children} Children)\nAll-Cash Baseline: ${core.formatCurrency(res.cashTripCost, curr, 'en')}\nTrue Out-of-Pocket Cost: ${core.formatCurrency(res.finalOutOfPocket, curr, 'en')}\nTotal Net Savings: ${core.formatCurrency(res.totalSavings, curr, 'en')} (Coverage: ${res.pointsCoverageRate.toFixed(1)}%)\nPer-Person Out-of-Pocket: ${core.formatCurrency(res.perPersonCashFinal, curr, 'en')}\nDaily Out-of-Pocket: ${core.formatCurrency(res.dailyCashFinal, curr, 'en')}\nGenerated via: ${window.location.href}`;
      navigator.clipboard.writeText(summary).then(() => {
        showToast('Budget summary copied to clipboard');
      }).catch(() => {
        showToast('Copy failed, please copy manually');
      });
    });

    $('btnShare').addEventListener('click', () => {
      const s = core.normalizeTripState(collectTripState());
      const query = core.serializeTripState(s);
      const shareUrl = `${window.location.origin}${window.location.pathname}?${query}`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        showToast('Share link copied to clipboard!');
      }).catch(() => {
        showToast('Share link generated');
      });
    });

    // Initialization logic: URL params > LocalStorage > Default
    function init() {
      if (window.location.search) {
        const urlState = core.parseTripParams(window.location.search);
        restoreTripState(urlState);
      } else {
        let loaded = false;
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            restoreTripState(JSON.parse(saved));
            loaded = true;
          } else {
            const legacy = localStorage.getItem(LEGACY_KEY);
            if (legacy) {
              const legData = JSON.parse(legacy);
              restoreTripState(legData);
              localStorage.setItem(STORAGE_KEY, JSON.stringify(core.normalizeTripState(legData)));
              loaded = true;
            }
          }
        } catch(e) {}

        if (!loaded) {
          updateCurrencyLabels('USD');
        }
      }
      renderCalculator();
    }

    init();
  })();
</script>
