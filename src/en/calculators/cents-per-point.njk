  <h3>Frequently Asked Questions</h3>
  <div class="faq">
    <details>
      <summary>Is a higher CPP always better?</summary>
      <div>
        <p>Theoretically yes, but avoid chasing "phantom" high CPP. If a first-class ticket costs $15,000 and you redeem 100,000 points, your CPP is 15¢. However, if you would never actually pay $15,000 for that flight, the 15¢ valuation is inflated. Always use a cash price you are genuinely willing to pay.</p>
      </div>
    </details>
    
    <details>
      <summary>How do I calculate CPP for hotel points?</summary>
      <div>
        <p>It is similar to flights: (Total cash cost including all taxes - any fees on the award stay) ÷ total points required. Note that hotel chains like Hilton and Hyatt often waive resort fees on award stays, which increases the "saved cash" portion of your calculation.</p>
      </div>
    </details>

    <details>
      <summary>What does a negative CPP mean?</summary>
      <div>
        <p>A negative CPP means the taxes and fuel surcharges on the award ticket are more expensive than buying the cash ticket outright. You should absolutely not use points for this redemption.</p>
      </div>
    </details>
  </div>
</div>

<script>
  const $ = id => document.getElementById(id);

  const parseParam = (key, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('cashPrice', 'cashPrice');
  parseParam('awardTaxes', 'awardTaxes');
  parseParam('pointsNeeded', 'pointsNeeded');
  parseParam('savedCash', 'savedCash');

  function calcCpp(){
    let C = parseFloat($('cashPrice').value) || 0;
    let T = parseFloat($('awardTaxes').value) || 0;
    let P = parseFloat($('pointsNeeded').value) || 0;
    
    const resetState = (msg = 'Please enter valid numbers.') => {
      $('savedCash').textContent = '-';
      $('cppResult').textContent = '-';
      $('explain').textContent = msg;
      $('cppResult').classList.remove('win', 'bad');
    };

    if (P <= 0 || C < 0 || T < 0) {
      resetState(P <= 0 ? 'Please enter the required points.' : 'Inputs cannot be negative.');
      return;
    }
    
    const saved = C - T;
    const cpp = (saved / P) * 100;
    
    $('savedCash').textContent = '$' + saved.toLocaleString('en-US', {maximumFractionDigits:0});
    $('cppResult').textContent = cpp.toFixed(2) + '¢ / point';
    
    const explain = $('explain');
    $('cppResult').classList.remove('win', 'bad');

    if(saved < 0){
      explain.textContent = 'Warning: You are losing money! The award taxes are higher than the cash price of the ticket.';
      $('cppResult').classList.add('bad');
    } else if(cpp < 1.0) {
      explain.textContent = 'Low CPP. This usually means you are redeeming for non-travel items or very cheap economy flights. Consider paying cash.';
      $('cppResult').classList.add('bad');
    } else if(cpp > 3.0) {
      explain.textContent = 'Excellent value! This CPP is very high, typically only seen when redeeming for international Business or First Class flights.';
      $('cppResult').classList.add('win');
    } else {
      explain.textContent = 'Good value. If the flight fits your schedule, it is a solid redemption.';
    }
  }

  ['cashPrice','awardTaxes','pointsNeeded'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcCpp);
  });

  // Calculate once on load to show default or URL param values
  calcCpp();
</script>
