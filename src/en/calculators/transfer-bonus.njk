<div class="article-content prose" style="margin-top: 40px;">
  <h2>What is a Transfer Bonus?</h2>
  <p>To incentivize users, major credit card programs (like <a href="/en/values/amex-membership-rewards/">Amex MR</a>, <a href="/en/values/chase-ultimate-rewards/">Chase UR</a>, <a href="/en/values/citi-thankyou-points/">Citi TYP</a>) frequently partner with airlines or hotels to offer limited-time "Transfer Bonuses." These typically range from 15% to 40%.</p>
  <p>For example, normally 1,000 credit card points convert to 1,000 miles. During a 30% bonus, those same 1,000 points yield 1,300 miles—effectively discounting all award tickets by over 20%.</p>

  <h3>Why use this calculator?</h3>
  <p>While bonuses are great, bank transfer systems usually have two strict limitations:</p>
  <ul>
    <li><strong>Increment Rules</strong>: You usually can't transfer exactly 1,234 points. Transfers must be in increments of 1,000.</li>
    <li><strong>Rounding Issues</strong>: Suppose you need 50,000 miles and have a 30% bonus. 50,000 ÷ 1.3 ≈ 38,461. Because of the increment rule, you must round up and transfer 39,000 points.</li>
  </ul>
  <p>This calculator automatically factors in the base ratio, the bonus percentage, and the increment constraints, telling you exactly how many points to transfer and how many "leftover" miles you will have after booking.</p>

  <h2>Common Transfer Bonus Mistakes</h2>
  <ol>
    <li><strong>Speculative Transfers</strong><br>
    Many beginners see a 30% bonus and transfer all their points immediately. This is a mistake. Airline miles constantly devalue and are subject to availability. Once points are transferred to an airline, <strong>they can never be moved back to the bank</strong>. Only transfer when you have confirmed availability and are ready to book.</li>
    <li><strong>Ignoring the Base Ratio</strong><br>
    Most US credit card transfers are 1:1, but there are exceptions (like Marriott transfers or Amex to JetBlue). Always double-check the base ratio on the bank's portal and enter it correctly here.</li>
    <li><strong>Beware of Phantom Availability and Delays</strong><br>
    Transfers to some programs (like ANA or Singapore Airlines) can take 24-48 hours. During this time, the award seat you wanted might disappear. You can use our <a href="/en/calculators/cents-per-point/">CPP Calculator</a> to quickly check if a backup flight is still worth booking.</li>
  </ol>

  <h3>Frequently Asked Questions</h3>
  <div>
    <details>
      <summary>Can I reverse a points transfer?</summary>
      <div>
        <p>No. Once you transfer flexible bank points to an airline or hotel loyalty program, the transaction is strictly one-way and irreversible. Never transfer points unless you are ready to book immediately.</p>
      </div>
    </details>
    
    <details>
      <summary>Why can't I transfer just 1,200 points?</summary>
      <div>
        <p>Most major banks (like Chase, Amex, and Citi) strictly enforce transfer increments of 1,000 points. Even if you only need 1,200 miles to top off your account, you will be forced to transfer 2,000 points.</p>
      </div>
    </details>

    <details>
      <summary>How often do transfer bonuses happen?</summary>
      <div>
        <p>It varies widely by bank and airline partner. Programs like British Airways (Avios) or Flying Blue typically see 1-2 transfer bonuses per year from major US banks. However, high-value partners might only see a bonus once every few years.</p>
      </div>
    </details>
  </div>

  </div>

<script>
  const $ = id => document.getElementById(id);

  const parseParam = (key, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  
  const parseParamWithFallback = (newKey, oldKey, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let rawStr = params.get(newKey);
    if (rawStr === null) {
        rawStr = params.get(oldKey);
    }
    let val = parseFloat(rawStr);
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };

  parseParamWithFallback('targetMiles', 'req', 'targetMiles');
  parseParamWithFallback('baseRatio', 'ratio', 'baseRatio');
  parseParamWithFallback('bonusPercent', 'bonus', 'bonusPercent');
  parseParamWithFallback('increment', 'inc', 'increment');

  function calcBonus(){
    let target = parseFloat($('targetMiles').value) || 0;
    let baseRatio = parseFloat($('baseRatio').value) || 0;
    let bonus = parseFloat($('bonusPercent').value) || 0;
    let increment = parseFloat($('increment').value) || 0;
    
    const resetState = (msg = 'Please enter valid numbers.') => {
      $('rawPoints').textContent = '-';
      $('actualPoints').textContent = '-';
      $('explain').textContent = msg;
      $('actualPoints').classList.remove('win');
    };

    if(target <= 0 || baseRatio <= 0 || bonus < 0 || increment <= 0) {
      resetState(target <= 0 ? 'Please enter the target miles.' : 'Inputs cannot be negative or zero.');
      return;
    }
    
    const multiplier = baseRatio * (1 + bonus/100);
    const rawPoints = target / multiplier;
    
    let actualPoints = Math.ceil(rawPoints / increment) * increment;
    
    $('rawPoints').textContent = rawPoints.toLocaleString('en-US', {maximumFractionDigits:1});
    $('actualPoints').textContent = actualPoints.toLocaleString('en-US', {maximumFractionDigits:0});
    $('actualPoints').classList.add('win');
    
    const finalMiles = actualPoints * multiplier;
    const leftover = finalMiles - target;
    
    $('explain').textContent = `You need to transfer ${actualPoints.toLocaleString('en-US', {maximumFractionDigits:0})} bank points. With the ${bonus}% bonus, you will receive ${finalMiles.toLocaleString('en-US', {maximumFractionDigits:0})} miles, leaving you with ${leftover.toLocaleString('en-US', {maximumFractionDigits:0})} extra miles after your redemption.`;
  }

  ['targetMiles','baseRatio','bonusPercent','increment'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calcBonus);
  });

  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/en/calculators/transfer-bonus/');
      const target = parseFloat($('targetMiles').value) || 0;
      const baseRatio = parseFloat($('baseRatio').value) || 0;
      const bonus = parseFloat($('bonusPercent').value) || 0;
      const increment = parseFloat($('increment').value) || 0;

      if(target > 0) url.searchParams.set('targetMiles', target);
      if(baseRatio > 0) url.searchParams.set('baseRatio', baseRatio);
      if(bonus >= 0) url.searchParams.set('bonusPercent', bonus);
      if(increment > 0) url.searchParams.set('increment', increment);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        if(toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
      });
    });
  }

  // Trigger initial calculation if parameters were loaded
  calcBonus();
</script>
