<script>
(function() {
  const $ = id => document.getElementById(id);

  const parseParam = (key, elId, maxVal = 1000000000) => {
    const params = new URLSearchParams(window.location.search);
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      const el = $(elId);
      if (el) el.value = val;
    }
  };

  parseParam('miles', 'unitedMiles');
  parseParam('points', 'unitedMiles');
  parseParam('cpp', 'cppValue');
  parseParam('valuation', 'cppValue');

  const parseScenarioParam = () => {
    const params = new URLSearchParams(window.location.search);
    const scen = params.get('scenario') || params.get('presetValuation');
    if (scen && $('presetValuation')) {
      const validOptions = ['custom', '1.0', '1.2', '1.5'];
      if (validOptions.includes(scen)) {
        $('presetValuation').value = scen;
        if (scen !== 'custom') {
          $('cppValue').value = scen;
        }
      }
    }
  };
  parseScenarioParam();

  function calcUnited() {
    const rawM = $('unitedMiles').value.trim();
    const rawC = $('cppValue').value.trim();
    const M = parseFloat(rawM);
    const C = parseFloat(rawC);

    const resetState = (msg = 'Please enter valid numbers.') => {
      $('dollarValue').textContent = '-';
      $('explain').textContent = msg;
      $('dollarValue').classList.remove('win');
    };

    if (rawM === '' || rawC === '' || isNaN(M) || isNaN(C) || !isFinite(M) || !isFinite(C) || M < 0 || C < 0) {
      resetState((M < 0 || C < 0) ? 'Inputs cannot be negative.' : 'Please enter your miles balance and cents-per-mile assumption.');
      return;
    }

    if (M === 0 || C === 0) {
      $('dollarValue').textContent = '$0';
      $('dollarValue').classList.add('win');
      $('explain').textContent = `Miles balance: ${M.toLocaleString('en-US')} | Valuation: ${C}¢ CPM | Estimated travel value: $0. Planning estimate, not guaranteed cashout value.`;
      return;
    }

    const total = M * (C / 100);
    $('dollarValue').textContent = '$' + total.toLocaleString('en-US', { maximumFractionDigits: 0 });
    $('dollarValue').classList.add('win');
    $('explain').textContent = `Miles balance: ${M.toLocaleString('en-US')} | Valuation: ${C}¢ CPM | Estimated travel value: $${total.toLocaleString('en-US', { maximumFractionDigits: 0 })}. Planning estimate, not guaranteed cashout value.`;
  }

  // Preset balance buttons
  document.querySelectorAll('.btn-balance-preset').forEach(btn => {
    btn.addEventListener('click', function() {
      const m = this.getAttribute('data-miles');
      $('unitedMiles').value = m;
      calcUnited();
    });
  });

  // Scenario dropdown
  $('presetValuation').addEventListener('change', e => {
    if (e.target.value !== 'custom') {
      $('cppValue').value = e.target.value;
      calcUnited();
    }
  });

  $('cppValue').addEventListener('input', () => {
    const val = $('cppValue').value;
    const matched = ['1.0', '1.2', '1.5'].includes(val);
    $('presetValuation').value = matched ? val : 'custom';
    calcUnited();
  });

  $('unitedMiles').addEventListener('input', calcUnited);

  // Help toggle
  const btnHelp = $('btnHelpScenario');
  const guideBox = $('helpScenarioGuide');
  if (btnHelp && guideBox) {
    btnHelp.addEventListener('click', () => {
      const isExpanded = btnHelp.getAttribute('aria-expanded') === 'true';
      btnHelp.setAttribute('aria-expanded', !isExpanded);
      guideBox.style.display = isExpanded ? 'none' : 'block';
    });
  }

  // Share calculation
  if ($('btnShare')) {
    $('btnShare').addEventListener('click', () => {
      const url = new URL('{{ site.url }}/en/calculators/united-miles-value-calculator/');
      const m = parseFloat($('unitedMiles').value) || 0;
      const c = parseFloat($('cppValue').value) || 0;
      if (m > 0) url.searchParams.set('miles', m);
      if (c > 0) url.searchParams.set('cpp', c);
      const scen = $('presetValuation').value;
      if (scen && scen !== 'custom') url.searchParams.set('scenario', scen);

      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = $('toast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      });
    });
  }

  calcUnited();
})();
</script>
