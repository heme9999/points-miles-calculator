<script>
  (function() {
    const $ = id => document.getElementById(id);
    const ptsInput = $('caponePoints');
    const bonusInput = $('promotionalBonus');

    function calculate() {
      const pts = parseInt(ptsInput.value, 10) || 0;
      const bonus = parseFloat(bonusInput.value) || 0;

      if (pts < 1000) {
        $('outTransferable').textContent = '0';
        $('outMiles').textContent = '0';
        $('outNote').textContent = 'Minimum transfer threshold is 1,000 Capital One miles.';
        $('outValue').textContent = '$0';
        return;
      }

      const transferable = Math.floor(pts / 1000) * 1000;
      const remainder = pts - transferable;
      const baseMiles = Math.round((transferable / 1000) * 750);
      const totalMiles = Math.round(baseMiles * (1 + bonus / 100));
      const estValue = (totalMiles * 0.014).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

      $('outTransferable').textContent = transferable.toLocaleString('en-US');
      $('outMiles').textContent = totalMiles.toLocaleString('en-US');
      $('outValue').textContent = estValue;

      if (remainder > 0) {
        $('outNote').textContent = `Transferred ${transferable.toLocaleString('en-US')} miles at 4:3 (0.75x). ${remainder.toLocaleString('en-US')} miles remain in Capital One (increments of 1,000).`;
      } else {
        $('outNote').textContent = `Transferred all ${transferable.toLocaleString('en-US')} miles at 4:3 (0.75x). 0 miles remaining.`;
      }
    }

    ptsInput.addEventListener('input', calculate);
    bonusInput.addEventListener('input', calculate);
    calculate();
  })();
</script>