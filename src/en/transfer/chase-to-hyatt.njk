<script>
  (function() {
    const $ = id => document.getElementById(id);
    const tierSelect = $('chaseCardTier');
    const ptsInput = $('chasePoints');
    const bonusInput = $('promotionalBonus');

    function calculate() {
      const ratio = parseFloat(tierSelect.value) || 1.0;
      const ratioLabel = ratio === 0.75 ? '4:3' : '1:1';
      const pts = parseInt(ptsInput.value, 10) || 0;
      const bonus = parseFloat(bonusInput.value) || 0;

      if (pts < 1000) {
        $('outTransferable').textContent = '0';
        $('outHyattPoints').textContent = '0';
        $('outNote').textContent = 'Minimum transfer threshold is 1,000 Chase points.';
        $('outValue').textContent = '$0';
        $('outBaseRatio').textContent = ratioLabel;
        $('outBonus').textContent = bonus + '%';
        $('outMultiplier').textContent = ratio.toFixed(2);
        $('outCode').textContent = `RATIO ${ratioLabel}`;
        return;
      }

      const transferable = Math.floor(pts / 1000) * 1000;
      const remainder = pts - transferable;
      const multiplier = ratio * (1 + bonus / 100);
      const hyattPts = Math.round(transferable * multiplier);
      const estValue = (hyattPts * 0.017).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

      $('outTransferable').textContent = transferable.toLocaleString('en-US');
      $('outHyattPoints').textContent = hyattPts.toLocaleString('en-US');
      $('outValue').textContent = estValue;
      $('outBaseRatio').textContent = ratioLabel;
      $('outBonus').textContent = bonus + '%';
      $('outMultiplier').textContent = multiplier.toFixed(2);
      $('outCode').textContent = bonus > 0 ? `RATIO 1:${multiplier.toFixed(2)}` : `RATIO ${ratioLabel}`;

      if (remainder > 0) {
        $('outNote').textContent = `Transferred ${transferable.toLocaleString('en-US')} Chase points at ${ratioLabel} base (effective ${multiplier.toFixed(2)}x). ${remainder.toLocaleString('en-US')} points remain in Chase (increments of 1,000).`;
      } else {
        $('outNote').textContent = `Transferred all ${transferable.toLocaleString('en-US')} Chase points at ${ratioLabel} base (effective ${multiplier.toFixed(2)}x). 0 points remaining.`;
      }
    }

    tierSelect.addEventListener('change', calculate);
    ptsInput.addEventListener('input', calculate);
    bonusInput.addEventListener('input', calculate);
    calculate();
  })();
</script>
