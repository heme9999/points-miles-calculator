<script>
  (function() {
    const $ = id => document.getElementById(id);
    const ptsInput = $('chasePoints');
    const bonusInput = $('promotionalBonus');

    function calculate() {
      const pts = parseInt(ptsInput.value, 10) || 0;
      const bonus = parseFloat(bonusInput.value) || 0;

      if (pts < 1000) {
        $('outTransferable').textContent = '0';
        $('outMiles').textContent = '0';
        $('outNote').textContent = 'Minimum transfer threshold is 1,000 Chase points.';
        $('outValue').textContent = '$0';
        return;
      }

      const transferable = Math.floor(pts / 1000) * 1000;
      const remainder = pts - transferable;
      const miles = Math.round(transferable * 1.0 * (1 + bonus / 100));
      const estValue = (miles * 0.012).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

      $('outTransferable').textContent = transferable.toLocaleString('en-US');
      $('outMiles').textContent = miles.toLocaleString('en-US');
      $('outValue').textContent = estValue;

      if (remainder > 0) {
        $('outNote').textContent = `Transferred ${transferable.toLocaleString('en-US')} points at 1:1. ${remainder.toLocaleString('en-US')} points remain in Chase (increments of 1,000).`;
      } else {
        $('outNote').textContent = `Transferred all ${transferable.toLocaleString('en-US')} points at 1:1. 0 points remaining.`;
      }
    }

    ptsInput.addEventListener('input', calculate);
    bonusInput.addEventListener('input', calculate);
    calculate();
  })();
</script>