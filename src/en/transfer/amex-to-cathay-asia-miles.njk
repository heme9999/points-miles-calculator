<script>
  (function() {
    const $ = id => document.getElementById(id);
    const ptsInput = $('amexPoints');
    const bonusInput = $('promotionalBonus');

    function calculate() {
      const pts = parseInt(ptsInput.value, 10) || 0;
      const bonus = parseFloat(bonusInput.value) || 0;

      if (pts < 1000) {
        $('outTransferable').textContent = '0';
        $('outMiles').textContent = '0';
        $('outNote').textContent = 'Minimum transfer threshold is 1,000 Amex points.';
        $('outValue').textContent = '$0';
        $('outBaseRatio').textContent = '5:4 (0.80x)';
        $('outBonus').textContent = bonus + '%';
        $('outMultiplier').textContent = '0.80';
        $('outCode').textContent = 'RATIO 5:4 (0.8)';
        return;
      }

      const transferable = Math.floor(pts / 1000) * 1000;
      const remainder = pts - transferable;
      const baseMiles = Math.round((transferable / 1000) * 800);
      const multiplier = (0.80 * (1 + bonus / 100));
      const totalMiles = Math.round(baseMiles * (1 + bonus / 100));
      const estValue = (totalMiles * 0.013).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

      $('outTransferable').textContent = transferable.toLocaleString('en-US');
      $('outMiles').textContent = totalMiles.toLocaleString('en-US');
      $('outValue').textContent = estValue;
      $('outBaseRatio').textContent = '5:4 (0.80x)';
      $('outBonus').textContent = bonus + '%';
      $('outMultiplier').textContent = multiplier.toFixed(2);
      $('outCode').textContent = bonus > 0 ? `RATIO 5:4 (${multiplier.toFixed(2)}x)` : 'RATIO 5:4 (0.8)';

      if (remainder > 0) {
        $('outNote').textContent = `Transferred ${transferable.toLocaleString('en-US')} points at 5:4 base (effective ${multiplier.toFixed(2)}x). ${remainder.toLocaleString('en-US')} points remain in Amex (increments of 1,000).`;
      } else {
        $('outNote').textContent = `Transferred all ${transferable.toLocaleString('en-US')} points at 5:4 base (effective ${multiplier.toFixed(2)}x). 0 points remaining.`;
      }
    }

    ptsInput.addEventListener('input', calculate);
    bonusInput.addEventListener('input', calculate);
    calculate();
  })();
</script>