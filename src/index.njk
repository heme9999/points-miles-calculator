<script>
  const $ = id => document.getElementById(id);
  
  // URL Params and Currency Logic
  const params = new URLSearchParams(window.location.search);
  let currentCurrency = 'CNY'; // default
  
  const validCurrencies = ['CNY', 'USD'];
  const urlCurr = params.get('currency');
  if (urlCurr && validCurrencies.includes(urlCurr)) {
    currentCurrency = urlCurr;
  } else {
    try {
      const saved = localStorage.getItem('preferredCurrency');
      if (saved && validCurrencies.includes(saved)) {
        currentCurrency = saved;
      }
    } catch(e) {}
  }
  
  const updateUnits = () => {
    const sel = $('programPreset');
    if (currentCurrency === 'USD') {
      if($('hintCashRatio')) $('hintCashRatio').textContent = '积分 : 美元';
      if($('hintPreset')) $('hintPreset').textContent = '美分 / 英里';
      if (sel) {
        sel.options[0].text = 'Custom scenario (手动输入)';
        sel.options[1].text = 'Conservative scenario · ~1.2¢/mile';
        sel.options[1].value = '1.2';
        sel.options[2].text = 'Typical airline-mile scenario · ~1.5¢/mile';
        sel.options[2].value = '1.5';
        sel.options[3].text = 'Flexible points scenario · ~2.0¢/mile';
        sel.options[3].value = '2.0';
        sel.options[4].text = 'Premium cabin sweet spot · ~3.5¢/mile';
        sel.options[4].value = '3.5';
      }
    } else {
      if($('hintCashRatio')) $('hintCashRatio').textContent = '积分 : 元';
      if($('hintPreset')) $('hintPreset').textContent = '元 / 英里';
      if (sel) {
        sel.options[0].text = '自定义估值情景';
        sel.options[1].text = '保守估值情景 · 1.2美分/英里 (约0.084元)';
        sel.options[1].value = '0.084';
        sel.options[2].text = '中性航空里程情景 · 1.5美分/英里 (约0.105元)';
        sel.options[2].value = '0.105';
        sel.options[3].text = '灵活积分/良好兑换情景 · 2.0美分/英里 (约0.140元)';
        sel.options[3].value = '0.140';
        sel.options[4].text = '高价值/两舱兑换情景 · 3.5美分/英里 (约0.245元)';
        sel.options[4].value = '0.245';
      }
    }
  };

  if ($('currency')) {
    $('currency').value = currentCurrency;
    $('currency').addEventListener('change', (e) => {
      const oldCurrency = currentCurrency;
      currentCurrency = e.target.value;
      if (oldCurrency !== currentCurrency) {
        $('cashRatio').value = '';
        $('mileValue').value = '';
        
        $('programPreset').value = 'custom';
        const warningMsg = currentCurrency === 'USD' 
          ? '货币已切换。为避免人民币和美元金额混淆，请重新填写估值和抵扣比例。' 
          : '货币已切换。为避免人民币和美元金额混淆，请重新填写估值和抵扣比例。';
          
        function clearCalculatorResults() {
          $('cashOut').textContent = '-';
          $('milesOut').textContent = '-';
          $('verdictText').textContent = '—';
          $('verdictCode').textContent = '-';
          $('verdictText').className = 'verdict';
          $('cashOut').classList.remove('win');
          $('milesOut').classList.remove('win');
          $('explain').innerHTML = `<span style="color:#eab308; font-weight:bold;">${warningMsg}</span>`;
        }
        clearCalculatorResults();
      }
      try { localStorage.setItem('preferredCurrency', currentCurrency); } catch(err) {}
      updateUnits();
      if ($('mileValue').value) {
        calc();
      }
    });
  }

  // Pre-fill parameters safely
  const parseParam = (key, elId, maxVal = 1000000000) => {
    let val = parseFloat(params.get(key));
    if (!isNaN(val) && isFinite(val) && val >= 0 && val <= maxVal) {
      if (key === 'points' && val === 0) return; // points must be > 0
      const el = $(elId);
      if (el) el.value = val;
    }
  };
  parseParam('points', 'points');
  parseParam('cashRatio', 'cashRatio');
  parseParam('milesRatio', 'milesRatio');
  parseParam('valuation', 'mileValue', 1000);

  const fmt = n => {
    if (currentCurrency === 'USD') {
      return '$' + n.toLocaleString('en-US', {maximumFractionDigits: 2});
    } else {
      return '¥' + n.toLocaleString('zh-CN', {maximumFractionDigits: 0});
    }
  };

  function calc(){
    let points = parseFloat($('points').value) || 0;
    let cashRatio = parseFloat($('cashRatio').value) || 0;
    let milesRatio = parseFloat($('milesRatio').value) || 0;
    let mileValue = parseFloat($('mileValue').value) || 0;

    const resetState = (msg = '请输入有效的数值。') => {
      $('cashOut').textContent = '-';
      $('milesOut').textContent = '-';
      $('verdictText').textContent = '—';
      $('verdictCode').textContent = 'RATIO —';
      $('explain').textContent = msg;
      
      $('verdictText').className = 'verdict';
      $('cashOut').classList.remove('win');
      $('milesOut').classList.remove('win');
    };

    if (points <= 0 || cashRatio <= 0 || milesRatio <= 0 || mileValue <= 0) {
      resetState(points <= 0 ? '请输入有效的积分数量。' : '兑换比例和估值必须大于零。');
      return;
    }

    const cashValue = points / cashRatio;
    const miles = points / milesRatio;
    
    // Internal calculations use the values directly.
    // If USD is chosen, we assume mileValue was entered as Cents, so we convert to Dollars for the total.
    // Wait, the preset options are in CNY (0.15, 0.35, 0.6, 1.2, 2.0). 
    // If user selects USD, they should enter Cents (e.g., 4.0), so we need to divide by 100 for dollar value.
    let milesValue = 0;
    if (currentCurrency === 'USD') {
      milesValue = miles * (mileValue / 100);
    } else {
      milesValue = miles * mileValue;
    }

    $('cashOut').textContent = fmt(cashValue);
    $('milesOut').textContent = fmt(milesValue);

    $('cashOut').classList.remove('win');
    $('milesOut').classList.remove('win');

    const ratio = cashValue > 0 ? (milesValue / cashValue) : 0;
    const verdict = $('verdictText');
    const code = $('verdictCode');
    const explain = $('explain');
    
    verdict.className = 'verdict';

    if(milesValue > cashValue * 1.05){
      verdict.textContent = '转里程更划算';
      verdict.className = 'verdict good';
      $('milesOut').classList.add('win');
      explain.textContent = `转成${miles.toLocaleString('zh-CN',{maximumFractionDigits:0})}英里后估值约为直接抵现的 ${ratio.toFixed(2)} 倍,前提是你能订到接近参考价值区间的舱位。`;
    } else if(cashValue > milesValue * 1.05){
      verdict.textContent = '不如直接抵现';
      verdict.className = 'verdict bad';
      $('cashOut').classList.add('win');
      explain.textContent = `按你输入的兑换条款,转里程的估值只有直接抵现的 ${(ratio*100).toFixed(0)}%,除非能订到更高舱位或稀缺航线,否则直接抵现更稳妥。`;
    } else {
      verdict.textContent = '大致持平';
      explain.textContent = '两种方式价值接近,可以根据你是否真的会用这些里程出行来决定。';
    }
    code.textContent = `RATIO ${ratio.toFixed(2)}×`;
  }

  $('programPreset').addEventListener('change', e => {
    if(e.target.value !== 'custom'){
      $('mileValue').value = e.target.value;
      calc();
    }
  });
  ['points','cashRatio','milesRatio','mileValue'].forEach(id => {
    if($(id)) $(id).addEventListener('input', calc);
  });
  
  updateUnits();
  if($('mileValue').value) calc();
</script>
